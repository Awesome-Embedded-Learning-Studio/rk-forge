# kernel.config — defconfig FRAGMENT for rk3506-evb.
# Merged onto a base defconfig via the kernel's scripts/merge_config.sh (Week 5-6).
# Not a full defconfig. Placeholder — fill from the real board's needs.

CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARCH_MULTI_V7=y
# RK3506 SoC
CONFIG_CLK_RK3506=y           # mainline since 6.19 (drivers/clk/rockchip/clk-rk3506.c)
CONFIG_PINCTRL_RK3506=y       # mainline since 6.19
# console / earlycon
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y       # Rockchip DW UART
CONFIG_EARLY_PRINTK=y
