# Build-target submodules. Declared here; NOT yet initialized (clone happens in
# Week 3+ when we build). `ignore = dirty` keeps build artifacts under each tree
# from polluting the superproject status.
[submodule "third_party/linux_mainline"]
	path = third_party/linux_mainline
	url = https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git
	ignore = dirty
[submodule "third_party/uboot"]
	path = third_party/uboot
	url = https://gitlab.denx.de/u-boot/u-boot.git
	ignore = dirty
[submodule "third_party/rkbin"]
	path = third_party/rkbin
	url = https://github.com/rockchip-linux/rkbin.git
	ignore = dirty

# NOTE: third_party/vendor-sdk/ is intentionally NOT a submodule. It's a local
# clone of a vendor SDK (e.g. 正点原子/ALIENTEK) used ONLY as a reference for
# sdk-diff and board-DT extraction. See third_party/README.md.
