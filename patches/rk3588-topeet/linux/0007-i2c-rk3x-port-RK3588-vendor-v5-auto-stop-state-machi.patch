 	int ret = 0;
 	int i;
@@ -1099,6 +1196,9 @@ static int rk3x_i2c_xfer_common(struct i2c_adapter *adap,
 	 * rk3x_i2c_setup()).
 	 */
 	for (i = 0; i < num; i += ret) {
+		unsigned long xfer_time = WAIT_TIMEOUT;
+		int len;
+
 		ret = rk3x_i2c_setup(i2c, msgs + i, num - i);
 
 		if (ret < 0) {
@@ -1109,20 +1209,23 @@ static int rk3x_i2c_xfer_common(struct i2c_adapter *adap,
 		if (i + ret >= num)
 			i2c->is_last_msg = true;
 
