+static GT911State *gt911_find(Monitor *mon)
+{
+    GT911State *s = rk3588_lite_gt911();
+
+    if (!s) {
+        monitor_printf(mon, "gt911: no gt911 device on this machine\n");
+    }
+    return s;
+}
+
+void hmp_gt911_mouse(Monitor *mon, const QDict *qdict)
+{
+    GT911State *s = rk3588_lite_gt911();
+
+    if (s) {
+        s->mouse_bridge = qdict_get_bool(qdict, "on");
+        monitor_printf(mon, "gt911 host-mouse bridge: %s\n",
+                       s->mouse_bridge ? "on" : "off");
+    }
+}
+
+void hmp_gt911_touch(Monitor *mon, const QDict *qdict)
+{
+    int x = qdict_get_int(qdict, "x");
+    int y = qdict_get_int(qdict, "y");
+    GT911State *s = gt911_find(mon);
+
+    if (s) {
+        gt911_touch(s, x, y);
+        monitor_printf(mon, "gt911_touch: (%d, %d) INT asserted\n", x, y);
+    }
+}
+
+void hmp_gt911_release(Monitor *mon, const QDict *qdict)
+{
+    GT911State *s = gt911_find(mon);
+
+    if (s) {
+        gt911_release(s);
+        monitor_printf(mon, "gt911_release: INT asserted\n");
+    }
+}
+
 void hmp_stop(Monitor *mon, const QDict *qdict)
 {
     qmp_stop(NULL);
