+/*
+ * samsung-mipi-dcphy behavioral shadow (feda0000.phy, mipidcphy0): the DSI
+ * path's phy_poweron() polls PLL_STAT0 (0x140) for PLL_LOCK with a 20 ms
+ * deadline (phy-rockchip-samsung-dcphy.c) — the only read-poll in its
+ * power-on path.  Report the PLL as always locked; everything else stores.
+ */
+static uint64_t rk3588_lite_dcphy_read(void *opaque, hwaddr offset,
+                                       unsigned size)
+{
+    Rk3588LiteState *s = opaque;
+    uint32_t v = s->dcphy_regs[offset >> 2];
+
+    if (offset == 0x140) {      /* PLL_STAT0: PLL_LOCK = BIT(0) */
+        v |= BIT(0);
+    }
+    return v;
+}
+
+static void rk3588_lite_dcphy_write(void *opaque, hwaddr offset,
+                                    uint64_t value, unsigned size)
+{
+    Rk3588LiteState *s = opaque;
+
+    s->dcphy_regs[offset >> 2] = value;
+}
+
+static const MemoryRegionOps rk3588_lite_dcphy_ops = {
+    .read = rk3588_lite_dcphy_read,
+    .write = rk3588_lite_dcphy_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 8,
+};
+
+/*
+ * vop_mmu behavioral shadow (fdd97e00, two 0x100 windows: e00 + f00, regs
+ * per rockchip-iommu.c): rk_iommu_force_reset() at probe writes DTE_ADDR
+ * and READS IT BACK — an all-zeros unimp read made it return -EFAULT, whose
+ * sticky runtime_error then poisoned vop2_enable's pm_runtime_resume with
+ * -EINVAL at every first modeset (SIM-DIAG established the chain).  Model:
+ * plain RW mirror + COMMAND side effects (paging/stall status bits) + reset
+ * clearing DTE (is_reset_done = DTE_ADDR == 0).
+ *   0x00 DTE_ADDR / 0x04 STATUS / 0x08 COMMAND (0 en-page,1 dis-page,
+ *   2 en-stall,3 dis-stall,4 zap,5 fault-done,6 force-reset)
+ */
+static uint64_t rk3588_lite_mmu_read(void *opaque, hwaddr offset, unsigned size)
+{
+    Rk3588LiteState *s = opaque;
+    uint32_t v = s->mmu_regs[offset >> 2];
+
+    if ((offset & 0xFF) == 0x04) {      /* STATUS: always idle + replay drained */
+        v |= BIT(3);
+        v |= BIT(4);
+        if (!(v & BIT(2))) {
+            v |= BIT(31);               /* STALL_NOT_ACTIVE */
+        }
+    }
+    return v;
+}
+
+static void rk3588_lite_mmu_write(void *opaque, hwaddr offset, uint64_t value,
+                                  unsigned size)
+{
+    Rk3588LiteState *s = opaque;
+    uint32_t *st = &s->mmu_regs[(offset & ~0xFFu) / 4 + 1];
+
+    if ((offset & 0xFF) == 0x08) {      /* COMMAND */
+        switch (value & 0xF) {
+        case 0: *st |= BIT(0);  break;          /* ENABLE_PAGING */
+        case 1: *st &= ~BIT(0); break;          /* DISABLE_PAGING */
+        case 2: *st |= BIT(2); *st &= ~BIT(31); break;  /* ENABLE_STALL */
+        case 3: *st &= ~BIT(2); *st |= BIT(31); break;  /* DISABLE_STALL */
+        case 6:                                  /* FORCE_RESET: DTE→0, paging off */
+            s->mmu_regs[(offset & ~0xFFu) / 4] = 0;
+            *st = BIT(31);
+            return;
+        default: break;                         /* ZAP_CACHE / PAGE_FAULT_DONE */
+        }
+        return;
+    }
+    s->mmu_regs[offset >> 2] = value;           /* DTE_ADDR readback + others */
+}
+
+static const MemoryRegionOps rk3588_lite_mmu_ops = {
+    .read = rk3588_lite_mmu_read,
+    .write = rk3588_lite_mmu_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 8,
+};
