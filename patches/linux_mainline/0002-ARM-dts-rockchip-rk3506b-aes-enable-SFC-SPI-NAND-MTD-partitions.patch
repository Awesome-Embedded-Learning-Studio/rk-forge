From 9f483af6feaa465f7bc2d872d20ef88580b1b3c8 Mon Sep 17 00:00:00 2001
From: CharlieChen114514 <725610365@qq.com>
Date: Mon, 15 Jun 2026 18:02:26 +0800
Subject: [PATCH] ARM: dts: rockchip: rk3506b-aes: enable SFC + W25N04KV
 SPI-NAND + MTD partitions

Add the SPI flash controller (rockchip,sfc @ 0xff488000) to the RK3506 SoC
dtsi and enable it on the AES RK3506B board with its Winbond W25N04KV (4 Gb)
SPI-NAND. The flash is partitioned with fixed-partitions mirroring the board's
NAND parameter (uboot/misc/vnvm/recovery/boot/rootfs/userdata) so Linux can see
the NAND as MTD and attach UBI for a persistent rootfs.

The SFC node uses the mainline rockchip,sfc binding (same node proven on the
U-Boot side); rockchip,sfc-no-dma forces PIO (DMA reads corrupt on this board)
and spi-max-frequency is capped at 50 MHz (mainline rockchip_sfc.c has no
sampling delay-line tuning). The W25N04KV (id 0xaa,0x23) is already in
mainline drivers/mtd/nand/spi/winbond.c.

Signed-off-by: CharlieChen114514 <725610365@qq.com>
---
 arch/arm/boot/dts/rockchip/rk3506.dtsi     | 28 ++++++++---
 arch/arm/boot/dts/rockchip/rk3506b-aes.dts | 54 ++++++++++++++++++++++
 2 files changed, 76 insertions(+), 6 deletions(-)

diff --git a/arch/arm/boot/dts/rockchip/rk3506.dtsi b/arch/arm/boot/dts/rockchip/rk3506.dtsi
index 64a1bd026..1eb7a9be1 100644
--- a/arch/arm/boot/dts/rockchip/rk3506.dtsi
+++ b/arch/arm/boot/dts/rockchip/rk3506.dtsi
@@ -2,12 +2,16 @@
 /*
  * (C) Copyright 2023 Rockchip Electronics Co., Ltd.
  *
- * Minimal RK3506 SoC dtsi for mainline Linux bring-up (earlycon/console milestone).
- * Ported/reduced from the ATK vendor SDK rk3502.dtsi. Only the nodes needed to
- * reach the early UART console are included: clocks, cru, grf, ioc syscons,
- * gic, arch timer, psci, cpus, pinctrl (all 5 gpio banks) + uart0.
- * All other peripherals (i2c/spi/pwm/sai/mmc/usb/display/...) deferred —
- * they are not required for earlycon. Add them in later iterations.
+ * Minimal RK3506 SoC dtsi for mainline Linux bring-up.
+ * Ported/reduced from the ATK vendor SDK rk3502.dtsi. Nodes needed to boot +
+ * reach the early UART console: clocks, cru, grf, ioc syscons, gic, arch timer,
+ * psci, cpus, pinctrl (all 5 gpio banks) + uart0.
+ * + sfc (SPI flash controller) — drives the W25N04KV SPI-NAND, needed for a
+ *   persistent rootfs on NAND. Uses the mainline `rockchip,sfc` binding (the
+ *   same node proven on the U-Boot side); vendor BSP instead uses a private
+ *   `fspi` driver — we stay mainline (no DLL tuning → capped at 50MHz). See
+ *   notes/10 + BLOBS.md.
+ * Other peripherals (i2c/spi/pwm/sai/mmc/usb/display/io-domains) still deferred.
  */
 
 #include <dt-bindings/clock/rockchip,rk3506-cru.h>
@@ -117,6 +121,18 @@ uart0: serial@ff0a0000 {
 		status = "disabled";
 	};
 
+	sfc: spi@ff488000 {
+		compatible = "rockchip,sfc";
+		reg = <0xff488000 0x4000>;
+		interrupts = <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru SCLK_FSPI>, <&cru HCLK_FSPI>;
+		clock-names = "clk_sfc", "hclk_sfc";
+		rockchip,sfc-no-dma;	/* DMA reads corrupt on this board; force PIO (notes/10) */
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "disabled";
+	};
+
 	grf: syscon@ff288000 {
 		compatible = "rockchip,rk3506-grf", "syscon", "simple-mfd";
 		reg = <0xff288000 0x4000>;
diff --git a/arch/arm/boot/dts/rockchip/rk3506b-aes.dts b/arch/arm/boot/dts/rockchip/rk3506b-aes.dts
index 0d45ae455..c493c4708 100644
--- a/arch/arm/boot/dts/rockchip/rk3506b-aes.dts
+++ b/arch/arm/boot/dts/rockchip/rk3506b-aes.dts
@@ -26,3 +26,57 @@ memory@0 {
 &uart0 {
 	status = "okay";
 };
+
+/*
+ * SPI-NAND (Winbond W25N04KV, 4Gb) on the SFC. Lets Linux see the NAND as MTD
+ * + attach UBI for persistent rootfs (see notes/10). Partition layout mirrors
+ * third_party/bringup/parameter-nand-aes.txt (512B-sector units → bytes, 128KB
+ * erase-block aligned); the 0x0–0x400000 (0–4MB) loader/idblock area is left
+ * unpartitioned. 50MHz cap: mainline rockchip_sfc.c has no DLL tuning (notes/10).
+ */
+&sfc {
+	status = "okay";
+
+	flash@0 {
+		compatible = "spi-nand";	/* W25N04KV; mainline winbond.c id (0xaa,0x23) */
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <1>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@400000 {
+				label = "uboot";
+				reg = <0x400000 0x400000>;
+			};
+			partition@800000 {
+				label = "misc";
+				reg = <0x800000 0x100000>;
+			};
+			partition@900000 {
+				label = "vnvm";
+				reg = <0x900000 0x40000>;
+			};
+			partition@940000 {
+				label = "recovery";
+				reg = <0x940000 0xe00000>;
+			};
+			partition@1740000 {
+				label = "boot";
+				reg = <0x1740000 0x1000000>;
+			};
+			partition@2740000 {
+				label = "rootfs";
+				reg = <0x2740000 0xae00000>;
+			};
+			partition@d540000 {
+				label = "userdata";
+				reg = <0xd540000 0x12ac0000>;
+			};
+		};
+	};
+};
-- 
