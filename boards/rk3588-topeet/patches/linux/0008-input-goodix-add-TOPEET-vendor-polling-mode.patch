From 061fe97f84473857ca01e897a36dec46e187f6a1 Mon Sep 17 00:00:00 2001
From: Charliechen114514 <725610365@qq.com>
Date: Sun, 2 Aug 2026 09:12:59 +0800
Subject: [PATCH 8/8] input: goodix: add TOPEET vendor polling mode

Keep the GT911 INT GPIO for reset-time address selection, but bypass the dead board interrupt and read touch reports through the vendor 1-second startup / 16-ms hrtimer cadence on a dedicated ordered goodix_wq. Stop and restart polling across remove and system sleep, and describe the opt-in DT property.
---
 .../bindings/input/touchscreen/goodix.yaml    |   8 ++
 .../arm64/boot/dts/rockchip/rk3588-topeet.dts |   1 +
 drivers/input/touchscreen/goodix.c            | 121 +++++++++++++++++-
 drivers/input/touchscreen/goodix.h            |   7 +
 4 files changed, 132 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/input/touchscreen/goodix.yaml b/Documentation/devicetree/bindings/input/touchscreen/goodix.yaml
index a26a54d63..6409a14c8 100644
--- a/Documentation/devicetree/bindings/input/touchscreen/goodix.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/goodix.yaml
@@ -42,6 +42,14 @@ properties:
       address, thus it can be driven by the host during the reset sequence.
     maxItems: 1
 
+  goodix,polling-mode:
+    type: boolean
+    description:
+      Use the Goodix vendor hrtimer and dedicated single-thread workqueue
+      polling path instead of requesting the interrupt. This is intended for
+      boards whose GT9xx INT trace is used for address selection but does not
+      deliver touch interrupts to the host.
+
   panel: true
 
   reset-gpios:
diff --git a/arch/arm64/boot/dts/rockchip/rk3588-topeet.dts b/arch/arm64/boot/dts/rockchip/rk3588-topeet.dts
index 5f666eab1..6753f3f2a 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-topeet.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-topeet.dts
@@ -788,6 +788,7 @@ touchscreen@14 {
 		VDDIO-supply = <&vcc3v3_lcd_n>;
 		interrupt-parent = <&gpio3>;
 		interrupts = <RK_PC0 IRQ_TYPE_LEVEL_LOW>;
+		goodix,polling-mode;
 		/* Mainline Goodix uses logical GPIO values as the raw address strap. */
 		irq-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
 		panel = <&lcd_panel>;
diff --git a/drivers/input/touchscreen/goodix.c b/drivers/input/touchscreen/goodix.c
index 2405deb42..c89fb0ca6 100644
--- a/drivers/input/touchscreen/goodix.c
+++ b/drivers/input/touchscreen/goodix.c
@@ -49,6 +49,8 @@
 #define TRIGGER_LOC			6
 
 #define GOODIX_POLL_INTERVAL_MS		17	/* 17ms = 60fps */
+#define GOODIX_VENDOR_POLL_INTERVAL_MS	16
+#define GOODIX_VENDOR_POLL_START_MS	1000
 
 /* Our special handling for GPIO accesses through ACPI is x86 specific */
 #if defined CONFIG_X86 && defined CONFIG_ACPI
@@ -507,6 +509,89 @@ static void goodix_ts_work_i2c_poll(struct input_dev *input)
 	goodix_i2c_write_u8(ts->client, GOODIX_READ_COOR_ADDR, 0);
 }
 
+static void goodix_ts_vendor_poll_work(struct work_struct *work)
+{
+	struct goodix_ts_data *ts =
+		container_of(work, struct goodix_ts_data, vendor_poll_work);
+
+	if (!READ_ONCE(ts->vendor_polling_active))
+		return;
+
+	goodix_process_events(ts);
+	goodix_i2c_write_u8(ts->client, GOODIX_READ_COOR_ADDR, 0);
+}
+
+static enum hrtimer_restart goodix_ts_vendor_poll_timer(struct hrtimer *timer)
+{
+	struct goodix_ts_data *ts =
+		container_of(timer, struct goodix_ts_data, vendor_poll_timer);
+
+	if (!READ_ONCE(ts->vendor_polling_active))
+		return HRTIMER_NORESTART;
+
+	queue_work(ts->vendor_poll_wq, &ts->vendor_poll_work);
+	hrtimer_forward_now(timer,
+			    ms_to_ktime(GOODIX_VENDOR_POLL_INTERVAL_MS));
+
+	return HRTIMER_RESTART;
+}
+
+static void goodix_vendor_poll_stop(struct goodix_ts_data *ts)
+{
+	if (!ts->vendor_poll_wq)
+		return;
+
+	WRITE_ONCE(ts->vendor_polling_active, false);
+	hrtimer_cancel(&ts->vendor_poll_timer);
+	cancel_work_sync(&ts->vendor_poll_work);
+}
+
+static void goodix_vendor_poll_start(struct goodix_ts_data *ts)
+{
+	if (!ts->vendor_poll_wq || READ_ONCE(ts->vendor_polling_active))
+		return;
+
+	WRITE_ONCE(ts->vendor_polling_active, true);
+	hrtimer_start(&ts->vendor_poll_timer,
+		      ms_to_ktime(GOODIX_VENDOR_POLL_START_MS),
+		      HRTIMER_MODE_REL);
+}
+
+static void goodix_vendor_poll_cleanup(void *data)
+{
+	struct goodix_ts_data *ts = data;
+
+	goodix_vendor_poll_stop(ts);
+	destroy_workqueue(ts->vendor_poll_wq);
+	ts->vendor_poll_wq = NULL;
+}
+
+static int goodix_vendor_poll_init(struct goodix_ts_data *ts)
+{
+	int error;
+
+	ts->vendor_poll_wq = alloc_ordered_workqueue("goodix_wq",
+						     WQ_MEM_RECLAIM);
+	if (!ts->vendor_poll_wq)
+		return -ENOMEM;
+
+	INIT_WORK(&ts->vendor_poll_work, goodix_ts_vendor_poll_work);
+	hrtimer_setup(&ts->vendor_poll_timer, goodix_ts_vendor_poll_timer,
+		      CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+
+	error = devm_add_action_or_reset(&ts->client->dev,
+					 goodix_vendor_poll_cleanup, ts);
+	if (error)
+		return error;
+
+	dev_info(&ts->client->dev,
+		 "using TOPEET vendor polling (dedicated goodix_wq, %d ms)\n",
+		 GOODIX_VENDOR_POLL_INTERVAL_MS);
+	goodix_vendor_poll_start(ts);
+
+	return 0;
+}
+
 /**
  * goodix_ts_irq_handler - The IRQ handler
  *
@@ -525,25 +610,25 @@ static irqreturn_t goodix_ts_irq_handler(int irq, void *dev_id)
 
 static void goodix_enable_irq(struct goodix_ts_data *ts)
 {
-	if (ts->client->irq)
+	if (ts->client->irq && !ts->vendor_polling)
 		enable_irq(ts->client->irq);
 }
 
 static void goodix_disable_irq(struct goodix_ts_data *ts)
 {
-	if (ts->client->irq)
+	if (ts->client->irq && !ts->vendor_polling)
 		disable_irq(ts->client->irq);
 }
 
 static void goodix_free_irq(struct goodix_ts_data *ts)
 {
-	if (ts->client->irq)
+	if (ts->client->irq && !ts->vendor_polling)
 		devm_free_irq(&ts->client->dev, ts->client->irq, ts);
 }
 
 static int goodix_request_irq(struct goodix_ts_data *ts)
 {
-	if (!ts->client->irq)
+	if (!ts->client->irq || ts->vendor_polling)
 		return 0;
 
 	return devm_request_threaded_irq(&ts->client->dev, ts->client->irq,
@@ -1233,7 +1318,7 @@ static int goodix_configure_dev(struct goodix_ts_data *ts)
 
 	input_set_drvdata(ts->input_dev, ts);
 
-	if (!ts->client->irq) {
+	if (!ts->client->irq && !ts->vendor_polling) {
 		error = input_setup_polling(ts->input_dev, goodix_ts_work_i2c_poll);
 		if (error) {
 			dev_err(&ts->client->dev,
@@ -1268,6 +1353,15 @@ static int goodix_configure_dev(struct goodix_ts_data *ts)
 		return error;
 	}
 
+	if (ts->vendor_polling) {
+		error = goodix_vendor_poll_init(ts);
+		if (error) {
+			dev_err(&ts->client->dev,
+				"could not start vendor polling: %d\n", error);
+			return error;
+		}
+	}
+
 	return 0;
 }
 
@@ -1337,6 +1431,8 @@ static int goodix_ts_probe(struct i2c_client *client)
 	i2c_set_clientdata(client, ts);
 	init_completion(&ts->firmware_loading_complete);
 	ts->contact_size = GOODIX_CONTACT_SIZE;
+	ts->vendor_polling = device_property_read_bool(&client->dev,
+						       "goodix,polling-mode");
 
 	error = goodix_get_gpio_config(ts);
 	if (error)
@@ -1441,6 +1537,9 @@ static void goodix_ts_remove(struct i2c_client *client)
 
 	if (ts->load_cfg_from_disk)
 		wait_for_completion(&ts->firmware_loading_complete);
+
+	if (ts->vendor_polling)
+		goodix_vendor_poll_stop(ts);
 }
 
 static int goodix_suspend(struct device *dev)
@@ -1452,6 +1551,9 @@ static int goodix_suspend(struct device *dev)
 	if (ts->load_cfg_from_disk)
 		wait_for_completion(&ts->firmware_loading_complete);
 
+	if (ts->vendor_polling)
+		goodix_vendor_poll_stop(ts);
+
 	/* We need gpio pins to suspend/resume */
 	if (ts->irq_pin_access_method == IRQ_PIN_ACCESS_NONE) {
 		goodix_disable_irq(ts);
@@ -1468,6 +1570,8 @@ static int goodix_suspend(struct device *dev)
 	error = goodix_irq_direction_output(ts, 0);
 	if (error) {
 		goodix_request_irq(ts);
+		if (ts->vendor_polling)
+			goodix_vendor_poll_start(ts);
 		return error;
 	}
 
@@ -1478,6 +1582,8 @@ static int goodix_suspend(struct device *dev)
 	if (error) {
 		goodix_irq_direction_input(ts);
 		goodix_request_irq(ts);
+		if (ts->vendor_polling)
+			goodix_vendor_poll_start(ts);
 		return -EAGAIN;
 	}
 
@@ -1499,6 +1605,8 @@ static int goodix_resume(struct device *dev)
 
 	if (ts->irq_pin_access_method == IRQ_PIN_ACCESS_NONE) {
 		goodix_enable_irq(ts);
+		if (ts->vendor_polling)
+			goodix_vendor_poll_start(ts);
 		return 0;
 	}
 
@@ -1536,6 +1644,9 @@ static int goodix_resume(struct device *dev)
 	if (error)
 		return error;
 
+	if (ts->vendor_polling)
+		goodix_vendor_poll_start(ts);
+
 	return 0;
 }
 
diff --git a/drivers/input/touchscreen/goodix.h b/drivers/input/touchscreen/goodix.h
index 0d1e8a8d2..46cadc165 100644
--- a/drivers/input/touchscreen/goodix.h
+++ b/drivers/input/touchscreen/goodix.h
@@ -3,11 +3,13 @@
 #define __GOODIX_H__
 
 #include <linux/gpio/consumer.h>
+#include <linux/hrtimer.h>
 #include <linux/i2c.h>
 #include <linux/input.h>
 #include <linux/input/mt.h>
 #include <linux/input/touchscreen.h>
 #include <linux/regulator/consumer.h>
+#include <linux/workqueue.h>
 
 /* Register defines */
 #define GOODIX_REG_MISCTL_DSP_CTL		0x4010
@@ -93,6 +95,8 @@ struct goodix_ts_data {
 	u16 version;
 	bool reset_controller_at_probe;
 	bool load_cfg_from_disk;
+	bool vendor_polling;
+	bool vendor_polling_active;
 	int pen_input_registered;
 	struct completion firmware_loading_complete;
 	unsigned long irq_flags;
@@ -103,6 +107,9 @@ struct goodix_ts_data {
 	u8 main_clk[GOODIX_MAIN_CLK_LEN];
 	int bak_ref_len;
 	u8 *bak_ref;
+	struct hrtimer vendor_poll_timer;
+	struct work_struct vendor_poll_work;
+	struct workqueue_struct *vendor_poll_wq;
 };
 
 int goodix_i2c_read(struct i2c_client *client, u16 reg, u8 *buf, int len);
-- 
2.43.0

