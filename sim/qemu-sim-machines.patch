+
+static void rk3588_lite_init(MachineState *machine)
+{
+    Rk3588LiteState *s = RK3588_LITE_MACHINE(machine);
+    MemoryRegion *sysmem = get_system_memory();
+    DeviceState *gicdev;
+    int i;
+
+    if (machine->smp.cpus > RK3588_LITE_NUM_CPUS) {
+        error_report("rk3588-lite: at most %d CPUs", RK3588_LITE_NUM_CPUS);
+        exit(1);
+    }
+
+    /* Heterogeneous topology per rk3588-base.dtsi: A55 cluster at mpidr
+     * 0x000-0x300, A76 cores at 0x400-0x700 (mp_affinity Aff1 = index). */
+    for (i = 0; i < machine->smp.cpus; i++) {
+        const char *type = i < 4 ? ARM_CPU_TYPE_NAME("cortex-a55")
+                                 : ARM_CPU_TYPE_NAME("cortex-a76");
+        Object *cpu = object_new(type);
+
+        if (machine->smp.cpus > 1 &&
+                object_property_find(cpu, "reset-cbar")) {
+            object_property_set_int(cpu, "reset-cbar", RK3588_LITE_GICD,
+                                    &error_abort);
+        }
+        object_property_set_int(cpu, "cntfrq", 24000000, &error_abort);
+        ARM_CPU(cpu)->mp_affinity = (uint64_t)i << 8;
+        object_property_set_bool(cpu, "has_el2", !kvm_enabled(), &error_abort);
+        /* no EL3 (see rk3568-lite.c): firmware/kernel enter at EL2 and the
+         * SMC PSCI conduit survives QEMU's boot-EL rule */
+        object_property_set_bool(cpu, "has_el3", false, &error_abort);
+        if (i) {
+            object_property_set_bool(cpu, "start-powered-off", true,
+                                     &error_abort);
+        }
+        qdev_realize(DEVICE(cpu), NULL, &error_fatal);
+        s->cpu[i] = ARM_CPU(cpu);
+    }
+
+    gicdev = qdev_new(gicv3_class_name());
+    qdev_prop_set_uint32(gicdev, "num-cpu", machine->smp.cpus);
+    qdev_prop_set_uint32(gicdev, "num-irq",
+                         RK3588_LITE_NUM_SPIS + GIC_INTERNAL);
+    {
+        QList *redist_region_count = qlist_new();
+        qlist_append_int(redist_region_count, machine->smp.cpus);
+        qdev_prop_set_array(gicdev, "redist-region-count", redist_region_count);
+    }
+    object_property_set_link(OBJECT(gicdev), "sysmem", OBJECT(sysmem),
+                             &error_fatal);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(gicdev), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(gicdev), 0, RK3588_LITE_GICD);
+    sysbus_mmio_map(SYS_BUS_DEVICE(gicdev), 1, RK3588_LITE_GICR);
+
+    for (i = 0; i < machine->smp.cpus; i++) {
+        DeviceState *cpudev = DEVICE(s->cpu[i]);
+        int intidbase = RK3588_LITE_NUM_SPIS + i * GIC_INTERNAL;
+        qemu_irq irq;
+        static const int timer_irqs[] = {
+            [GTIMER_PHYS] = ARCH_TIMER_NS_EL1_IRQ,
+            [GTIMER_VIRT] = ARCH_TIMER_VIRT_IRQ,
+            [GTIMER_HYP]  = ARCH_TIMER_NS_EL2_IRQ,
+            [GTIMER_SEC]  = ARCH_TIMER_S_EL1_IRQ,
+        };
+
+        for (int j = 0; j < ARRAY_SIZE(timer_irqs); j++) {
+            irq = qdev_get_gpio_in(gicdev, intidbase + timer_irqs[j]);
+            qdev_connect_gpio_out(cpudev, j, irq);
+        }
+        irq = qdev_get_gpio_in(gicdev, intidbase + ARCH_GIC_MAINT_IRQ);
+        qdev_connect_gpio_out_named(cpudev, "gicv3-maintenance-interrupt",
+                                    0, irq);
+        irq = qdev_get_gpio_in(gicdev, intidbase + VIRTUAL_PMU_IRQ);
+        qdev_connect_gpio_out_named(cpudev, "pmu-interrupt", 0, irq);
+
+        sysbus_connect_irq(SYS_BUS_DEVICE(gicdev), i,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_IRQ));
+        sysbus_connect_irq(SYS_BUS_DEVICE(gicdev), i + machine->smp.cpus,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_FIQ));
+        sysbus_connect_irq(SYS_BUS_DEVICE(gicdev), i + 2 * machine->smp.cpus,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_VIRQ));
+        sysbus_connect_irq(SYS_BUS_DEVICE(gicdev), i + 3 * machine->smp.cpus,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_VFIQ));
+    }
+
+    /* DW ext space first; serial_mm added later wins the standard window */
+    memory_region_init_io(&s->uart2_ext, OBJECT(machine),
+                          &rk3588_lite_uart2_ext_ops, NULL,
+                          "rk3588-lite.uart2-ext", 0x100);
+    memory_region_add_subregion(sysmem, RK3588_LITE_UART2, &s->uart2_ext);
+
+    /* gicv3 gpio-in n == SPI n: pass the SPI index, not the INTID */
+    serial_mm_init(sysmem, RK3588_LITE_UART2, 2, /* regshift=2 per DT */
+                   qdev_get_gpio_in(gicdev, RK3588_LITE_UART2_SPI),
+                   24000000 / 16, serial_hd(0), DEVICE_LITTLE_ENDIAN);
+
+    /* Sim-only transports, enumerated by the guest command line (never FDT). */
+    for (i = 0; i < 6; i++) {
+        DeviceState *dev = qdev_new("virtio-mmio");
+
+        /* virtio-gpu is a modern-only device; keep every slot consistent. */
+        qdev_prop_set_bit(dev, "force-legacy", false);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0,
+                       RK3588_LITE_VIRTIO + i * 0x200);
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                           qdev_get_gpio_in(gicdev, 160 + i)); /* SPI 160+i */
+    }
+
+    /* i2c2@feaa0000 + gt911@0x14：真 I2C 总线挂 goodix 影子（DTB 节点现成，
+     * goodix 驱动照常 probe）。INT → gpio3/pin16（DTB interrupts/irq-gpios） */
+    {
+        DeviceState *i2cdev = sysbus_create_simple(
+            TYPE_RK3588_LITE_I2C2_DEV, RK3588_LITE_I2C2,
+            qdev_get_gpio_in(gicdev, 0x13f));              /* SPI 319 */
+
+        s->i2c = RK3588_LITE_I2C2_DEV(i2cdev);
+    }
+
+    /* spi2@feb20000 + rk806 PMIC（14 轨 regulators 的电源之根，供电链解锁） */
+    {
+        DeviceState *spidev = sysbus_create_simple(
+            TYPE_RK3588_LITE_SPI2_DEV, RK3588_LITE_SPI2,
+            qdev_get_gpio_in(gicdev, 0x148));              /* SPI 328 */
+
+        s->spi = RK3588_LITE_SPI2_DEV(spidev);
+        s->spi->slave = SSI_PERIPHERAL(ssi_create_peripheral(s->spi->bus, "rk806"));
+    }
+
+    /* gpio3@fec40000：32 输入线 + bank IRQ（goodix 探测期还把 INT 当 GPIO 读） */
+    memory_region_init_io(&s->gpio.mmio, OBJECT(machine), &rk3588_lite_gpio_ops,
+                          &s->gpio, "rk3588-lite.gpio3", 0x80);
+    memory_region_add_subregion(sysmem, RK3588_LITE_GPIO3, &s->gpio.mmio);
+    s->gpio.bank_irq = qdev_get_gpio_in(gicdev, 0x118);     /* SPI 280 */
+    for (i = 0; i < 32; i++) {
+        s->gpio_in[i] = qemu_allocate_irq(rk3588_lite_gpio_set, &s->gpio, i);
+    }
+    qemu_set_irq(s->gpio_in[16], 1);   /* INT 平时高（去断言），等 gt911 接管 */
+
+    /* create_simple 已把设备挂在总线归属下（手动 add_child 会双亲断言）；
+     * 机器存静态指针供 HMP 注入寻址 */
+    {
+        /* 两步创建以传属性：virtio 键鼠在场（transport 里有输入设备）时
+         * gt911 宿主鼠标桥避让，防两路 grab 抢窗口拖动（M2b 教训）。
+         * 机器不感知 smoke 的设备清单——用 monitor 命令桥接：属性默认 on，
+         * HMP gt911_mouse off 可运行时关 */
+        I2CSlave *gt = i2c_slave_new(TYPE_GT911, 0x14);
+
+        qdev_prop_set_bit(DEVICE(gt), "host-mouse", true);
+        i2c_slave_realize_and_unref(gt, s->i2c->bus, &error_fatal);
+        g_gt911 = GT911(gt);
+    }
+    qdev_connect_gpio_out_named(DEVICE(g_gt911), "gt911-int", 0, s->gpio_in[16]);
+
+    vmstate_register(NULL, 0, &vmstate_rk3588_lite, s);
+
+    for (int c = 0; c < 8; c++) {
+        char nm[32];
+
+        snprintf(nm, sizeof(nm), "diag-cpuif-%d", c);
+        rk3588_lite_add_diag(OBJECT(machine), nm, &rk_forge_cpuif_update[c]);
+        snprintf(nm, sizeof(nm), "diag-vtimer-%d", c);
+        rk3588_lite_add_diag(OBJECT(machine), nm, &rk_forge_gt_recalc[c][1]);
+        snprintf(nm, sizeof(nm), "diag-ptimer-%d", c);
+        rk3588_lite_add_diag(OBJECT(machine), nm, &rk_forge_gt_recalc[c][0]);
+    }
+    rk3588_lite_add_diag(OBJECT(machine), "scmi-served", &s->scmi.served);
+    rk3588_lite_add_diag(OBJECT(machine), "scmi-errs", &s->scmi.errs);
+    rk3588_lite_add_diag(OBJECT(machine), "gpu-reads", &s->gpu.reads);
+    rk3588_lite_add_diag(OBJECT(machine), "gpu-unknown", &s->gpu.unknown);
+    rk3588_lite_add_diag(OBJECT(machine), "gpu-rf", &s->gpu.rf_count);
+    rk3588_lite_add_diag(OBJECT(machine), "op-run-frag", &s->gpu.op_hist[7]);
+    rk3588_lite_add_diag(OBJECT(machine), "op-run-fullscreen",
+                         &s->gpu.op_hist[8]);
+    rk3588_lite_add_diag(OBJECT(machine), "op-run-compute", &s->gpu.op_hist[4]);
+    rk3588_lite_add_diag(OBJECT(machine), "op-run-tiling", &s->gpu.op_hist[5]);
+    rk3588_lite_add_diag(OBJECT(machine), "op-run-idvs", &s->gpu.op_hist[6]);
+    rk3588_lite_add_diag(OBJECT(machine), "op-branch", &s->gpu.op_hist[22]);
+    rk3588_lite_add_diag(OBJECT(machine), "op-jump", &s->gpu.op_hist[33]);
+    rk3588_lite_add_diag(OBJECT(machine), "op-add-imm32", &s->gpu.op_hist[16]);
+    rk3588_lite_add_diag(OBJECT(machine), "gpu-walk-ok", &s->gpu.walk_ok);
+    rk3588_lite_add_diag(OBJECT(machine), "gpu-walk-as-ok",
+                         &s->gpu.walk_as_ok);
+    rk3588_lite_add_diag(OBJECT(machine), "gpu-walk-fail",
+                         &s->gpu.walk_fail);
+    rk3588_lite_add_diag(OBJECT(machine), "gpu-walk-fail-va",
+                         &s->gpu.walk_fail_va);
+    rk3588_lite_add_diag(OBJECT(machine), "gpu-rf-fbd-fail",
+                         &s->gpu.rf_fbd_fail);
+    rk3588_lite_add_diag(OBJECT(machine), "gpu-rf-fbd-va",
+                         &s->gpu.rf_fbd_va);
+    rk3588_lite_add_diag(OBJECT(machine), "op-call", &s->gpu.op_hist[32]);
+
+    /* pre-write the real PLL blocks (CON indices from clk-rk3588.c) with a
+     * sane encoding m=100, p=2, s=1 -> 24MHz * 100 / 2 >> 1 = 600MHz, so
+     * clock-rate queries through any PLL never return 0 (8250 EINVAL) */
+    {
+        static const int pll_con0[] = { 0, 8, 16, 88, 96, 104, 112, 120, 128 };
+
+        for (i = 0; i < ARRAY_SIZE(pll_con0); i++) {
+            s->cru_regs[pll_con0[i]] = 100;      /* CON0: m */
+            s->cru_regs[pll_con0[i] + 1] = 0x42; /* CON1: p=2, s=1 */
+        }
+        /* clk_uart2_src divider (CLKSEL_CON43 [2:6]) = 1, else the chain
+         * rate errors out and dw-apb-uart bails with EINVAL */
+        s->cru_regs[43] = 1 << 2;
+    }
+    memory_region_init_io(&s->cru, OBJECT(machine), &rk3588_lite_cru_ops,
+                          s->cru_regs, "rk3588-lite.cru", RK3588_LITE_CRU_SIZE);
+    memory_region_add_subregion(sysmem, RK3588_LITE_CRU, &s->cru);
+    memory_region_init_io(&s->sys_grf, OBJECT(machine), &rk3588_lite_yesman_ops,
+                          NULL, "rk3588-lite.sys-grf", 0x1000);
+    memory_region_add_subregion(sysmem, RK3588_LITE_SYS_GRF, &s->sys_grf);
+    memory_region_init_io(&s->pmu1grf, OBJECT(machine), &rk3588_lite_yesman_ops,
+                          NULL, "rk3588-lite.pmu1-grf", 0x1000);
+    memory_region_add_subregion(sysmem, RK3588_LITE_PMU1GRF, &s->pmu1grf);
+    memory_region_init_io(&s->pmu, OBJECT(machine), &rk3588_lite_pmu_ops,
+                          s, "rk3588-lite.pmu", 0x400);
+    memory_region_add_subregion(sysmem, RK3588_LITE_PMU, &s->pmu);
+
+    memory_region_init_io(&s->vop.mmio, OBJECT(machine), &rk3588_lite_vop_ops,
+                          &s->vop, "rk3588-lite.vop", 0x4000);
+    object_property_add_uint32_ptr(OBJECT(machine), "vop-fb-mst",
+                                   &s->vop.fb_mst, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(OBJECT(machine), "vop-fb-phys",
+                                   &s->vop.fb_phys, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(OBJECT(machine), "vop-fb-dsp",
+                                   &s->vop.fb_dsp, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(OBJECT(machine), "vop-fb-vir",
+                                   &s->vop.fb_vir, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(OBJECT(machine), "mmu-dte",
+                                   &s->mmu_regs[0], OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(OBJECT(machine), "mmu-status",
+                                   &s->mmu_regs[1], OBJ_PROP_FLAG_READ);
+    memory_region_add_subregion(sysmem, 0xfdd90000, &s->vop.mmio);
+    s->vop.irq = qdev_get_gpio_in(gicdev, 156);    /* shared vop/vop_mmu */
+    s->vop.pd_pwr = s->pmu_regs;
+    s->vop.mmu_dte = s->mmu_regs;
+    s->vop.mmu_status = &s->mmu_regs[1];
+    if (s->vop_console) {
+        static const GraphicHwOps vop_console_ops = { };
+
+        s->vop.con = qemu_graphic_console_create(NULL, 0, &vop_console_ops,
+                                                 &s->vop);
+        qemu_console_set_surface(s->vop.con,
+                                 qemu_create_placeholder_surface(640, 480,
+                                     "VOP idle - waiting for scanout"));
+    }
+    s->vop.frame_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                      rk3588_lite_vop_frame_tick, &s->vop);
+    timer_mod(s->vop.frame_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)
+              + 16666667);
+
+    memory_region_init_io(&s->dsi0, OBJECT(machine), &rk3588_lite_dsi_ops,
+                          s->pmu_regs, "rk3588-lite.dsi0", 0x1000);
+    memory_region_add_subregion(sysmem, 0xfde20000, &s->dsi0);
+
+    memory_region_init_io(&s->dcphy, OBJECT(machine), &rk3588_lite_dcphy_ops,
+                          s, "rk3588-lite.dcphy", 0x4000);
+    memory_region_add_subregion(sysmem, 0xfeda0000, &s->dcphy);
+
+    memory_region_init_io(&s->vop_mmu, OBJECT(machine), &rk3588_lite_mmu_ops,
+                          s, "rk3588-lite.vop-mmu", 0x200);
+    memory_region_add_subregion(sysmem, 0xfdd97e00, &s->vop_mmu);
+
+    {
+        /* real DTB has exactly three dmacs (fea10000/fea30000/fed10000);
+         * 0xfea00000 is the virtio transports' turf and must stay clear.
+         * Region covers the full dtsi 0x4000 window: CRn at 0xe00 and
+         * PrimeCell IDs at 0x3fe0/0x3ff0 (amba bus reads at size-0x20) */
+        static const hwaddr dmacs[3] = {
+            0xfea10000, 0xfea30000, 0xfed10000
+        };
+        for (i = 0; i < 3; i++) {
+            g_autofree char *name = g_strdup_printf("rk3588-lite.dmac%d", i);
+            memory_region_init_io(&s->amba_id[i], OBJECT(machine),
+                                  &rk3588_lite_amba_ops, NULL, name, 0x4000);
+            memory_region_add_subregion(sysmem, dmacs[i], &s->amba_id[i]);
+        }
+    }
+
+    /* peripheral-space blanket at explicit low priority (ties untrusted) */
+    {
+        DeviceState *dev = qdev_new(TYPE_UNIMPLEMENTED_DEVICE);
+        qdev_prop_set_string(dev, "name", "peripherals");
+        qdev_prop_set_uint64(dev, "size", 0x10000000);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+        memory_region_add_subregion_overlap(
+            sysmem, 0xf0000000,
+            sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0), -100);
+    }
+
+    memory_region_add_subregion(sysmem, 0, machine->ram);
+
+    /* SCMI agent 上岗：挂 SMC 钩子、频率表取量程下限、channel 置 FREE
+     * （真机这两件都是 BL31 在内核起来前干的活） */
+    rk3588_lite_scmi_machine = s;
+    arm_smc_handler = rk3588_lite_scmi_smc;
+    for (unsigned c = 0; c < RK3588_SCMI_NCLK; c++) {
+        s->scmi.rate[c] = rk3588_scmi_clks[c].min_hz;
+    }
+    address_space_stl_le(&address_space_memory,
+                         RK3588_SCMI_SHMEM + RK3588_SCMI_CHAN_STAT,
+                         RK3588_SCMI_CHAN_FREE, MEMTXATTRS_UNSPECIFIED, NULL);
+
+    /* mali-g610@fb000000：2MB 影子盖在零毯区上（常规优先级即胜 -100 毯）。
+     * 三条 IRQ 对 DT interrupts：job/mmu/gpu = SPI 92/93/94 */
+    memory_region_init_io(&s->gpu.mmio, OBJECT(machine), &rk3588_lite_gpu_ops,
+                          &s->gpu, "rk3588-lite.gpu", 0x200000);
+    memory_region_add_subregion(sysmem, 0xfb000000, &s->gpu.mmio);
+    s->gpu.job_irq = qdev_get_gpio_in(gicdev, 92);
+    s->gpu.mmu_irq = qdev_get_gpio_in(gicdev, 93);
+    s->gpu.gpu_irq = qdev_get_gpio_in(gicdev, 94);
+
+    s->boot_info = (struct arm_boot_info) {
+        .loader_start = 0, /* DRAM base 0 */
+        .board_id = -1,
+        .ram_size = machine->ram_size,
+        .psci_conduit = QEMU_PSCI_CONDUIT_SMC,
+    };
+
+    /* -bios (U-Boot proper ELF or raw u-boot.bin at TEXT_BASE) */
+    if (machine->firmware) {
+        char *fname = qemu_find_file(QEMU_FILE_TYPE_BIOS, machine->firmware);
+        uint64_t entry = 0;
+
+        if (!fname) {
+            error_report("firmware not found: %s", machine->firmware);
+            exit(1);
+        }
+        if (load_elf_as(fname, NULL, NULL, NULL, &entry, NULL, NULL, NULL,
+                        ELFDATA2LSB, EM_AARCH64, 1, 0, NULL) < 0) {
+            if (load_image_targphys_as(fname, 0x00800000,
+                                       machine->ram_size, NULL,
+                                       &error_fatal) < 0) {
+                error_report("failed to load firmware: %s", fname);
+                exit(1);
+            }
+            entry = 0x00800000;
+        }
+        g_free(fname);
+        s->boot_info.entry = entry;
+        s->boot_info.firmware_loaded = true;
+    }
+
+    if (!qtest_enabled()) {
+        arm_load_kernel(s->cpu[0], machine, &s->boot_info);
+    }
+
+    if (machine->firmware) {
+        CPUState *cs;
+
+        /* firmware-boot convention leaves env->boot_info NULL (PC stays 0);
+         * the machine knows the ELF entry, so wire boot_info ourselves */
+        CPU_FOREACH(cs) {
+            ARM_CPU(cs)->env.boot_info = &s->boot_info;
+        }
+    }
+}
+
+static const char *rk3588_lite_get_default_cpu_type(const MachineState *ms)
+{
+    if (kvm_enabled()) {
