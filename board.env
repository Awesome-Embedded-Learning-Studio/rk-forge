# board.env — board metadata. PLACEHOLDER until the real RK3506 board is chosen.
# Confirm the 正点原子/ALIENTEK SDK actually targets RK3506 when you pull it; if so,
# its board becomes this. (Firefly Core-3506BY / ArmSoM / LuckFox are alternatives.)
BOARD="rk3506-evb"
SOC="rk3506"
ARCH="arm"
ABI="armhf"
CPU="cortex-a7"

KERNEL_TRACK="mainline"            # mainline-first; BSP is a Phase-4 safety net
KERNEL_VERSION_TARGET="v7.0.12"    # verified latest stable as of 2026-06 (6.19 is EOL)
UBOOT_TRACK="mainline"             # RK3506 SoC support already upstream (Jonas Karlman v2 merged)
DT_NAME="rk3506-evb"               # boards/<board>/board.dts — rk-forge's main contribution, upstream-bound

RKBIN_REQUIRED="yes"               # DDR init blobs: github.com/rockchip-linux/rkbin, RK3506 under bin/rk35/
