+#include "qobject/qlist.h"
+
+#define TYPE_RK3588_LITE_MACHINE MACHINE_TYPE_NAME("rk3588-lite")
+OBJECT_DECLARE_SIMPLE_TYPE(Rk3588LiteState, RK3588_LITE_MACHINE)
+
+#define RK3588_LITE_NUM_CPUS 8
+#define RK3588_LITE_NUM_SPIS 512
+#define RK3588_LITE_UART2_SPI 333
+
+/* Addresses from Linux rk3588-base.dtsi (v7.1) */
+enum {
+    RK3588_LITE_PMU1GRF = 0xfd58a000,
+    RK3588_LITE_SYS_GRF = 0xfd58c000,
+    RK3588_LITE_PMU = 0xfd8d8000,
+    RK3588_LITE_CRU = 0xfd7c0000,
+    RK3588_LITE_GICD = 0xfe600000,
+    RK3588_LITE_GICR = 0xfe680000,
+    RK3588_LITE_UART2 = 0xfeb50000,
+    RK3588_LITE_VIRTIO = 0xfea00000, /* sim-only, no real counterpart */
+    RK3588_LITE_I2C2 = 0xfeaa0000,   /* goodix gt911 挂这条总线（DTB: i2c2） */
+    RK3588_LITE_GPIO3 = 0xfec40000,  /* gt911 INT=pin16 / reset=pin17 */
+    RK3588_LITE_SPI2 = 0xfeb20000,   /* rk806 PMIC 挂这条总线（DTB: spi2） */
+};
+
+#define RK3588_LITE_CRU_SIZE 0x5c000
+
+/* SCMI 常量（agent 实现在文件后部 scmi 段；post_load 也要用） */
+enum {
+    RK3588_SCMI_SMC_FID    = 0x82000010,  /* DT: firmware/scmi arm,smc-id */
+    RK3588_SCMI_SHMEM      = 0x10f000,    /* DT: reserved-memory no-map 洞 */
+    RK3588_SCMI_CHAN_STAT  = 0x04,        /* shmem = struct scmi_shared_mem */
+    RK3588_SCMI_LENGTH     = 0x14,        /* 4(msg hdr) + payload 字节数 */
+    RK3588_SCMI_MSGHDR     = 0x18,        /* id[7:0] type[9:8] proto[17:10] */
+    RK3588_SCMI_PAYLOAD    = 0x1c,
+    RK3588_SCMI_CHAN_FREE  = BIT(0),
+    RK3588_SCMI_NCLK       = 11,          /* SCMI_CLK_CPUL..DCLK_SD (cru.h) */
+    RK3588_SCMI_NRST_DOM   = 64,          /* 覆到 SCMI_SRST_H_TRNG_NS=48 */
+};
+
+struct Rk3588LiteVop {
+    MemoryRegion mmio;
+    qemu_irq irq;
+    QEMUTimer *frame_timer;
+    uint32_t *pd_pwr;             /* -> PMU pwr@0x150 word: PD_VOP lives here */
+    uint32_t regs[0x4000 / 4];    /* window blocks live at 0x1000+ */
+    uint32_t fb_mst, fb_dsp, fb_vir;
+    uint32_t fb_phys;                    /* mst 经 vop_mmu 翻译后的物理地址 */
+    uint32_t *mmu_dte, *mmu_status;   /* -> vop_mmu shadow: IOVA translation */
+    QemuConsole *con;             /* scanout goes here (same push model as ramfb) */
+    DisplaySurface *surface;
+    uint32_t last_mst, last_dsp, last_vir;
+};
+
+/* PD_VOP = BIT(1) in pwr@0x150 (cascade table); bit set = powered down.
+ * Real silicon produces no frame interrupts with the domain powered off. */
+static bool rk3588_lite_vop_powered(struct Rk3588LiteVop *s)
+{
+    return s->pd_pwr && !(s->pd_pwr[0x150 / 4] & BIT(1));
+}
+
+/* scanout push — ramfb model: wrap guest RAM in a surface, hand it to the
+ * console, full-screen update per frame tick */
+static void rk3588_lite_vop_unmap_staged(pixman_image_t *image, void *unused)
+{
+    void *data = pixman_image_get_data(image);
+
+    g_free(data);
+}
+
+/* vop_mmu IOVA→phys: the kernel programs YRGB_MST with an IOVA once the
+ * vop_mmu is attached; scanout must walk the guest's 2-level DTE/PTE tables
+ * (4KB pages, rockchip-iommu v2 layout) to find the physical fb.  A gbm bo
+ * is one contiguous gem object, so translating the base and keeping the
+ * stride math linear is correct.  Paging disabled → identity. */
+static hwaddr rk3588_lite_vop_iova_phys(struct Rk3588LiteVop *s, hwaddr iova)
+{
+    /* rockchip IOMMU **v2** 页表（compatible rk3568/3588-iommu → iommu_data_ops_v2，
+     * 见 rockchip-iommu.c of_match）：DTE 索引 = iova>>22（4MB 段），表项编码
+     * bit0=valid、11:8=地址 bit35:32、7:4=bit39:36——RAM<4GB 时掩 0xfffff000 即可；
+     * DTE_ADDR 寄存器值同编码（读回 0x5c2a001 实证带 valid 位）。 */
+    uint32_t dte, pte;
+
+    if (!s->mmu_status || !(*s->mmu_status & BIT(0))) {
+        return iova;
+    }
+    if (address_space_read(&address_space_memory,
+                           (*s->mmu_dte & 0xfffff000) + 4 * (iova >> 22),
+                           MEMTXATTRS_UNSPECIFIED, &dte, 4) != MEMTX_OK
+        || !(dte & 1)) {
+        return iova;
+    }
+    if (address_space_read(&address_space_memory, (dte & 0xfffff000)
+                               + 4 * ((iova >> 12) & 0x3ff),
+                           MEMTXATTRS_UNSPECIFIED, &pte, 4) != MEMTX_OK
+        || !(pte & 1)) {
+        return iova;
+    }
+    return (pte & 0xfffff000) | (iova & 0xfff);
+}
+
+static void rk3588_lite_vop_scanout(struct Rk3588LiteVop *s)
+{
+    uint32_t width = (s->fb_dsp & 0x1FFF) + 1;      /* DSP_INFO: hact-1 */
+    uint32_t height = ((s->fb_dsp >> 16) & 0x1FFF) + 1;
+    hwaddr stride, mapsize, linesize, fb;
+    void *data;
+
+    fb = rk3588_lite_vop_iova_phys(s, s->fb_mst);
+    s->fb_phys = fb;
+    if (!s->con) {
+        /* vop-console=off：控制台缺席（virgl 单显示设备形态，GitLab#1727），
+         * fb_phys 照常导出给 fbdump，窗口推送全部跳过 */
+        return;
+    }
+    if (width < 16 || height < 16 || width > 4096 || height > 4096
+        || fb < 0x100000) {
+        return;
+    }
+    if (s->fb_mst == s->last_mst && s->fb_dsp == s->last_dsp
+        && s->fb_vir == s->last_vir && s->last_mst) {
+        qemu_console_update_full(s->con);    /* geometry unchanged: refresh */
+        return;
+    }
+
+    linesize = width * 4;
+    stride = s->fb_vir ? s->fb_vir * 4 : linesize;
+    if (stride < linesize) {
+        stride = linesize;
+    }
+    mapsize = stride * (height - 1) + linesize;
+    /* 逐页缝合：bo 的 iova 映射不保证物理连续（页表实测跨 4MB DTE 边界
+     * 时拓扑会变），线性 base+stride 映射会读错段（花屏带）。每 4KB 页
+     * 单独走 iova 翻译后拷进连续 staging，对任意拓扑都正确 */
+    data = g_malloc(mapsize);
+    {
+        hwaddr off = 0;
+
+        while (off < mapsize) {
+            hwaddr pg = MIN(4096 - ((s->fb_mst + off) & 0xfff), mapsize - off);
+            hwaddr src = rk3588_lite_vop_iova_phys(s, s->fb_mst + off);
+
+            if (address_space_read(&address_space_memory, src,
+                                   MEMTXATTRS_UNSPECIFIED,
+                                   (uint8_t *)data + off, pg) != MEMTX_OK) {
+                memset((uint8_t *)data + off, 0, pg);
+            }
+            off += pg;
+        }
+    }
+
+    qemu_free_displaysurface(s->surface);
+    s->surface = qemu_create_displaysurface_from(width, height,
+                                                 PIXMAN_x8r8g8b8, stride,
+                                                 data);
+    pixman_image_set_destroy_function(s->surface->image,
+                                      rk3588_lite_vop_unmap_staged, NULL);
+    s->last_mst = s->fb_mst;
+    s->last_dsp = s->fb_dsp;
+    s->last_vir = s->fb_vir;
+    qemu_console_set_surface(s->con, s->surface);
+    s->surface = NULL;    /* ownership moved to the console */
+    qemu_console_update_full(s->con);
+}
+
+/* ---- scmi agent 状态（见文件后部 scmi 段） ------------------------------- */
+struct Rk3588LiteScmi {
+    uint64_t rate[11];       /* SCMI_CLK_* 当前频率（Hz） */
+    uint32_t enabled;        /* 按 id 的 enable 位图 */
+    uint64_t served, errs;   /* 诊断计数（qom 属性，不迁移） */
+};
+
+/* ---- mali-g610 GPU 状态（见文件后部 gpu 段；规格 = panthor 驱动） -------- */
+struct Rk3588LiteGpu {
+    MemoryRegion mmio;
+    qemu_irq job_irq, mmu_irq, gpu_irq;   /* GIC SPI 92/93/94 */
+    uint32_t int_rawstat, int_mask;       /* GPU_IRQ 组（0x20-0x2c） */
+    uint32_t l2_config, pwr_key, pwr_override0, pwr_override1;
+    uint64_t shader_ready, tiler_ready, l2_ready;
+    uint64_t ts_offset;
+    /* MCU/CSF 假固件握手（见 gpu 段注释） */
+    uint32_t mcu_control, mcu_status;
+    uint32_t job_rawstat, job_mask;       /* JOB_IRQ 组（0x1000-）bit31=global */
+    uint32_t csg_live;                    /* M2f：内核 GROUP_CREATE 过的槽位
+                                           * （req 状态机推，扫 ring 的门） */
+    uint32_t mmu_rawstat, mmu_mask;       /* MMU_IRQ 组（0x2000-） */
+    uint64_t as_transtab[8], as_memattr[8], as_transcfg[8];
+    uint64_t reads, unknown;              /* 诊断计数（不迁移） */
+    uint64_t op_hist[64];                 /* CS opcode 直方图（M2d 侦察） */
+    uint64_t rf_count;                    /* RUN_FRAGMENT 次数 */
+    uint64_t cs_regs[192];                /* CS 寄存器文件——跨 job 连续
+                                           * （mutter：job A 装 regs[76]、
+                                           * job B 的 LOAD_MULTIPLE 靠它） */
+    uint64_t as_committed[8];             /* AS_COMMAND 提交的 transtab（换出
+                                           * 影子的判据） */
+    uint64_t as_hist[16];                 /* 换出 transtab 影子环（M2e：多 VM
+                                           * 超过 8 槽后的 walk 回退） */
+    uint32_t as_hist_n, as_hist_head;     /* 影子环条数 + 写入位 */
+    uint64_t as_seq[8], as_seq_gen;       /* AS 编程序号（MRU 扫描序） */
+    uint64_t walk_ok, walk_fail, walk_fail_va;   /* 用户 VA walk 诊断（不迁移） */
+    uint64_t rf_fbd_fail, rf_fbd_va;      /* FBD walk 失败诊断（不迁移） */
+    uint32_t cur_as;                      /* 正在消费的组的 AS（csg input
+                                           * config，M2e 权威绑定；0=未绑定） */
+    uint64_t walk_as_ok;                  /* 经 cur_as 命中的 walk（不迁移） */
+};
+
+struct Rk3588LiteState {
+    MachineState parent_obj;
+    bool vop_console;         /* -M vop-console=off: virgl 单显示设备形态 */
+
+    ARMCPU *cpu[RK3588_LITE_NUM_CPUS];
+    MemoryRegion uart2_ext;
+    MemoryRegion cru, sys_grf, pmu1grf, pmu;
+    MemoryRegion amba_id[3], dsi0, dcphy, vop_mmu;
+    uint32_t mmu_regs[0x200 / 4];
+    struct Rk3588LiteVop vop;
+    uint32_t cru_regs[RK3588_LITE_CRU_SIZE / 4];
+    uint32_t pmu_regs[0x400 / 4];
+    uint32_t dcphy_regs[0x4000 / 4];
+    uint32_t last_req;    /* 最近一次 req 写（0x10c/0x110 任一） */
+    struct arm_boot_info boot_info;
+
+    /* i2c2@feaa0000 影子设备（规格：drivers/i2c/busses/i2c-rk3x.c） */
+    struct Rk3588LiteI2c *i2c;
+    /* gpio3@fec40000 影子（规格：drivers/gpio/gpio-rockchip.c 的 v2 双字协议） */
+    struct Rk3588LiteGpio {
+        MemoryRegion mmio;
+        qemu_irq bank_irq;   /* GIC SPI 280 */
+        uint32_t dr, ddr, int_en, int_mask, int_type, polarity, bothedge;
+        uint32_t status, lines;
+    } gpio;
+    qemu_irq gpio_in[32];    /* 外部驱动的输入线（gt911 int → pin16） */
+    struct Rk3588LiteSpi *spi;
+    struct Rk3588LiteScmi scmi;
+    struct Rk3588LiteGpu gpu;
+};
+
+/* DW-APB-UART ext space outside the 16550 window (see rk3568-lite.c). */
+static uint64_t rk3588_lite_uart2_ext_read(void *opaque, hwaddr offset,
+                                           unsigned size)
+{
+    switch (offset) {
+    case 0xf4: return 0x00020002;
+    case 0xf8: return 0x342e30;
+    default:   return 0;
+    }
+}
+
