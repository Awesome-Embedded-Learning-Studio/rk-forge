+        VMSTATE_UINT32(pwr_override0, struct Rk3588LiteGpu),
+        VMSTATE_UINT32(pwr_override1, struct Rk3588LiteGpu),
+        VMSTATE_UINT64(shader_ready, struct Rk3588LiteGpu),
+        VMSTATE_UINT64(tiler_ready, struct Rk3588LiteGpu),
+        VMSTATE_UINT64(l2_ready, struct Rk3588LiteGpu),
+        VMSTATE_UINT64(ts_offset, struct Rk3588LiteGpu),
+        VMSTATE_UINT32(mcu_control, struct Rk3588LiteGpu),
+        VMSTATE_UINT32(mcu_status, struct Rk3588LiteGpu),
+        VMSTATE_UINT32(job_rawstat, struct Rk3588LiteGpu),
+        VMSTATE_UINT32(csg_live, struct Rk3588LiteGpu),
+        VMSTATE_UINT32(job_mask, struct Rk3588LiteGpu),
+        VMSTATE_UINT32(mmu_rawstat, struct Rk3588LiteGpu),
+        VMSTATE_UINT32(mmu_mask, struct Rk3588LiteGpu),
+        VMSTATE_UINT64_ARRAY(as_transtab, struct Rk3588LiteGpu, 8),
+        VMSTATE_UINT64_ARRAY(as_memattr, struct Rk3588LiteGpu, 8),
+        VMSTATE_UINT64_ARRAY(as_transcfg, struct Rk3588LiteGpu, 8),
+        VMSTATE_UINT64_ARRAY(as_committed, struct Rk3588LiteGpu, 8),
+        VMSTATE_UINT64_ARRAY(as_hist, struct Rk3588LiteGpu, 16),
+        VMSTATE_UINT64_ARRAY(as_seq, struct Rk3588LiteGpu, 8),
+        VMSTATE_UINT64(as_seq_gen, struct Rk3588LiteGpu),
+        VMSTATE_UINT32(as_hist_n, struct Rk3588LiteGpu),
+        VMSTATE_UINT32(as_hist_head, struct Rk3588LiteGpu),
+        VMSTATE_UINT64_ARRAY(cs_regs, struct Rk3588LiteGpu, 192),
+        VMSTATE_END_OF_LIST()
