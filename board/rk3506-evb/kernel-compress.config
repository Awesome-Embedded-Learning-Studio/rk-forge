# kernel-compress.config — shrink the zImage by using XZ compression instead of
# gzip, so the (proven-booting) multi_v7 kernel FIT fits before the factory-bad
# erase block at boot-relative 0x920000 (9.2 MiB) WITHOUT removing any code.
# multi_v7 zImage = 11.5 MiB gzip; XZ ratio is much higher → expect <9 MiB.
# Decompression is slower (XZ) but fine for boot. No config/code removed → the
# known-good multi_v7 boot behavior is preserved.
CONFIG_KERNEL_XZ=y
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_LZ4 is not set
