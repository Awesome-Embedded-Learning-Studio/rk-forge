# kernel.config — defconfig FRAGMENT for rk3506b-aes.
# Merged onto arch/arm/configs/multi_v7_defconfig via scripts/kconfig/merge_config.sh.
# Not a full defconfig. multi_v7 already pulls in ARCH_ROCKCHIP + PINCTRL_ROCKCHIP
# (selected by ARCH_ROCKCHIP) + SERIAL_8250; this fragment only adds/affirms what
# the RK3506 earlycon/console path specifically needs.

# SoC platform (auto-selected by ARCH_ROCKCHIP, explicit for clarity)
CONFIG_ARCH_ROCKCHIP=y

# RK3506 clock controller is default-y on ARM (drivers/clk/rockchip/Kconfig);
# PINCTRL_ROCKCHIP is selected by ARCH_ROCKCHIP — no fragment line needed.
# (Note: there is no CONFIG_PINCTRL_RK3506 — pinctrl-rockchip.c is one driver.)

# Console / serial: RK DW 8250 UART + OF-based earlycon (bootargs "earlycon")
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# syscon regmap: required by grf/ioc_grf/ioc_pmu/ioc1 nodes (pinctrl/clk probe)
CONFIG_MFD_SYSCON=y

# SPI-NAND on the SFC — Winbond W25N04KV (persistent rootfs on NAND).
# SFC host driver (drivers/spi/spi-rockchip-sfc.c, matches `rockchip,sfc`) +
# the spi-nand framework (drivers/mtd/nand/spi/ — W25N04KV id 0xaa,0x23 already
# in winbond.c). UBI/UBIFS/SQUASHFS/MTD_BLOCK/MTD_OF_PARTS already come from
# multi_v7_defconfig. Add MTD_UBI_BLOCK=y later only if rootfs = squashfs-on-ubi.
CONFIG_SPI_ROCKCHIP_SFC=y
CONFIG_MTD_SPI_NAND=y

# Generic SPI controller (spi-rockchip.c, matches `rockchip,rk3066-spi`) — the spi0
# bus (spidev userspace on CS0/CS1). Built-in (=y): the minimal busybox rootfs
# doesn't modprobe. multi_v7_defconfig ships this =m; override to =y.
CONFIG_SPI_ROCKCHIP=y

# GT911 capacitive touch on i2c2 (Phase A2). goodix.c (drivers/input/touchscreen)
# matches "goodix,gt911". I2C + I2C_RK3X + I2C_CHARDEV already come from
# multi_v7_defconfig (Phase A2 enables the i2c0/1/2 buses); GOODIX is =y so it
# probes without a modprobe on the minimal rootfs.
CONFIG_TOUCHSCREEN_GOODIX=y

# ALSA / ASoC audio (Phase E): ES8388 codec on sai1, simple-audio-card machine.
# SOUND/SND/SND_SOC are =m in multi_v7 and were cut by kernel-trim; re-enable
# here as =y (built-in) for the minimal rootfs. rockchip_sai (controller, needs
# the rk3506 of_match patch) + es8328 (codec, mainline) + simple-card. pl330 +
# dmaddevices stay =y from multi_v7.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_SAI=y
CONFIG_SND_SOC_ES8328_I2C=y
CONFIG_SND_SIMPLE_CARD=y
