# kernel.config — defconfig FRAGMENT for rk3568-atk (RK3568 EVB1 DDR4).
# Merged onto arch/arm64/configs/defconfig (which already pulls ARCH_ROCKCHIP +
# pinctrl/clk + SERIAL_8250 + MMC_SDHCI + EXT4 + the bulk of RK3568 drivers). This
# fragment only affirms the console-boot essentials; accelerator drivers (Panfrost
# GPU / Hantro+rkvdec2 VPU / RGA / RKCIF camera) get enabled in Phase 2 fragments as
# each is brought up. eMMC boot → no NAND trim/XZ (unlike aes).
#
# Run `make savedefconfig` after a menuconfig session to regenerate cleanly.

# Console — RK3568 UART2 is the ATK debug UART
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# eMMC rootfs
CONFIG_MMC_SDHCI_OF_DW=y
CONFIG_EXT4_FS=y

# Debian/buildroot-friendly basics already in arm64 defconfig; affirmed here
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- Ethernet: 2x RTL8211F RGMII (was =m → no eth0 without modprobe; force =y) ----
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_DWMAC_GENERIC=y
CONFIG_REALTEK_PHY=y
CONFIG_MDIO_DEVICE=y

# ---- Touchscreen (GT911) + adc-keys ----
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_KEYBOARD_ADC=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_IIO=y

# ---- Audio: RK809 PMIC codec (ATK has NO ES8388) ----
CONFIG_SOUND=y                     # 框架总开关! (漏了它 SND/SND_SOC/RK817 整栈 =m)
CONFIG_SND=y                       # 框架 built-in! (同上)
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SOC_BT_SCO=y
CONFIG_SND_SIMPLE_CARD=y

# ---- LCD / DRM: ATK 10.1" MIPI ILI9881C ----
CONFIG_DRM=y                       # 框架 built-in! (漏了它整栈降 =m, busybox 无 modules)
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_DW_MIPI_DSI=y
CONFIG_DRM_PANEL_ILITEK_ILI9881C=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y  # dsi_dphy1 (fe860000) — 漏了它 =m, dsi1 defer 屏不亮
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_ROCKCHIP=y

# ---- board-misc (CAN/RTC/fan/leds) ----
CONFIG_LEDS_GPIO=y
CONFIG_CAN=y
CONFIG_CAN_ROCKCHIP_CANFD=y
CONFIG_RTC_DRV_PCF8563=y
CONFIG_SENSORS_PWM_FAN=y
CONFIG_MMC_PWRSEQ_SIMPLE=y

# ---- RK3568 所有 Rockchip 平台驱动一次全 =y (不再一个个漏 =m) ----
CONFIG_PCIE_ROCKCHIP_HOST=y
CONFIG_SPI_ROCKCHIP_SFC=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_VIDEO_ROCKCHIP_RGA=y
CONFIG_VIDEO_ROCKCHIP_CIF=y
CONFIG_DRM_PANFROST=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_ROCKCHIP_SAI=y
CONFIG_SND_SOC_ROCKCHIP_SPDIF=y
CONFIG_SND_SOC_ROCKCHIP_RT5645=y
CONFIG_DEVFREQ_EVENT_ROCKCHIP_DFI=y
CONFIG_PHY_ROCKCHIP_INNO_HDMI=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_PHY_ROCKCHIP_PCIE=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX=y
CONFIG_PHY_ROCKCHIP_USBDP=y

# ---- Reset framework (sdio-pwrseq ngpio==1 走 reset_control, 要 gpio reset controller built-in) ----
CONFIG_RESET_GPIO=y

# ---- WiFi: rtl8852bs (SDIO, armbian fork 已适配 7.1; =m + S99wifi insmod) ----
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8852BS=m
