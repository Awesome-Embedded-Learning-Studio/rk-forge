# config/boards/rk3568-atk.env — board constants for the `rk3568-atk` board
# (ATK-DLRK3568 / 正点原子 RK3568 EVB1 DDR4 v1.0).
#
# RK3568 = Cortex-A55 ×4, aarch64. Mainline-first (linux v7.1 + mainline U-Boot):
# SoC basics, GPU (Panfrost), VPU (Hantro+rkvdec2), RGA, camera (RKCIF/rkisp1), all
# peripherals are mainline + open. The ONE vendor exception is the NPU — the mainline
# "Rocket" driver is RK3588-only; RK3568's NPU (different IP) needs the GPL vendor
# rknpu2 driver ported out-of-tree + the closed librknnrt.so userspace. That exception
# is documented in document/sdk-diff-rk3568.md (a deliberate "NPU essential" trade-off).
#
# Reference pool (NOT a build input): reference/rk3568/ (ATK vendor SDK) — board DT,
# configs, rkbin blobs, rknpu2 driver source are mined from there.

# --- identity ---
BOARD="rk3568-atk"
SOC="rk3568"
ARCH="arm64"
ABI="aarch64"
CPU="cortex-a55"
KERNEL_BASE="v7.1"          # src/linux tag the patches/rk3568-atk/linux series applies onto

# --- kernel board DT ---
# Mainline ships rk3568-evb1-v10.dts (the Rockchip RK3568 EVB1 v10 — the ATK board is an
# EVB1 variant; vendor compatible is "rockchip,rk3568-evb1-ddr4-v10", same EVB1 base).
# MVP reuses mainline's rk3568-evb1-v10.dtb DIRECTLY — NO board DT patch needed for boot.
# ATK-specific add-ons / the ddr4-variant designation are layered as DT additions in Phase 2.
DT_NAME="rk3568-evb1-v10"
KERN_IMG="Image"            # arch/${ARCH}/boot/${KERN_IMG}  (arm64 = Image)
KERNEL_BASE_DEFCONFIG="arch/arm64/configs/defconfig"  # arm64 base; ARCH_ROCKCHIP + a fragment enables RK3568 specifics (Panfrost/Hantro/rkvdec2/RGA/RKCIF/rknpu)
KERNEL_FRAGMENTS="kernel.config"  # eMMC boot — no NAND boot-size trim/XZ needed (just one fragment)

# --- u-boot ---
# Mainline U-Boot has evb-rk3568_defconfig; a board patch adds the ATK DT + tweaks.
UBOOT_DEFCONFIG="evb-rk3568_defconfig"
UBOOT_DEFCONFIG_SD=""       # SD variant TBD (RK3568 ATK is eMMC-primary; SD optional later)

# --- buildroot ---
BUILDROOT_DEFCONFIG="rk3568_atk_defconfig"   # under board/rk3568-atk/buildroot-external/configs/ (aarch64, external toolchain, Qt5/gstreamer/mesa/ffmpeg + librknnrt)

# --- storage ---
STORAGE="emmc"              # eMMC/GPT (NOT SPI-NAND like aes → no ubiprog; GPT + ext4 rootfs)

# --- workspace (project-relative) ---
BRINGUP_DIR="board/rk3568-atk"        # build/assembly workspace (fit, manifests, out/)
BOARD_CFG_DIR="board/rk3568-atk"      # kernel config fragments (same dir; no separate -evb split)

# --- rkbin blob tuple (public rockchip-linux/rkbin; RK3568 blobs live under bin/rk35/,
# same subdir as RK3506 — only the filename prefixes differ) ---
#   rk3568-atk tuple = {ddr, usbplug, spl, bl31(.elf ATF), bl32/tee(.bin)}  — has BL31!
RKBIN_BLOB_SUBDIR="bin/rk35"
RKBIN_DDR_PAT="rk3568_ddr_1560MHz_v1.*.bin"
RKBIN_USBPLUG_PAT="rk356x_usbplug_v1.*.bin"
RKBIN_SPL_PAT="rk356x_spl_v1.*.bin"           # matches rk356x_spl_v1.14.bin (not the _nand variant)
RKBIN_TEE_PAT="rk3568_bl32_v*.bin"            # BL32 = OP-TEE (the "tee" slot)
RKBIN_TEE_EXCLUDE=""
RKBIN_BL31_PAT="rk3568_bl31_v*.elf"           # BL31 = ARM Trusted Firmware (RK3568 has ATF; RK3506 has none)

# --- loader ini (board-specific). RK3568 loader = RKBOOT (SPL) + RKTRUST (BL31+BL32) —
# pack-loader.sh needs RKTRUST ini support added (aes's single-RKBOOT flow doesn't cover BL31). ---
LOADER_INI="RKBOOT-RK3568-atk.ini"
LOADER_TRUST_INI="RKTRUST-RK3568-atk.ini"     # Phase 1: pack-loader extension to process this

# --- pack/assemble manifests (under ${BRINGUP}/) ---
PARAMETER_EMMC="parameter-emmc-atk.txt"       # GPT, from vendor parameter-buildroot-fit.txt
PKGFILE_EMMC="package-file-emmc.txt"          # RKAF manifest for the eMMC update.img

# --- toolchain (aarch64; the armhf one is for aes) ---
# Arm GNU Toolchain 15.3.Rel1, /opt (parallel to the armhf one).
TOOLCHAIN_PREFIX="aarch64-none-linux-gnu-"
TOOLCHAIN_BIN_DIR="/opt/arm-gnu-toolchain-15.3.rel1-x86_64-aarch64-none-linux-gnu/bin"
TOOLCHAIN_SYSROOT=""
