+		goto unreg_v4l2_dev;
 	}
 
 	ret = pm_runtime_resume_and_get(rga->dev);
@@ -847,9 +803,32 @@ static int rga_probe(struct platform_device *pdev)
 
 	pm_runtime_put(rga->dev);
 
+	if (!v4l2_m2m_core_is_leader(&rga->core)) {
+		ret = v4l2_m2m_core_register(&rga->core);
+		if (ret)
+			goto rel_m2m;
+		return 0;
+	}
+
+	vfd = video_device_alloc();
+	if (!vfd) {
+		ret = -ENOMEM;
+		goto rel_m2m;
+	}
+	*vfd = rga_videodev;
+	vfd->lock = &rga->mutex;
+	vfd->v4l2_dev = &rga->v4l2_dev;
+	video_set_drvdata(vfd, rga);
+	rga->vfd = vfd;
+
 	ret = video_register_device(vfd, VFL_TYPE_VIDEO, -1);
 	if (ret) {
 		v4l2_err(&rga->v4l2_dev, "Failed to register video device\n");
+		goto rel_vdev;
+	}
+	ret = v4l2_m2m_core_register(&rga->core);
+	if (ret) {
+		video_unregister_device(vfd);
 		goto rel_m2m;
 	}
 
@@ -858,10 +837,10 @@ static int rga_probe(struct platform_device *pdev)
 
 	return 0;
 
-rel_m2m:
-	v4l2_m2m_release(rga->m2m_dev);
 rel_vdev:
 	video_device_release(vfd);
+rel_m2m:
+	v4l2_m2m_release(rga->m2m_dev);
 unreg_v4l2_dev:
 	v4l2_device_unregister(&rga->v4l2_dev);
 err_put_clk:
@@ -876,8 +855,10 @@ static void rga_remove(struct platform_device *pdev)
 
 	v4l2_info(&rga->v4l2_dev, "Removing\n");
 
