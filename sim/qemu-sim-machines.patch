+/* ---- scmi agent: TF-A BL31 的 SMC 侧影子 ---------------------------------
+ * 规格（=真机对侧的实现）：drivers/firmware/arm_scmi/ 的 transports/smc.c +
+ * shmem.c + base.c + clock.c + reset.c。真机 GPU（assigned-clocks）/cpufreq
+ * 的时钟走 SCMI：DT firmware/scmi 节点声明 arm,smc-id=0x82000010、shmem=
+ * 0x10f000/0x100（DRAM reserved-memory no-map 洞，非 MMIO）。无 TF-A 的
+ * 仿真里机器自己当 agent：SMC 钩子里同步消费 shmem 消息、写回应答并置
+ * channel FREE——polling 模式合同要求应答在 SMC 返回前落内存。
+ * 协议版本刻意报低（BASE/CLOCK 2.0，RESET 1.0）：低于内核支持上限就不
+ * 触发 NEGOTIATE，也避开 v3 的扩展名字/CONFIG_GET 消息族。
+ */
+/* 名字带 scmi_ 前缀：CLOCK_ATTRIBUTES 的 name 走 clk_register，与 CRU
+ * 同名会 -EEXIST（首轮实测 clk_gpu 撞名丢注册） */
+static const struct {
+    const char *name;
+    uint32_t min_hz, max_hz, step_hz;
+} rk3588_scmi_clks[RK3588_SCMI_NCLK] = {
+    [0]  = { "scmi_clk_cpul",   408000000, 1800000000u, 24000000 },
+    [1]  = { "scmi_clk_dsu",    300000000,  900000000,  30000000 },
+    [2]  = { "scmi_clk_cpub01", 408000000, 2200000000u, 24000000 },
+    [3]  = { "scmi_clk_cpub23", 408000000, 2200000000u, 24000000 },
+    [4]  = { "scmi_clk_ddr",    400000000, 1600000000u,  50000000 },
+    [5]  = { "scmi_clk_gpu",    100000000,  900000000,  50000000 },
+    [6]  = { "scmi_clk_npu",    200000000, 1000000000u,  50000000 },
+    [7]  = { "scmi_clk_sbus",    50000000,  500000000,  50000000 },
+    [8]  = { "scmi_pclk_sbus",   50000000,  300000000,  25000000 },
+    [9]  = { "scmi_cclk_sd",     40000000,  200000000,  40000000 },
+    [10] = { "scmi_dclk_sd",     25000000,  200000000,  25000000 },
+};
+
+static Rk3588LiteState *rk3588_lite_scmi_machine;
+
+/* walk 指定 AS 的 LPAE 页表（与 rk3588_lite_gpu_va_pa 同格式，只是
+ * transtab 可选）。返回 true 时 *pa 有效。 */
+static bool rk3588_lite_gpu_va_pa_in(struct Rk3588LiteGpu *g, uint64_t transtab,
+                                     uint64_t va, hwaddr *pa)
+{
+    hwaddr tbl = transtab & 0x0000fffffffff000ull;
+    uint64_t e;
+    int lvl;
+
+    for (lvl = 0; lvl < 3; lvl++) {
+        e = address_space_ldq_le(&address_space_memory,
+                                 tbl + ((va >> (39 - 9 * lvl)) & 0x1ff) * 8,
+                                 MEMTXATTRS_UNSPECIFIED, NULL);
+        if (!(e & 1)) {
+            return false;
+        }
+        if ((e & 3) == 1) {
+            *pa = (e & 0x0000fffffffff000ull) +
+                  (va & ((1ull << (39 - 9 * lvl)) - 1));
+            return true;
+        }
+        tbl = e & 0x0000fffffffff000ull;
+    }
+    e = address_space_ldq_le(&address_space_memory,
+                             tbl + ((va >> 12) & 0x1ff) * 8,
+                             MEMTXATTRS_UNSPECIFIED, NULL);
+    if ((e & 3) != 3) {
+        return false;
+    }
+    *pa = (e & 0x0000fffffffff000ull) + (va & 0xfff);
+    return true;
+}
+
+/* 用户/组 VM 的 VA 翻译：ring/syncobj 的 GPU VA 不在 fw 的 AS0——扫
+ * AS1..7（内核 group start 时 program 的 transtab），第一个 walk 成功者。
+ * M2e 权威路径：cs_consume 读 csg input.config（内核 csg_slot_prog 写
+ * panthor_vm_as(group->vm)）得到组绑定的 AS——有绑定时**只走该表**（真
+ * 固件语义：组换 AS 上下文执行）。多 VM 的堆区 VA 高度别名，首个成功
+ * 的全表扫可能穿错 VM（实测：glClear 在 mutter 并发下 clear 写错物理页，
+ * readback 全零）。未绑定（config 无效）才回退 MRU 扫描 + 换出影子。 */
+static hwaddr rk3588_lite_gpu_va_pa_user(struct Rk3588LiteGpu *g, uint64_t va)
+{
+    hwaddr pa;
+
+    if (g->cur_as >= 1 && g->cur_as < 8 && g->as_transtab[g->cur_as] &&
+        rk3588_lite_gpu_va_pa_in(g, g->as_transtab[g->cur_as], va, &pa)) {
+        g->walk_as_ok++;
+        g->walk_ok++;
+        return pa;
+    }
+    unsigned ord[7], n = 0;
+
+    for (unsigned as = 1; as < 8; as++) {
+        if (!g->as_transtab[as]) {
+            continue;
+        }
+        unsigned j = n++;    /* 按 as_seq 降序插入（0=未见 AS_COMMAND=最旧） */
+        while (j && g->as_seq[ord[j - 1]] < g->as_seq[as]) {
+            ord[j] = ord[j - 1];
+            j--;
+        }
+        ord[j] = as;
+    }
+    for (unsigned i = 0; i < n; i++) {
+        if (rk3588_lite_gpu_va_pa_in(g, g->as_transtab[ord[i]], va, &pa)) {
+            g->walk_ok++;
+            return pa;
+        }
+    }
+    for (unsigned i = 0; i < g->as_hist_n; i++) {
+        unsigned h = (g->as_hist_head + 15 - i) & 15;
+
+        if (rk3588_lite_gpu_va_pa_in(g, g->as_hist[h], va, &pa)) {
+            g->walk_ok++;
+            return pa;
+        }
+    }
+    g->walk_fail++;
+    g->walk_fail_va = va;
+    return HWADDR_MAX;
+}
+
+static uint32_t rk3588_scmi_le32(hwaddr addr)
+{
+    return address_space_ldl_le(&address_space_memory, addr,
+                                MEMTXATTRS_UNSPECIFIED, NULL);
+}
+
+/* out[] 追加一个 SCMI 短名（16B 定长，'\0' 填充），返回新字数 */
+static unsigned rk3588_scmi_put_name(uint32_t *out, unsigned n,
+                                     const char *name)
+{
+    char *p = (char *)&out[n];
+
+    memset(p, 0, 16);
+    strncpy(p, name, 15);
+    return n + 4;
+}
+
+/* 消息分发；返回 SCMI status（0 成功，-1 NOT_SUPPORTED），应答字写入 out */
+static int rk3588_lite_scmi_dispatch(Rk3588LiteState *s, uint8_t proto,
+                                     uint8_t id, const uint32_t *tx,
+                                     uint32_t *out, unsigned *n)
+{
+    unsigned c;
+    uint64_t r;
+
+    *n = 0;
+    switch (proto) {
+    case 0x10:    /* BASE */
+        switch (id) {
+        case 0x0:  /* PROTOCOL_VERSION */
+            out[(*n)++] = 0x00020000;
+            return 0;
+        case 0x1:  /* PROTOCOL_ATTRIBUTES：byte0=proto 数 byte1=agent 数
+                    * （base.c struct scmi_msg_resp_base_attributes，非 spec 位域） */
+            out[(*n)++] = (1u << 8) | 2;
+            return 0;
+        case 0x2:  /* PROTOCOL_MESSAGE_ATTRIBUTES */
+            out[(*n)++] = 0;
+            return 0;
+        case 0x3:  /* DISCOVER_VENDOR */
+        case 0x4:  /* DISCOVER_SUB_VENDOR */
+            *n = rk3588_scmi_put_name(out, 0, id == 0x3 ? "rk-forge" : "sim");
+            return 0;
+        case 0x5:  /* DISCOVER_IMPLEMENT_VERSION */
+            out[(*n)++] = 0x1;
+            return 0;
+        case 0x6:  /* DISCOVER_LIST_PROTOCOLS: 数量[11:0] + id 字节序列 */
+            out[0] = 2;
+            out[1] = 0x16 << 8 | 0x14;    /* clock, reset */
+            *n = 2;
+            return 0;
+        case 0x7:  /* DISCOVER_AGENT(id=0 是自己) */
+            *n = rk3588_scmi_put_name(out, 0, "linux");
+            return 0;
+        case 0x8:  /* NOTIFY_ERRORS */
+            return 0;
+        default:
+            return -1;
+        }
+    case 0x14:    /* CLOCK */
+        switch (id) {
+        case 0x0:
+            out[(*n)++] = 0x00020000;
+            return 0;
+        case 0x1:  /* 时钟数[15:0] */
+            out[(*n)++] = RK3588_SCMI_NCLK;
+            return 0;
+        case 0x2:
+            out[(*n)++] = 0;
+            return 0;
+        case 0x3:  /* CLOCK_ATTRIBUTES */
+        case 0x8:  /* NAME_GET（v3 扩展名路径，顺手应答） */
+            c = tx[0];
+            if (c >= RK3588_SCMI_NCLK) {
+                return -2;
+            }
+            out[(*n)++] = (s->scmi.enabled >> c) & 1;
+            *n = rk3588_scmi_put_name(out, *n, rk3588_scmi_clks[c].name);
+            return 0;
+        case 0x4:  /* DESCRIBE_RATES：线性三元组 returned=3 BIT(12) */
+            c = tx[0];
+            if (c >= RK3588_SCMI_NCLK) {
+                return -2;
+            }
+            out[(*n)++] = 3u | BIT(12);
+            out[(*n)++] = rk3588_scmi_clks[c].min_hz;
+            out[(*n)++] = 0;
+            out[(*n)++] = rk3588_scmi_clks[c].max_hz;
+            out[(*n)++] = 0;
+            out[(*n)++] = rk3588_scmi_clks[c].step_hz;
+            out[(*n)++] = 0;
+            return 0;
+        case 0x5:  /* RATE_SET(id, flags, lo, hi)：夹到量程内存储 */
+            c = tx[0];
+            if (c >= RK3588_SCMI_NCLK) {
+                return -2;
+            }
+            r = (uint64_t)tx[3] << 32 | tx[2];
+            r = MAX(r, rk3588_scmi_clks[c].min_hz);
+            r = MIN(r, rk3588_scmi_clks[c].max_hz);
+            s->scmi.rate[c] = r;
+            return 0;
+        case 0x6:  /* RATE_GET(id) */
+            c = tx[0];
+            if (c >= RK3588_SCMI_NCLK) {
+                return -2;
+            }
+            out[(*n)++] = (uint32_t)s->scmi.rate[c];
+            out[(*n)++] = (uint32_t)(s->scmi.rate[c] >> 32);
+            return 0;
+        case 0x7:  /* CONFIG_SET(id, attrs)：bit0=enable */
+            c = tx[0];
+            if (c >= RK3588_SCMI_NCLK) {
+                return -2;
+            }
+            if (tx[1] & 1) {
+                s->scmi.enabled |= 1u << c;
+            } else {
+                s->scmi.enabled &= ~(1u << c);
+            }
+            return 0;
+        default:
+            return -1;
+        }
+    case 0x16:    /* RESET */
+        switch (id) {
+        case 0x0:
+            out[(*n)++] = 0x00010000;
+            return 0;
+        case 0x1:  /* reset 域数[15:0] */
+            out[(*n)++] = RK3588_SCMI_NRST_DOM;
+            return 0;
+        case 0x2:
+            out[(*n)++] = 0;
+            return 0;
+        case 0x3:  /* DOMAIN_ATTRIBUTES */
+            if (tx[0] >= RK3588_SCMI_NRST_DOM) {
+                return -2;
+            }
+            out[(*n)++] = 0;
+            *n = rk3588_scmi_put_name(out, *n, "scmi_rst");
+            return 0;
+        case 0x4:  /* RESET(domain, flags) */
+            return 0;
+        default:
+            return -1;
+        }
+    default:
+        return -1;
+    }
+}
+
+static bool rk3588_lite_scmi_smc(ARMCPU *cpu, uint32_t fid)
+{
+    static int trace_on = -1;     /* SCMIDBG=1 时逐消息打 stderr */
+    Rk3588LiteState *s = rk3588_lite_scmi_machine;
+    uint32_t hdr, len, tx[4] = { 0 }, out[10];
+    unsigned i, n = 0;
+    int32_t status;
+    hwaddr base = RK3588_SCMI_SHMEM;
+
+    if (trace_on == -1) {
+        trace_on = getenv("SCMIDBG") != NULL;
+        if (trace_on) {
+            fprintf(stderr, "SCMI agent armed (hook reached)\n");
+        }
+    }
+    if (trace_on) {
+        fprintf(stderr, "SCMI hook fid=%08x match=%d\n",
+                fid, fid == RK3588_SCMI_SMC_FID && s != NULL);
+    }
+
+    /* BL31 还兼任 SMCCC 版本应答。QEMU 内建 PSCI 的 FEATURES 只认 PSCI
+     * 函数族，对 0x80000000 答 NOT_SUPPORTED，于是内核 psci_init_smccc
+     * 拿不到版本、arm_smccc_1_1_get_conduit() 判 NONE，SCMI 的 invoke
+     * 直接填 NOT_SUPPORTED——根本不发 SMC。报 1.1（不报 1.2，避开
+     * SOC_ID 探测路径）。 */
+    if (fid == 0x8400000a && cpu->env.xregs[1] == 0x80000000) {
+        cpu->env.xregs[0] = 0;             /* FEATURES: SMCCC_VERSION 可查 */
+        return true;
+    }
+    if (fid == 0x80000000) {
+        cpu->env.xregs[0] = 0x80010000;    /* SMCCC_VERSION = 1.1 */
+        return true;
+    }
+
+    if (fid != RK3588_SCMI_SMC_FID || s == NULL) {
+        return false;
+    }
+
+    hdr = rk3588_scmi_le32(base + RK3588_SCMI_MSGHDR);
+    len = rk3588_scmi_le32(base + RK3588_SCMI_LENGTH);
+    for (i = 0; i < 4 && len >= 8 + 4 * i; i++) {
+        tx[i] = rk3588_scmi_le32(base + RK3588_SCMI_PAYLOAD + 4 * i);
+    }
+    status = rk3588_lite_scmi_dispatch(s, (hdr >> 10) & 0xff, hdr & 0xff,
+                                       tx, out, &n);
+
+    /* 应答 = status + out[]；length = 4(hdr) + 4(status) + n*4，随后 FREE */
+    address_space_stl_le(&address_space_memory, base + RK3588_SCMI_PAYLOAD,
+                         status, MEMTXATTRS_UNSPECIFIED, NULL);
+    for (i = 0; i < n; i++) {
+        address_space_stl_le(&address_space_memory,
+                             base + RK3588_SCMI_PAYLOAD + 4 + 4 * i,
+                             out[i], MEMTXATTRS_UNSPECIFIED, NULL);
+    }
+    address_space_stl_le(&address_space_memory, base + RK3588_SCMI_LENGTH,
+                         8 + 4 * n, MEMTXATTRS_UNSPECIFIED, NULL);
+    address_space_stl_le(&address_space_memory, base + RK3588_SCMI_CHAN_STAT,
+                         RK3588_SCMI_CHAN_FREE, MEMTXATTRS_UNSPECIFIED, NULL);
+
+    s->scmi.served++;
+    if (status != 0) {
+        s->scmi.errs++;
+    }
+    if (trace_on) {
+        fprintf(stderr, "SCMI proto=%02x id=%02x tx0=%08x -> status=%d n=%u\n",
+                (hdr >> 10) & 0xff, hdr & 0xff, tx[0], status, n);
+    }
+    cpu->env.xregs[0] = 0;    /* SMCCC SUCCESS */
+    return true;
+}
+
+static const VMStateDescription vmstate_rk3588_lite_scmi = {
+    .name = "rk3588-lite/scmi",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT64_ARRAY(rate, struct Rk3588LiteScmi, RK3588_SCMI_NCLK),
+        VMSTATE_UINT32(enabled, struct Rk3588LiteScmi),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+/* ---- mali-g610@fb000000: panthor（v7.1）的最小 GPU 影子 -------------------
+ * 规格 = drivers/gpu/drm/panthor/：偏移取 panthor_regs.h，访问序列取
+ * panthor_hw.c/gpu.c（驱动即规格）。GPU_ID=0xa8670005 的 arch major=10
+ * → panthor_hw_match 绑 v10 经典寄存器路线（无 PWR_CTRL 子系统）。
+ * 静态 ID/features 用真机日志值（note 76 §2.3），未采样寄存器取保守 0。
+ * 电源块全同步：写 PWRON 立即就绪、PWRTRANS 恒 0——驱动侧
+ * block_power_on 是纯 readl_poll_timeout，等得住。
+ * GPU_CMD 完成位同步进 RAWSTAT：soft_reset/flush_caches 是
+ * wait_event_timeout + 事后核验 RAWSTAT 的兜底结构，不拉 IRQ 也过；
+ * 仍按电平语义（stat = raw & mask）拉 GPU_IRQ（SPI 94），更贴真机。
+ */
+enum {
+    GPU_IRQ_RESET_COMPLETED          = BIT(8),
+    GPU_IRQ_CLEAN_CACHES_COMPLETED   = BIT(17),
+    GPU_STATUS_ACTIVE                = BIT(0),
+    GPU_STATUS_PWR_ACTIVE            = BIT(1),
+};
+
+static void rk3588_lite_gpu_update_irq(struct Rk3588LiteGpu *g)
+{
+    qemu_set_irq(g->gpu_irq, !!(g->int_rawstat & g->int_mask));
+    qemu_set_irq(g->job_irq, !!(g->job_rawstat & g->job_mask));
+    qemu_set_irq(g->mmu_irq, !!(g->mmu_rawstat & g->mmu_mask));
+}
+
+/* LPAE 走查（驱动 io_pgtable 用 ARM_64_LPAE_S1：48VA/40PA，4K 页+2M/1G
+ * block，表项 64 位 LE，bits[1:0] 01=block/11=table|page）。失败返
+ * HWADDR_MAX——不 fault 不 crash，让驱动侧超时自己报（可见性好）。 */
+static hwaddr rk3588_lite_gpu_va_pa(struct Rk3588LiteGpu *g, uint64_t va)
+{
+    hwaddr tbl = g->as_transtab[0] & 0x0000fffffffff000ull;
+    uint64_t e;
+    int lvl;
+
+    for (lvl = 0; lvl < 3; lvl++) {
+        e = address_space_ldq_le(&address_space_memory,
+                                 tbl + ((va >> (39 - 9 * lvl)) & 0x1ff) * 8,
+                                 MEMTXATTRS_UNSPECIFIED, NULL);
+        if (!(e & 1)) {
+            return HWADDR_MAX;
+        }
+        if ((e & 3) == 1) {    /* block：lvl1=1G lvl2=2M */
+            return (e & 0x0000fffffffff000ull) +
+                   (va & ((1ull << (39 - 9 * lvl)) - 1));
+        }
+        tbl = e & 0x0000fffffffff000ull;
+    }
+    e = address_space_ldq_le(&address_space_memory,
+                             tbl + ((va >> 12) & 0x1ff) * 8,
+                             MEMTXATTRS_UNSPECIFIED, NULL);
+    if ((e & 3) != 3) {
+        return HWADDR_MAX;
+    }
+    return (e & 0x0000fffffffff000ull) + (va & 0xfff);
+}
+
+/* 假 MCU 上电（= note 76 §2.5 的捷径）：真机 MCU 从 shared section 读
+ * control 并写 version；我们直接经 AS0 页表把 CSF_MCU_SHARED_REGION_
+ * START（0x04000000）control.version 写成 1.5.0，然后置 ENABLED +
+ * JOB_INT_GLOBAL_IF。驱动侧合同：fw_boot 1000ms 等 GLOBAL_IF（超时后
+ * 兜底核验 JOB_INT_STAT），fw_init_ifaces 直读 kmap 的 version==0 报错。 */
+static void rk3588_lite_gpu_mcu_boot(struct Rk3588LiteGpu *g)
+{
+    hwaddr pa = rk3588_lite_gpu_va_pa(g, 0x04000000);
+
+    if (pa == HWADDR_MAX) {
+        g->mcu_status = 0;    /* 页表未就绪：驱动会看到 disabled + 超时 */
+        return;
+    }
+    address_space_stl_le(&address_space_memory, pa, 0x01050000,
+                         MEMTXATTRS_UNSPECIFIED, NULL);
+    if (getenv("GPUDBG")) {
+        /* M2f：blob 铺进 BO 的 glb control 原文（内核 group_num/csg_slot_
+         * count 的唯一来源）——0x10=group_num、0x14=group_stride。 */
+        fprintf(stderr, "GLBCTL in=%x out=%x group_num=%u stride=%x\n",
+                address_space_ldl_le(&address_space_memory, pa + 8,
+                                     MEMTXATTRS_UNSPECIFIED, NULL),
+                address_space_ldl_le(&address_space_memory, pa + 0xc,
+                                     MEMTXATTRS_UNSPECIFIED, NULL),
+                address_space_ldl_le(&address_space_memory, pa + 0x10,
+                                     MEMTXATTRS_UNSPECIFIED, NULL),
+                address_space_ldl_le(&address_space_memory, pa + 0x14,
+                                     MEMTXATTRS_UNSPECIFIED, NULL));
+    }
+    /* 每组 CSG control（+0x1000 + i*0xa0，8 组）的 suspend/protm_suspend_
+     * size：镜像初值 0，真机由 MCU 上电填写；group_create 拿 0 去 alloc
+     * suspend buf 会 -ENOSPC。必须 8 组全写——驱动校验所有 CSG 槽一致
+     * （"Expecting identical CSG slots"）。0x1000/0x800 为占位，真机值
+     * 待采（note 76 §六.2 fixture）。 */
+    pa = rk3588_lite_gpu_va_pa(g, 0x04001000);
+    if (pa != HWADDR_MAX) {
+        for (unsigned i = 0; i < 8; i++) {
+            address_space_stl_le(&address_space_memory,
+                                 pa + i * 0xa0 + 0xc, 0x1000,
+                                 MEMTXATTRS_UNSPECIFIED, NULL);
+            address_space_stl_le(&address_space_memory,
+                                 pa + i * 0xa0 + 0x10, 0x800,
+                                 MEMTXATTRS_UNSPECIFIED, NULL);
+        }
+        /* 全部 8 CSG × 8 CS 的 control（内核 init 按 group_stride 0xa0
+         * + CSF_STREAM_CONTROL_OFFSET 0x40 + stream_stride 0xc 遍历所有
+         * 槽并校验 features 一致；镜像无初值）。cs_reg_count =
+         * CS_FEATURES_WORK_REGS(features)——0 会让 mesa 拿 1 个寄存器；
+         * **192（0xbf）是 v10 正确值**：256 时 mesa cs_builder 的 dirty
+         * 位图扫描越界（csf_init_context_v10 栈数组打穿，A/B 实证）。
+         * work_regs=192 / sb=8 / C+F+T 全开；真机原始值仍待采。
+         * input/output VA 落在 64KB shared 段内（内核 kmap 只要求在 BO
+         * 范围内）。 */
+        for (unsigned csg = 0; csg < 8; csg++) {
+            for (unsigned cs = 0; cs < 8; cs++) {
+                hwaddr cs_pa = pa + csg * 0xa0 + 0x40 + cs * 0xc;
+                unsigned idx = csg * 8 + cs;
+
+                address_space_stl_le(&address_space_memory, cs_pa,
+                                     0x000708bf, MEMTXATTRS_UNSPECIFIED,
+                                     NULL);
+                address_space_stl_le(&address_space_memory, cs_pa + 4,
+                                     0x04003400 + idx * 0x10,
+                                     MEMTXATTRS_UNSPECIFIED, NULL);
+                address_space_stl_le(&address_space_memory, cs_pa + 8,
+                                     0x04007400 + idx * 0x10,
+                                     MEMTXATTRS_UNSPECIFIED, NULL);
+            }
+        }
+    }
+    g->mcu_status = 1;        /* MCU_STATUS_ENABLED */
+    g->job_rawstat |= BIT(31);   /* JOB_INT_GLOBAL_IF */
+    rk3588_lite_gpu_update_irq(g);
+}
+
+static void rk3588_lite_gpu_cs_consume(struct Rk3588LiteGpu *g,
+                                       hwaddr csg_ctl, hwaddr csg_in,
+                                       hwaddr csg_out, unsigned csg,
+                                       unsigned cs);
+
+/* 全局 doorbell（CSF_DOORBELL(0)）+ CSG doorbell（1..8，M2a）：toggle/ACK
+ * 合同（note 76 §2.7）。等待方 panthor_fw_wait_acks 三层兜底（busy-wait →
+ * wait_event → 终查）——ack 在 doorbell 写的同一同步路径追平即可，无需
+ * IRQ。shared interface 布局取 panthor_fw.h：
+ * glb control{+0 version +8 input_va +c output_va}，
+ * input{+0 req +8 doorbell_req}，output{+0 ack +8 doorbell_ack}；
+ * csg control{0x1000+csg*0xa0：+4 input_va +8 output_va}（input/output 同
+ * glb 布局）。MCU 状态按 glb req 的 GLB_STATE[14:12]（HALT=1）或老式
+ * GLB_HALT bit0 同步。
+ * M2a 语义：CSG 的 START/SUSPEND/TERMINATE/ENDPOINT_CONFIG/STATUS_UPDATE
+ * 全部即时完成（ack=req、doorbell 追平），不消费 queue ring——调度/
+ * fence 量具可用，不得宣称渲染（note 76 §3.5）。 */
+static void rk3588_lite_gpu_doorbell(struct Rk3588LiteGpu *g, unsigned id)
+{
+    hwaddr ctl, in_pa, out_pa;
+    uint32_t in_va, out_va, req;
+    static int dbg = -1;
+
+    if (dbg == -1) {
+        dbg = getenv("GPUDBG") != NULL;
+    }
+    if (dbg) {
+        /* M2f：墙钟 ms——门铃风暴/长消费的 host 侧计时 */
+        fprintf(stderr, "GPUDB id=%u t=%lld\n", id,
+                (long long)(qemu_clock_get_ns(QEMU_CLOCK_REALTIME) / 1000000));
+    }
+
+    ctl = rk3588_lite_gpu_va_pa(g, id == 0 ? 0x04000000
+                                            : 0x04001000 + (id - 1) * 0xa0);
+    if (ctl == HWADDR_MAX) {
+        return;
+    }
+    in_va = address_space_ldl_le(&address_space_memory, ctl + (id ? 4 : 8),
+                                 MEMTXATTRS_UNSPECIFIED, NULL);
+    out_va = address_space_ldl_le(&address_space_memory, ctl + (id ? 8 : 0xc),
+                                  MEMTXATTRS_UNSPECIFIED, NULL);
+    in_pa = rk3588_lite_gpu_va_pa(g, in_va);
+    out_pa = rk3588_lite_gpu_va_pa(g, out_va);
+    if (in_pa == HWADDR_MAX || out_pa == HWADDR_MAX) {
+        return;
+    }
+
+    req = address_space_ldl_le(&address_space_memory, in_pa,
+                               MEMTXATTRS_UNSPECIFIED, NULL);
+    uint32_t glb_req = req;
+
+    address_space_stl_le(&address_space_memory, out_pa, req,
+                         MEMTXATTRS_UNSPECIFIED, NULL);
+    uint32_t doorbell_req = address_space_ldl_le(&address_space_memory,
+                                                 in_pa + 8,
+                                                 MEMTXATTRS_UNSPECIFIED, NULL);
+    address_space_stl_le(&address_space_memory, out_pa + 8, doorbell_req,
+                         MEMTXATTRS_UNSPECIFIED, NULL);
+
+    if (id != 0) {
+        /* M2e：user doorbell（queue 提交通道）——内核 on-slot submit 直接写
+         * CSF_DOORBELL(doorbell_id)（panthor_sched.c group_submit_locked），
+         * 不 toggle csg doorbell_req；真 FW 收到即消费该组 ring。此前忽略
+         * 它 = 组的第二个 job 起永远无人消费（job timeout 楔死根因；第一
+         * 个 job 靠 START 路径 doorbell(0) sweep 碰到）。doorbell_id = csg_id+1
+         * （group_bind_locked），扫该组全部 CS，insert==extract 的幂等追平。 */
+        for (unsigned cs = 0; cs < 8; cs++) {
+            rk3588_lite_gpu_cs_consume(g, ctl, in_pa, out_pa, id - 1, cs);
+        }
+        return;
+    }
+
+    /* CSG update 走 glb 通道（panthor_fw_ring_csg_doorbells：toggle glb
+     * input.doorbell_req 的 CSG 位 + 敲 doorbell(0)——不走 doorbell(1..8)
+     * 寄存器）。doorbell_req 是 toggle 语义（位 1→0 也是事件，实证：
+     * STATUS_UPDATE 位漏 ACK），不能按位值过滤——每次 doorbell(0) 对
+     * 全部 CSG 幂等追平 ack（读当前 req 写 ack，已追平的重写无害）。
+     * START/SUSPEND/TERMINATE/ENDPOINT_CONFIG/STATUS_UPDATE 即时完成，
+     * M2a noop 语义。 */
+    (void)doorbell_req;
+    for (unsigned csg = 0; csg < 8; csg++) {
+        hwaddr c_in, c_out;
+        uint32_t state, live_req;
+
+        ctl = rk3588_lite_gpu_va_pa(g, 0x04001000 + csg * 0xa0);
+        if (ctl == HWADDR_MAX) {
+            continue;
+        }
+        c_in = rk3588_lite_gpu_va_pa(
+            g, address_space_ldl_le(&address_space_memory, ctl + 4,
+                                    MEMTXATTRS_UNSPECIFIED, NULL));
+        c_out = rk3588_lite_gpu_va_pa(
+            g, address_space_ldl_le(&address_space_memory, ctl + 8,
+                                    MEMTXATTRS_UNSPECIFIED, NULL));
+        if (c_in == HWADDR_MAX || c_out == HWADDR_MAX) {
+            continue;
+        }
+        req = address_space_ldl_le(&address_space_memory, c_in,
+                                   MEMTXATTRS_UNSPECIFIED, NULL);
+
+        /* M2f：CSG 存活门——req 状态机（panthor_fw.h 的 CSG_STATE、
+         * ENDPOINT_CONFIG、STATUS_UPDATE 位）只有内核 GROUP_CREATE→START
+         * 之后才会出现；TERMINATE 收组。blob 静态页缺省态可能随机像
+         * "活"，但只影响幂等追平（无害）；ring 消费必须有 START 痕迹，
+         * 否则对垃圾页假消费 + 置错 IRQ 位。SUSPEND(2) 保持原存活判定。 */
+        state = req & 7;
+        live_req = (state == 1 || state == 3) ||
+                   (req & (BIT(4) | BIT(5)));
+        if (state == 0 && !(req & (BIT(4) | BIT(5)))) {
+            g->csg_live &= ~(1u << csg);
+        } else if (live_req) {
+            g->csg_live |= (1u << csg);
+        }
+        /* ACK 追平对死组也必须做（M2a 契约：TERMINATE 等 ack，跳过 =
+         * CSG update timedout，净机实锤）——门只拦 ring 消费。 */
+        address_space_stl_le(&address_space_memory, c_out, req,
+                             MEMTXATTRS_UNSPECIFIED, NULL);
+        if (!(g->csg_live & (1u << csg))) {
+            continue;
+        }
+
+        /* M2b：CSG 级 queue doorbell（csg input.doorbell_req 的 cs 位
+         * toggle，与 output.doorbell_ack 比对）。内核 submit 后
+         * panthor_fw_toggle_reqs + ring_csg_doorbells——同样汇到
+         * doorbell(0)。消费 ring 后发 SYNC_UPDATE + cs_irq + JOB_IRQ。 */
+        uint32_t c_db_req = address_space_ldl_le(&address_space_memory,
+                                                 c_in + 8,
+                                                 MEMTXATTRS_UNSPECIFIED, NULL);
+        uint32_t c_db_ack = address_space_ldl_le(&address_space_memory,
+                                                 c_out + 8,
+                                                 MEMTXATTRS_UNSPECIFIED, NULL);
+        uint32_t pend = c_db_req ^ c_db_ack;
+
+        if (getenv("GPUDBG") && pend) {
+            fprintf(stderr, "GPUDB csg=%u pend=%x ctl=%llx\n",
+                    csg, pend, (unsigned long long)c_in);
+        }
+        if (pend) {
+            address_space_stl_le(&address_space_memory, c_out + 8, c_db_req,
+                                 MEMTXATTRS_UNSPECIFIED, NULL);
+        }
+        for (unsigned cs = 0; cs < 8 && pend; cs++, pend >>= 1) {
+            if (!(pend & 1)) {
+                continue;
+            }
+            rk3588_lite_gpu_cs_consume(g, ctl, c_in, c_out, csg, cs);
+        }
+    }
+
+    if (((glb_req >> 12) & 7) == 1 || (glb_req & BIT(0))) {
+        g->mcu_status = 2;    /* HALT（fw_halt_mcu 的目标态） */
+    } else {
+        g->mcu_status = 1;    /* ACTIVE */
+    }
+}
+
+
+/* M2c：RUN_FRAGMENT 的 clear-only 执行。FBD（Framebuffer Parameters，
+ * v10.xml）：w8=宽高-1、w11[22:19]=RT 数-1；RT[i] @FBD+0x80+i*0x40：
+ * w1 bit0=WriteEnable、[7:3]=WritebackFormat（19=R8G8B8A8）、
+ * RT Buffer w8=Base/w10=RowStride、w12=ClearColor0。RGBA8 路径：clear
+ * word 逐像素铺（行距按 stride）。其余格式/AFBC 计数跳过。 */
+static void rk3588_lite_gpu_run_fragment(struct Rk3588LiteGpu *g,
+                                         uint64_t *regs)
+{
+    hwaddr fp = rk3588_lite_gpu_va_pa_user(g, regs[0x28] & ~7ull);
+
+    g->rf_count++;
+    if (fp == HWADDR_MAX) {
+        g->rf_fbd_fail++;
+        g->rf_fbd_va = regs[0x28];
+        return;
+    }
+    uint32_t w8 = address_space_ldl_le(&address_space_memory, fp + 32,
+                                       MEMTXATTRS_UNSPECIFIED, NULL);
+    unsigned w = (w8 & 0xffff) + 1, h = (w8 >> 16) + 1;
+
+    /* nrt 元数据不含空置槽（实测 RT0 空占位、真 RT 在槽 1）——扫全 8 槽，
+     * 按 WriteEnable+格式过滤。 */
+    for (unsigned i = 0; i < 8; i++) {
+        hwaddr rt = fp + 0x80 + i * 0x40;
+        uint32_t w1 = address_space_ldl_le(&address_space_memory, rt + 4,
+                                           MEMTXATTRS_UNSPECIFIED, NULL);
+        if (!(w1 & 1) || ((w1 >> 3) & 0x1f) != 19) {
+            continue;    /* 非写回或非 RGBA8：M2c 只铺 RGBA8 */
+        }
+        unsigned bf = (w1 >> 8) & 0xf;    /* Block Format（v10.xml） */
+        uint64_t base = address_space_ldq_le(&address_space_memory, rt + 0x20,
+                                             MEMTXATTRS_UNSPECIFIED, NULL);
+        uint32_t stride = address_space_ldl_le(&address_space_memory, rt + 0x28,
+                                               MEMTXATTRS_UNSPECIFIED, NULL);
+        uint32_t clr = address_space_ldl_le(&address_space_memory, rt + 0x30,
+                                            MEMTXATTRS_UNSPECIFIED, NULL);
+        hwaddr bp = rk3588_lite_gpu_va_pa_user(g, base);
+
+        if (getenv("GPUDBG")) {
+            /* M2g：clear 落点取证——净机上曾把 clear word 铺进页表页
+             * （内核 Bad page map，pte 值=像素图案），落点链必须可审计。 */
+            fprintf(stderr,
+                    "GPUFBG as=%u fbd=%llx->%llx w=%ux%u rt%u bf=%u "
+                    "base=%llx->%llx stride=%x clr=%x tt1=%llx\n",
+                    g->cur_as, (unsigned long long)(regs[0x28] & ~7ull),
+                    (unsigned long long)fp, w, h, i, bf,
+                    (unsigned long long)base, (unsigned long long)bp,
+                    stride, clr, (unsigned long long)g->as_transtab[1]);
+        }
+        if (bp == HWADDR_MAX || !stride) {
+            continue;
+        }
+        if (bf == 1) {
+            /* M2g：Tiled U-Interleaved——16×16 RGBA8 tile=1024B，整 tile
+             * 填 clear word。RowStride 是 tile 行距（16×16 实测 0x400=
+             * 1 tile；1024 宽=64 tile=0x10000）。整 tile 才铺（边缘
+             * 半 tile 跳过——诚实边界，partial tile 需 swizzle）。 */
+            unsigned tx = (w + 15) / 16, ty = (h + 15) / 16;
+            for (unsigned y = 0; y < ty; y++) {
+                hwaddr row = bp + (uint64_t)y * stride;
+                for (unsigned x = 0; x < tx; x++) {
+                    hwaddr tile = row + (uint64_t)x * 1024;
+                    for (unsigned o = 0; o < 1024; o += 4) {
+                        address_space_stl_le(&address_space_memory, tile + o,
+                                             clr, MEMTXATTRS_UNSPECIFIED,
+                                             NULL);
+                    }
+                }
+            }
+        } else if (bf == 2) {
+            /* Linear：行距=字段裸字节（v10.xml 无修饰）。 */
+            for (unsigned y = 0; y < h && y < 8192; y++) {
+                hwaddr row = bp + (uint64_t)y * stride;
+                for (unsigned x = 0; x < w && x < 8192; x++) {
+                    address_space_stl_le(&address_space_memory, row + x * 4,
+                                         clr, MEMTXATTRS_UNSPECIFIED, NULL);
+                }
+            }
+        }
+        /* AFBC(12/13)/其余 block format：计数跳过（诚实边界）。 */
+    }
+}
+
+/* M2e 语义开关（GPUM2D=1 回退 M2d 行为：不执行 BRANCH/JUMP/ADD_IMM、
+ * 不做 AS 绑定）——多跑楔死的归属 A/B 对照用，平时不开。 */
+static bool rk3588_lite_gpu_m2d(void)
+{
+    static int on = -1;
+
+    if (on == -1) {
+        on = getenv("GPUM2D") != NULL;
+    }
+    return on;
+}
+
+/* M2c/M2e 单步 CS 解释（wrapper 与用户段共用）：寄存器文件由调用方持有。
+ * 返回 BRANCH 跳转增量（指令数；0=顺序下一条；taken 时 1+offset，
+ * target = 本条位置 + 1 + offset —— cs_builder cs_set_label 语义）。
+ * MOVE 装寄存器；ADD_IMM 补寄存器算术；SYNC_ADD 真执行；CALL 进用户段；
+ * RUN_FRAGMENT 走 FBD 执行（clear-only）；JUMP 由段循环处理；WAIT/FLUSH
+ * 等按顺序执行语义跳过。编码 = mesa genxml v10（BRANCH：offset 16 位有
+ * 符号@0、condition@28、value 寄存器@40；ADD_IMM：imm 有符号@0、src@40、
+ * dst@48）。 */
+static int64_t rk3588_lite_gpu_cs_step(struct Rk3588LiteGpu *g,
+                                       uint64_t *regs, uint64_t instr);
+
+/* M2e 线性段执行（CALL 用户段 / JUMP 换段共用）：BRANCH 按 delta 跳，
+ * JUMP 换段递归（mesa chunk 溢出链：MOVE 装地址/长度寄存器后 JUMP 到
+ * 新缓冲）。budget 是共享指令预算，防分支/JUMP 活锁。 */
+static void rk3588_lite_gpu_cs_run(struct Rk3588LiteGpu *g, uint64_t *regs,
+                                   hwaddr base, uint32_t ninstr,
+                                   uint64_t *budget)
+{
+    int64_t k = 0;
+
+    while (k >= 0 && (uint32_t)k < ninstr && *budget) {
+        uint64_t instr = address_space_ldq_le(&address_space_memory,
+                                              base + k * 8,
+                                              MEMTXATTRS_UNSPECIFIED, NULL);
+        int64_t d;
+
+        (*budget)--;
+        if (!rk3588_lite_gpu_m2d() && (instr >> 56) == 33) {
+            /* JUMP：换段（M2g：Length 同 CALL 是寄存器操作数） */
+            hwaddr jp = rk3588_lite_gpu_va_pa_user(
+                g, regs[(instr >> 40) & 0xff]);
+            uint32_t len = (uint32_t)regs[(instr >> 32) & 0xff];
+
+            g->op_hist[33]++;
+            if (jp != HWADDR_MAX) {
+                rk3588_lite_gpu_cs_run(g, regs, jp, len / 8, budget);
+            }
+            k++;
+            continue;
+        }
+        d = rk3588_lite_gpu_cs_step(g, regs, instr);
+        k += d ? d : 1;
+    }
+}
+
+static int64_t rk3588_lite_gpu_cs_step(struct Rk3588LiteGpu *g,
+                                       uint64_t *regs, uint64_t instr)
+{
+    hwaddr p;
+
+    g->op_hist[instr >> 56]++;
+    switch (instr >> 56) {
+        case 1:    /* MOVE48 */
+            regs[(instr >> 48) & 0xff] = instr & 0xffffffffffffull;
+            break;
+        case 2:    /* MOVE32 */
+            regs[(instr >> 48) & 0xff] = instr & 0xffffffffull;
+            break;
+        case 16:   /* ADD_IMM32：dst = src + imm（32 位回绕） */
+            if (!rk3588_lite_gpu_m2d()) {
+                regs[(instr >> 48) & 0xff] =
+                    (uint32_t)regs[(instr >> 40) & 0xff] + (int32_t)instr;
+            }
+            break;
+        case 17:   /* ADD_IMM64：dst = src + imm（符号扩展） */
+            if (!rk3588_lite_gpu_m2d()) {
+                regs[(instr >> 48) & 0xff] =
+                    regs[(instr >> 40) & 0xff] + (int32_t)instr;
+            }
+            break;
+        case 22: { /* BRANCH：条件对 (u32)regs[value] 与 0 比较 */
+            uint32_t v = (uint32_t)regs[(instr >> 40) & 0xff];
+            bool t = false;
+
+            if (rk3588_lite_gpu_m2d()) {
+                break;    /* M2d：顺序执行语义 */
+            }
+
+            switch ((instr >> 28) & 0xf) {
+            case 0:  t = (int32_t)v <= 0; break;    /* Lequal */
+            case 1:  t = (int32_t)v > 0;  break;    /* Greater */
+            case 2:  t = !v;              break;    /* Equal */
+            case 3:  t = v != 0;          break;    /* Nequal */
+            case 4:  t = (int32_t)v < 0;  break;    /* Less */
+            case 5:  t = (int32_t)v >= 0; break;    /* Gequal */
+            default: t = true;            break;    /* Always */
+            }
+            if (t) {
+                return 1 + (int16_t)(instr & 0xffff);
+            }
+            break;
+        }
+        case 37: { /* SYNC_ADD32 */
+            uint64_t addr = regs[(instr >> 40) & 0xff];
+            uint32_t val = regs[(instr >> 32) & 0xff];
+
+            p = rk3588_lite_gpu_va_pa_user(g, addr);
+            if (p != HWADDR_MAX) {
+                uint32_t v = address_space_ldl_le(&address_space_memory, p,
+                                                  MEMTXATTRS_UNSPECIFIED, NULL);
+                address_space_stl_le(&address_space_memory, p, v + val,
+                                     MEMTXATTRS_UNSPECIFIED, NULL);
+            }
+            break;
+        }
+        case 51: { /* SYNC_ADD64 */
+            uint64_t addr = regs[(instr >> 40) & 0xff];
+            uint64_t val = regs[(instr >> 32) & 0xff];
+
+            p = rk3588_lite_gpu_va_pa_user(g, addr);
+            if (p != HWADDR_MAX) {
+                uint64_t v = address_space_ldq_le(&address_space_memory, p,
+                                                  MEMTXATTRS_UNSPECIFIED, NULL);
+                address_space_stq_le(&address_space_memory, p, v + val,
+                                     MEMTXATTRS_UNSPECIFIED, NULL);
+            }
+            break;
+        }
+        case 7:    /* RUN_FRAGMENT：进入 FBD 执行（M2c） */
+            rk3588_lite_gpu_run_fragment(g, regs);
+            break;
+        case 20:   /* LOAD_MULTIPLE：mutter 的 FBD 载体（从 sync 内存批量
+                    * 恢复寄存器：base reg + offset 处起，mask 位选装） */
+        case 21: { /* STORE_MULTIPLE：反向 */
+            int off = (int16_t)(instr & 0xffff);
+            uint16_t mask = (instr >> 16) & 0xffff;
+            unsigned areg = (instr >> 40) & 0xff, breg = (instr >> 48) & 0xff;
+            hwaddr ap = rk3588_lite_gpu_va_pa_user(g, regs[areg] + off);
+
+            if (ap == HWADDR_MAX || breg >= 192 - 16) {
+                break;
+            }
+            for (unsigned i = 0; i < 16; i++, ap += 8) {
+                if (!(mask & BIT(i))) {
+                    continue;
+                }
+                if ((instr >> 56) == 20) {
+                    regs[breg + i] = address_space_ldq_le(
+                        &address_space_memory, ap, MEMTXATTRS_UNSPECIFIED,
+                        NULL);
+                } else {
+                    address_space_stq_le(&address_space_memory, ap,
+                                         regs[breg + i],
+                                         MEMTXATTRS_UNSPECIFIED, NULL);
+                }
+            }
+            break;
+        }
+        case 32: { /* CALL：进入用户段执行（M2c；寄存器文件共享）
+         * M2g 根修：Address/Length 都是寄存器操作数（内核 wrapper：
+         * MOV48 addr_reg,cs.start + MOV32 val_reg,cs.size + CALL）。
+         * 旧解拿 val_reg 字段本身当字节数（=190=寄存器号，190/8=23 条
+         * 截断）——clear batch ≤23 条侥幸未露馅，draw batch 被砍在
+         * RUN_IDVS 之前。 */
+            uint64_t dst = regs[(instr >> 40) & 0xff];
+            uint32_t len = (uint32_t)regs[(instr >> 32) & 0xff];
+            hwaddr dp = rk3588_lite_gpu_va_pa_user(g, dst);
+            uint64_t budget = 65536;
+
+            if (getenv("GPUSEG")) {
+                fprintf(stderr, "SEG dst=%llx len=%u pa=%llx:",
+                        (unsigned long long)dst, len,
+                        (unsigned long long)dp);
+                for (unsigned k = 0; k < 16 && dp != HWADDR_MAX; k++) {
+                    uint64_t w = address_space_ldq_le(
+                        &address_space_memory, dp + k * 8,
+                        MEMTXATTRS_UNSPECIFIED, NULL);
+                    fprintf(stderr, " %x", (unsigned)(w >> 56));
+                }
+                fprintf(stderr, "\n");
+            }
+            if (dp != HWADDR_MAX) {
+                rk3588_lite_gpu_cs_run(g, regs, dp, len / 8, &budget);
+            }
+            break;
+        }
+        default:
+            /* WAIT/FLUSH/NOP/RUN_*…：顺序执行语义下跳过（M2e 起 BRANCH/
+             * JUMP/ADD_IMM 已实现，不再是盲区） */
+            break;
+    }
+    return 0;
+}
+
+/* M2b wrapper-CS 解释器（note 76 §3.5 的 noop 量具形态）：消费 ring 的
+ * wrapper 段——寄存器文件 192×u64，识别 MOVE48/32、SYNC_ADD32/64（真实
+ * 执行：写 sync 内存）、CALL（跳过用户段）、FLUSH/WAIT/ERROR_BARRIER
+ * （no-op）。完成后 extract=insert、CS ack 追平、CSG SYNC_UPDATE 事件、
+ * cs_irq toggle、JOB_IRQ 拉高。**fake-completion 免责**：fence 会完成、
+ * 调度会推进，但用户段未执行——像素不变，不得宣称渲染。
+ * 指令编码 = mesa genxml v10（opcode@bits[63:56]；MOVE48 imm@[47:0]
+ * dst@[55:48]；SYNC_ADD64/32 addr_reg@[47:40] data_reg@[39:32]）。 */
+static void rk3588_lite_gpu_cs_consume(struct Rk3588LiteGpu *g,
+                                       hwaddr csg_ctl, hwaddr csg_in,
+                                       hwaddr csg_out, unsigned csg,
+                                       unsigned cs)
+{
+    hwaddr cs_pa = csg_ctl + 0x40 + cs * 0xc;    /* CS control 同页（PA） */
+    uint64_t *regs = g->cs_regs;
+    uint32_t cfg, insert, extract, ring_size;
+    uint64_t ring_base;
+    hwaddr ring_pa;
+    unsigned n;
+
+    /* CS control 在 CSG control 区内（csg_ctl+0x40+cs*0xc），拿 CS 的
+     * input_va/output_va（fw VM）。 */
+    uint32_t cs_in_va = address_space_ldl_le(&address_space_memory,
+                                             cs_pa + 4,
+                                             MEMTXATTRS_UNSPECIFIED, NULL);
+    uint32_t cs_out_va = address_space_ldl_le(&address_space_memory,
+                                              cs_pa + 8,
+                                              MEMTXATTRS_UNSPECIFIED, NULL);
+    hwaddr cs_in = rk3588_lite_gpu_va_pa(g, cs_in_va);
+    hwaddr cs_out = rk3588_lite_gpu_va_pa(g, cs_out_va);
+
+    if (cs_in == HWADDR_MAX || cs_out == HWADDR_MAX) {
+        if (getenv("GPUDBG")) {
+            fprintf(stderr, "CONSUME-EARLY cswalk cs=%u\n", cs);
+        }
+        return;
+    }
+    /* M2e：组的 AS 绑定（csg input+0x50 config = panthor_vm_as(group->vm)，
+     * panthor_sched.c csg_slot_prog_locked）——本组所有用户 VA walk 的
+     * 权威 AS。consume 同步无嵌套，入口直接覆盖即可。 */
+    if (!rk3588_lite_gpu_m2d()) {
+        cfg = address_space_ldl_le(&address_space_memory, csg_in + 0x50,
+                                   MEMTXATTRS_UNSPECIFIED, NULL);
+        g->cur_as = (cfg & 0xff) < 8 ? (cfg & 0xff) : 0;
+    }
+    ring_base = address_space_ldq_le(&address_space_memory, cs_in + 0x10,
+                                     MEMTXATTRS_UNSPECIFIED, NULL);
+    ring_size = address_space_ldl_le(&address_space_memory, cs_in + 0x18,
+                                     MEMTXATTRS_UNSPECIFIED, NULL);
+    uint64_t ring_in_ptr = address_space_ldq_le(&address_space_memory,
+                                                cs_in + 0x30,
+                                                MEMTXATTRS_UNSPECIFIED, NULL);
+    uint64_t ring_out_ptr = address_space_ldq_le(&address_space_memory,
+                                                 cs_in + 0x38,
+                                                 MEMTXATTRS_UNSPECIFIED, NULL);
+    hwaddr in_ptr_pa = rk3588_lite_gpu_va_pa(g, ring_in_ptr);
+    hwaddr out_ptr_pa = rk3588_lite_gpu_va_pa(g, ring_out_ptr);
+    if (!ring_size || in_ptr_pa == HWADDR_MAX || out_ptr_pa == HWADDR_MAX) {
+        if (getenv("GPUDBG")) {
+            fprintf(stderr, "CONSUME-EARLY ptrwalk cs=%u\n", cs);
+        }
+        return;
+    }
+    insert = address_space_ldl_le(&address_space_memory, in_ptr_pa,
+                                  MEMTXATTRS_UNSPECIFIED, NULL);
+    extract = address_space_ldl_le(&address_space_memory, out_ptr_pa,
+                                   MEMTXATTRS_UNSPECIFIED, NULL);
+    if (insert == extract) {
+        /* 无新指令：只追平 CS ack（START 等） */
+        uint32_t cs_req = address_space_ldl_le(&address_space_memory, cs_in,
+                                               MEMTXATTRS_UNSPECIFIED, NULL);
+        address_space_stl_le(&address_space_memory, cs_out, cs_req,
+                             MEMTXATTRS_UNSPECIFIED, NULL);
+        if (getenv("GPUDBG")) {
+            fprintf(stderr, "CONSUME-EMPTY cs=%u\n", cs);
+        }
+        return;
+    }
+    if (getenv("GPUDBG")) {
+        static int64_t last_ms;    /* M2f：距上次真消费的墙钟间隔 */
+        int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME) / 1000000;
+
+        fprintf(stderr,
+                "CONSUME csg_ctl=%llx cs=%u ins=%x ext=%x as=%u dt=%lld\n",
+                (unsigned long long)csg_ctl, cs, insert, extract, g->cur_as,
+                (long long)(now - last_ms));
+        last_ms = now;
+    }
+
+    uint64_t budget = 1 << 20;
+    for (n = 0; n < 65536 && extract != insert && budget; n++) {
+        uint32_t off = extract % ring_size;
+
+        ring_pa = rk3588_lite_gpu_va_pa_user(g, ring_base + off);
+        if (ring_pa == HWADDR_MAX) {
+            break;
+        }
+        uint64_t instr = address_space_ldq_le(&address_space_memory, ring_pa,
+                                              MEMTXATTRS_UNSPECIFIED, NULL);
+        budget--;
+        if (!rk3588_lite_gpu_m2d() && (instr >> 56) == 33) {
+            /* JUMP：ring 内罕见，按段外线性执行 */
+            hwaddr jp = rk3588_lite_gpu_va_pa_user(
+                g, regs[(instr >> 40) & 0xff]);
+            uint32_t len = (instr >> 32) & 0xff;
+
+            g->op_hist[33]++;
+            if (jp != HWADDR_MAX) {
+                rk3588_lite_gpu_cs_run(g, regs, jp, len / 8, &budget);
+            }
+            extract += 8;
+            continue;
+        }
+        int64_t d = rk3588_lite_gpu_cs_step(g, regs, instr);
+
+        extract += (d && !rk3588_lite_gpu_m2d()) ? 8 * d : 8;
+        if (d > 0 && extract > insert) {
+            break;    /* 前跳越过 insert：交完成面收尾 */
+        }
+    }
+    /* 消费循环主体见 cs_step */
+
+    /* 完成面：extract 追 insert；CS ack 追平；CSG 发 SYNC_UPDATE 事件
+     * （req bit28，fw 侧置位、内核清）+ cs_irq toggle；JOB_IRQ 拉高。 */
+    address_space_stl_le(&address_space_memory, out_ptr_pa, insert,
+                         MEMTXATTRS_UNSPECIFIED, NULL);
+    uint32_t cs_req = address_space_ldl_le(&address_space_memory, cs_in,
+                                           MEMTXATTRS_UNSPECIFIED, NULL);
+    address_space_stl_le(&address_space_memory, cs_out, cs_req,
+                         MEMTXATTRS_UNSPECIFIED, NULL);
+    uint32_t csg_req = address_space_ldl_le(&address_space_memory, csg_in,
+                                            MEMTXATTRS_UNSPECIFIED, NULL);
+    address_space_stl_le(&address_space_memory, csg_in,
+                         csg_req ^ BIT(28), MEMTXATTRS_UNSPECIFIED, NULL);
+    uint32_t cs_irq = address_space_ldl_le(&address_space_memory, csg_out + 0xc,
+                                           MEMTXATTRS_UNSPECIFIED, NULL);
+    address_space_stl_le(&address_space_memory, csg_out + 0xc,
+                         cs_irq ^ BIT(cs), MEMTXATTRS_UNSPECIFIED, NULL);
+    /* M2f 根修：bit 索引必须用 slot 序号。M2a 版本拿 csg_ctl（物理地址）
+     * 减 VA 基址再移位，0x622d000 算出 0x37553，AArch64 LSL 按 mod 32
+     * 折叠 → 每次消费稳定置 bit19 → 内核 csg_id=19 ≥ slot_count →
+     * sched_process_csg_irq_locked drm_WARN_ON ×67 + 调度锁长持 brownout。 */
+    g->job_rawstat |= 1u << csg;
+    rk3588_lite_gpu_update_irq(g);
+
+    if (getenv("GPUHIST")) {
+        /* M2g：opcode 直方图快照（累计值，差分看 job 间增量） */
+        fprintf(stderr, "HIST csg=%u cs=%u:", csg, cs);
+        for (unsigned op = 0; op < 64; op++) {
+            if (g->op_hist[op]) {
+                fprintf(stderr, " %u:%llu", op,
+                        (unsigned long long)g->op_hist[op]);
+            }
+        }
+        fprintf(stderr, "\n");
+    }
+}
+
+static uint64_t rk3588_lite_gpu_read64(struct Rk3588LiteGpu *g, hwaddr offset)
+{
+    /* 64 位寄存器按两个 32 位访问实现（驱动 gpu_read64 低在 +0 高在 +4） */
+    switch (offset) {
+    case 0x100: return 0x00050005;            /* SHADER_PRESENT（真机） */
+    case 0x110: return 0x1;                    /* TILER_PRESENT */
+    case 0x120: return 0x1;                    /* L2_PRESENT */
+    case 0x140: return g->shader_ready;
+    case 0x150: return g->tiler_ready;
+    case 0x160: return g->l2_ready;
+    case 0x200: case 0x210: case 0x220: return 0;    /* PWRTRANS：无进行中 */
+    case 0x240: return g->shader_ready;              /* PWRACTIVE ≈ ready */
+    case 0x250: return g->tiler_ready;
+    case 0x260: return g->l2_ready;
+    case 0x60:  return 0;                     /* GPU_FEATURES（待采） */
+    default:    return 0;
+    }
+}
+
+static uint64_t rk3588_lite_gpu_read(void *opaque, hwaddr offset, unsigned size)
+{
+    struct Rk3588LiteGpu *g = opaque;
+
+    g->reads++;
+    switch (offset) {
+    case 0x000: return 0xa8670005;            /* GPU_ID（真机） */
+    case 0x004: return 0x07120306;            /* L2_FEATURES（真机） */
+    case 0x008: return 0;                     /* CORE_FEATURES（待采） */
+    case 0x00c: return 0x00000809;            /* TILER_FEATURES（真机） */
+    case 0x010: return 0x00000301;            /* MEM_FEATURES（真机） */
+    case 0x014: return 0x00002830;            /* MMU_FEATURES（真机） */
+    case 0x018: return 0x000000ff;            /* AS_PRESENT（真机） */
+    case 0x01c: return 0x00010500;            /* CSF_ID 1.5.0（真机日志） */
+    case 0x020: return g->int_rawstat;
+    case 0x028: return g->int_mask;
+    case 0x02c: return g->int_rawstat & g->int_mask;
+    case 0x030: return 0;                     /* GPU_CMD 写-only */
+    case 0x034:                               /* STATUS：有 ready 即 active */
+        return (g->l2_ready ? GPU_STATUS_ACTIVE | GPU_STATUS_PWR_ACTIVE : 0);
+    case 0x038: return 0;                     /* FAULT_STATUS */
+    case 0x040: return 0;                     /* FAULT_ADDR */
+    case 0x048: return g->l2_config;
+    case 0x050: return g->pwr_key;
+    case 0x054: return g->pwr_override0;
+    case 0x058: return g->pwr_override1;
+    case 0x088: return (uint32_t)g->ts_offset;
+    case 0x08c: return (uint32_t)(g->ts_offset >> 32);
+    case 0x090:                               /* CYCLE_COUNT：虚拟钟单调 */
+    case 0x094:
+    case 0x098:                               /* TIMESTAMP（offset 后值） */
+    case 0x09c:
+    {
+        uint64_t t = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        t = (offset & 8) ? t + g->ts_offset : t;    /* 0x98 组加 offset */
+        return (offset & 4) ? (uint32_t)(t >> 32) : (uint32_t)t;
+    }
+    case 0x0a0: return 0x400;                 /* MAX_THREADS（保守） */
+    case 0x0a4: return 0x200;                 /* MAX_WORKGROUP_SIZE */
+    case 0x0a8: return 0x100;                 /* MAX_BARRIER_SIZE */
+    case 0x0ac: return 0;                     /* THREAD_FEATURES（待采） */
+    case 0x0b0: case 0x0b4: case 0x0b8: case 0x0bc: return 0;  /* TEXTURE */
+    case 0x280: return 0;                     /* REVID（待采） */
+    case 0x300: return 0;                     /* COHERENCY_FEATURES（待采） */
+    case 0x304: return 0;                     /* COHERENCY_PROTOCOL */
+    case 0x700: return g->mcu_control;
+    case 0x704: return g->mcu_status;
+    case 0x1000: return g->job_rawstat;       /* JOB_INT_RAWSTAT */
+    case 0x1008: return g->job_mask;
+    case 0x100c: return g->job_rawstat & g->job_mask;
+    case 0x2000: return g->mmu_rawstat;       /* MMU_INT_RAWSTAT */
+    case 0x2008: return g->mmu_mask;
+    case 0x200c: return g->mmu_rawstat & g->mmu_mask;
+    default:
+        if (offset >= 0x2400 && offset < 0x2400 + 8 * 0x40 && !(offset & 7)) {
+            unsigned as = (offset - 0x2400) >> 6, sub = (offset - 0x2400) & 0x3f;
+
+            switch (sub) {
+            case 0x00: return (uint32_t)g->as_transtab[as];
+            case 0x04: return (uint32_t)(g->as_transtab[as] >> 32);
+            case 0x08: return (uint32_t)g->as_memattr[as];
+            case 0x0c: return (uint32_t)(g->as_memattr[as] >> 32);
+            case 0x28: return 0;              /* AS_STATUS：恒不 active */
+            case 0x30: return (uint32_t)g->as_transcfg[as];
+            case 0x34: return (uint32_t)(g->as_transcfg[as] >> 32);
+            default: return 0;                /* fault/lockaddr 组 */
+            }
+        }
+        if (!(offset & 3)) {
+            /* 64 位成员区（present/ready/trans/active + 0x60 features）：
+             * 低半在 +0 高半在 +4，按对分发 */
+            if ((offset >= 0x100 && offset <= 0x260) || offset == 0x60) {
+                uint64_t v = rk3588_lite_gpu_read64(g, offset & ~4ull);
+                return (offset & 4) ? (uint32_t)(v >> 32) : (uint32_t)v;
+            }
+        }
+        g->unknown++;
+        return 0;
+    }
+}
+
+static void rk3588_lite_gpu_write(void *opaque, hwaddr offset, uint64_t value,
+                                  unsigned size)
+{
+    struct Rk3588LiteGpu *g = opaque;
+    uint64_t v64 = value;    /* 32 位访问的 64 位成员低半 */
+
+    switch (offset) {
+    case 0x024:                              /* INT_CLEAR：W1C */
+        g->int_rawstat &= ~(uint32_t)value;
+        rk3588_lite_gpu_update_irq(g);
+        return;
+    case 0x028:
+        g->int_mask = value;
+        rk3588_lite_gpu_update_irq(g);
+        return;
+    case 0x030: {                            /* GPU_CMD：同步完成 */
+        unsigned type = value & 0xff;
+        if (type == 1) {                     /* soft/hard reset */
+            g->int_rawstat |= GPU_IRQ_RESET_COMPLETED;
+        } else if (type == 4) {              /* flush caches */
+            g->int_rawstat |= GPU_IRQ_CLEAN_CACHES_COMPLETED;
+        }
+        rk3588_lite_gpu_update_irq(g);
+        return;
+    }
+    case 0x048: g->l2_config = value; return;
+    case 0x050: g->pwr_key = value; return;  /* 0x2968A819 unlock（存而不校） */
+    case 0x054: g->pwr_override0 = value; return;
+    case 0x058: g->pwr_override1 = value; return;
+    case 0x088: g->ts_offset = v64; return;
+    case 0x08c: g->ts_offset = (g->ts_offset & 0xffffffff) | (v64 << 32);
+        return;
+    case 0x180: g->shader_ready |= v64; return;   /* SHADER_PWRON */
+    case 0x184: g->shader_ready |= v64 << 32; return;
+    case 0x190: g->tiler_ready |= v64; return;    /* TILER_PWRON */
+    case 0x194: g->tiler_ready |= v64 << 32; return;
+    case 0x1a0: g->l2_ready |= v64; return;       /* L2_PWRON */
+    case 0x1a4: g->l2_ready |= v64 << 32; return;
+    case 0x1c0: g->shader_ready &= ~v64; return;  /* SHADER_PWROFF */
+    case 0x1c4: g->shader_ready &= ~(v64 << 32); return;
+    case 0x1d0: g->tiler_ready &= ~v64; return;   /* TILER_PWROFF */
+    case 0x1d4: g->tiler_ready &= ~(v64 << 32); return;
+    case 0x1e0: g->l2_ready &= ~v64; return;      /* L2_PWROFF */
+    case 0x1e4: g->l2_ready &= ~(v64 << 32); return;
+    case 0x700:                              /* MCU_CONTROL */
+        g->mcu_control = value;
+        if (value & 2) {                     /* AUTO：假 MCU 上电 */
+            rk3588_lite_gpu_mcu_boot(g);
+        } else if (value == 0) {             /* DISABLE */
+            g->mcu_status = 0;
+        }
+        return;
+    case 0x1004:                              /* JOB_INT_CLEAR：W1C */
+        g->job_rawstat &= ~(uint32_t)value;
+        rk3588_lite_gpu_update_irq(g);
+        return;
+    case 0x1008:
+        g->job_mask = value;
+        rk3588_lite_gpu_update_irq(g);
+        return;
+    case 0x2004:                              /* MMU_INT_CLEAR：W1C */
+        g->mmu_rawstat &= ~(uint32_t)value;
+        rk3588_lite_gpu_update_irq(g);
+        return;
+    case 0x2008:
+        g->mmu_mask = value;
+        rk3588_lite_gpu_update_irq(g);
+        return;
+    default:
+        if (offset >= 0x80000 && offset < 0x100000 && !((offset - 0x80000) & 0xffff)) {
+            rk3588_lite_gpu_doorbell(g, (offset - 0x80000) >> 16);
+            return;
+        }
+        if (offset >= 0x2400 && offset < 0x2400 + 8 * 0x40 && !(offset & 7)) {
+            unsigned as = (offset - 0x2400) >> 6, sub = (offset - 0x2400) & 0x3f;
+
+            switch (sub) {
+            case 0x00: g->as_transtab[as] = (g->as_transtab[as] & ~0xffffffffull)
+                         | (uint32_t)value; return;
+            case 0x04: g->as_transtab[as] = (g->as_transtab[as] & 0xffffffff)
+                         | (v64 << 32); return;
+            case 0x08: g->as_memattr[as] = (g->as_memattr[as] & ~0xffffffffull)
+                         | (uint32_t)value; return;
+            case 0x0c: g->as_memattr[as] = (g->as_memattr[as] & 0xffffffff)
+                         | (v64 << 32); return;
+            case 0x18: { /* AS_COMMAND：瞬时完成。UPDATE 时 transtab 生效——
+                          * 记 MRU 序号；换出的表进影子环（M2e 多 VM 回退） */
+                uint64_t t = g->as_transtab[as];
+
+                if (t != g->as_committed[as]) {
+                    if (g->as_committed[as] && g->as_committed[as] != t) {
+                        g->as_hist[g->as_hist_head] = g->as_committed[as];
+                        g->as_hist_head = (g->as_hist_head + 1) & 15;
+                        g->as_hist_n = MIN(g->as_hist_n + 1, 16u);
+                    }
+                    g->as_committed[as] = t;
+                    g->as_seq[as] = ++g->as_seq_gen;
+                }
+                return;
+            }
+            case 0x30: g->as_transcfg[as] = (g->as_transcfg[as] & ~0xffffffffull)
+                         | (uint32_t)value; return;
+            case 0x34: g->as_transcfg[as] = (g->as_transcfg[as] & 0xffffffff)
+                         | (v64 << 32); return;
+            default: return;
+            }
+        }
+        g->unknown++;
+        return;
+    }
+}
+
+static const MemoryRegionOps rk3588_lite_gpu_ops = {
+    .read = rk3588_lite_gpu_read,
+    .write = rk3588_lite_gpu_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 8,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 8,
+};
+
