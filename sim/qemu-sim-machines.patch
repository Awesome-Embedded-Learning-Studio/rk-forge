+static int rk3588_lite_post_load(void *opaque, int version_id)
+{
+    Rk3588LiteState *s = opaque;
+
+    /* 帧 ticker 不迁移：load 后重挂；清 last_* 强制扫描输出重建 surface */
+    s->vop.last_mst = s->vop.last_dsp = s->vop.last_vir = 0;
+    timer_mod(s->vop.frame_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 16666667);
+    /* 多核迟发锁死（note 81 §1.5）：TCG 下 halted（WFI）vCPU 若快照时正等
+     * 某个未被迁移重建的事件，恢复后永不重估中断——主动 kick 全核逼其
+     * 重新评估 CPU_INTERRUPT_HARD / 定时器到期条件 */
+    CPUState *cpu;
+
+    CPU_FOREACH(cpu) {
+        qemu_cpu_kick(cpu);
+    }
+    /* 刀口实证：cpuif 计数在死核冻结 + vtimer recalc 全核仅 1 次——
+     * load 后强制全核重算通用定时器，重建 vtimer↔GIC PPI 运行时链接 */
+    arm_gt_force_recalc_all_cpus();
+    /* scmi channel 若快照时正忙则重新置 FREE（恢复后首条消息才发得出去） */
+    address_space_stl_le(&address_space_memory,
+                         RK3588_SCMI_SHMEM + RK3588_SCMI_CHAN_STAT,
+                         RK3588_SCMI_CHAN_FREE, MEMTXATTRS_UNSPECIFIED, NULL);
+    return 0;
+}
