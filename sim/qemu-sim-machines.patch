--- /dev/null
+++ b/hw/input/gt911.c
@@ -0,0 +1,343 @@
+/*
+ * Goodix GT911 capacitive touchscreen controller — teaching model.
+ * See include/hw/input/gt911.h for the design rationale.
+ *
+ * The config page reads as all zero, which fails the driver's checksum
+ * test on purpose: goodix_read_config() then falls back to driver
+ * defaults (max 10 contacts), exactly the path a fresh/uncalibrated
+ * chip takes, so no valid config has to be fabricated.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * later. See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/input/gt911.h"
+#include "hw/core/irq.h"
+#include "migration/vmstate.h"
+#include "hw/core/qdev-properties.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "ui/input.h"
+
+/* coordinate report at 0x814e, 8-byte contact format (little-endian x/y):
+ *   [0] status: bit7 buffer-ready, bit3:0 touch count
+ *   [1] track id & 0x0f
+ *   [2..3] x LE16, [4..5] y LE16, [6..7] touch width
+ *   [8] key code footer (0 = no key) */
+static void gt911_fill_report(GT911State *s, uint8_t *buf, int len)
+{
+    memset(buf, 0, len);
+    if (s->report_ready) {
+        buf[0] = s->finger_down ? 0x81 : 0x80;   /* ready + contacts */
+        if (s->finger_down) {
+            buf[1] = 0x00;              /* track 0 */
+            buf[2] = s->touch_x & 0xff;
+            buf[3] = s->touch_x >> 8;
+            buf[4] = s->touch_y & 0xff;
+            buf[5] = s->touch_y >> 8;
+            buf[6] = 0x10;              /* width 16 */
+            buf[7] = 0x00;
+        }
+    }
+    /* !report_ready: 0x00 "not ready" — nothing new to report; the driver
+     * retries briefly and gives up silently, which is correct (and keeps
+     * a held press from being re-read as anything else) */
+}
+
+/* factory config page at GT911_REG_CONFIG_DATA, GOODIX_CONFIG_911_LENGTH
+ * (186) bytes; checksum byte last so the driver's sum==0 check passes */
+#define GT911_CONFIG_LEN 186
+#define GT911_CFG_X_RES_LO   1
+#define GT911_CFG_Y_RES_LO   3
+#define GT911_CFG_MAX_TOUCH  5
+#define GT911_CFG_TRIGGER    6
+#define GT911_CFG_CHECKSUM  (GT911_CONFIG_LEN - 1)
+
+static void gt911_config_factory(GT911State *s)
+{
+    uint8_t cfg[GT911_CONFIG_LEN];
+    int i, sum = 0;
+
+    memset(cfg, 0, sizeof(cfg));
+    cfg[GT911_CFG_X_RES_LO]     = 1024 & 0xff;         /* x res LE */
+    cfg[GT911_CFG_X_RES_LO + 1] = 1024 >> 8;
+    cfg[GT911_CFG_Y_RES_LO]     = 600 & 0xff;          /* y res LE */
+    cfg[GT911_CFG_Y_RES_LO + 1] = 600 >> 8;
+    cfg[GT911_CFG_MAX_TOUCH]    = 5;
+    cfg[GT911_CFG_TRIGGER]      = 0x3f;
+
+    for (i = 0; i < GT911_CFG_CHECKSUM; i++) {
+        sum += cfg[i];
+    }
+    cfg[GT911_CFG_CHECKSUM] = (0x100 - sum) & 0xff;
+
+    memcpy(s->config, cfg, sizeof(cfg));
+}
+
+static uint8_t gt911_read_reg(GT911State *s, uint16_t reg)
+{
+    /* ranges outside our window read 0 */
+    if (reg >= GT911_REG_ID && reg < GT911_REG_ID + sizeof(s->id)) {
+        return s->id[reg - GT911_REG_ID];
+    }
+    if (reg == GT911_REG_COMMAND) {
+        return 0x00;
+    }
+    if (reg >= GT911_REG_CONFIG_DATA &&
+        reg < GT911_REG_CONFIG_DATA + GT911_CONFIG_LEN) {
+        return s->config[reg - GT911_REG_CONFIG_DATA];
+    }
+    if (reg >= GT911_REG_COOR && reg < GT911_REG_END) {
+        uint8_t buf[GT911_REG_END - GT911_REG_COOR];
+        gt911_fill_report(s, buf, sizeof(buf));
+        return buf[reg - GT911_REG_COOR];
+    }
+    return 0x00;
+}
+
+static void gt911_set_int(GT911State *s, int level)
+{
+    /* rk3588 port: the named gpio-out ("gt911-int") is wired by the
+     * machine to the GPIO3/pin16 input — the goodix DT node's irq-gpios.
+     * imx-forge 原版走 object_resolve_path("gpio0") 的硬编码板级路径。 */
+    qemu_set_irq(s->int_line, level);
+}
+
+static void gt911_assert_int(GT911State *s)
+{
+    /* rk3588 实测：goodix 经 gpio3 把 pin16 配成边沿+极性位=1（上升沿触发，
+     * GPIODBG trace 实证），与 imx 板（下降沿）相反——先低再高造上升沿。
+     * imx-forge 原注释：纯电平保持不触发，边沿脉冲才是硬道理。 */
+    gt911_set_int(s, 0);
+    gt911_set_int(s, 1);
+}
+
+static void gt911_write_reg(GT911State *s, uint16_t reg, uint8_t val)
+{
+    if (reg == GT911_REG_COOR) {
+        /* the driver writes 0 here to end the interrupt handshake:
+         * the report is consumed, the finger itself is NOT lifted */
+        s->report_ready = false;
+        return;
+    }
+    if (reg >= GT911_REG_CONFIG_DATA &&
+        reg < GT911_REG_CONFIG_DATA + GT911_CONFIG_LEN) {
+        s->config[reg - GT911_REG_CONFIG_DATA] = val;
+        return;
+    }
+    /* the command register is plain storage: accepted, not verified */
+}
+
+static int gt911_event(I2CSlave *i2c, enum i2c_event event)
+{
+    GT911State *s = GT911(i2c);
+
+    if (event == I2C_START_SEND || event == I2C_START_RECV) {
+        s->addr_bytes = 0;
+    }
+    return 0;
+}
+
+static uint8_t gt911_recv(I2CSlave *i2c)
+{
+    GT911State *s = GT911(i2c);
+    uint8_t val = gt911_read_reg(s, s->addr);
+
+    /* Real silicon deasserts INT once the status byte at 0x814e is READ
+     * (not when the driver writes the clear) — otherwise a level-triggered
+     * GPIO bank irq storms between the guest's read and the trailing write
+     * and buries userspace in synthetic release events. */
+    if (s->addr == GT911_REG_COOR) {
+        gt911_set_int(s, 1);
+    }
+
+    s->addr = (s->addr + 1) & 0xffff;
+    return val;
+}
+
+static int gt911_send(I2CSlave *i2c, uint8_t data)
+{
+    GT911State *s = GT911(i2c);
+
+    switch (s->addr_bytes) {
+    case 0:
+        s->addr_latch = data << 8;
+        s->addr_bytes = 1;
+        break;
+    case 1:
+        s->addr = s->addr_latch | data;
+        s->addr_bytes = 2;
+        break;
+    default:
+        gt911_write_reg(s, s->addr, data);
+        s->addr = (s->addr + 1) & 0xffff;
+        break;
+    }
+    return 0;
+}
+
+/* --- touch injection ------------------------------------------------ */
+
+/*
+ * Drive the INT pad (GPIO1_IO9) high-then-low for a guaranteed falling
+ * edge: the pad idles low until the first touch, so a plain assert would
+ * produce no edge for the edge-triggered irq the goodix driver requests.
+ * The GPIO controller is resolved by partial path (the same resolution
+ * order the gpio_set HMP command uses), side-stepping the named-gpio-out
+ * wiring.
+ */
+void gt911_touch(GT911State *s, uint16_t x, uint16_t y)
+{
+    s->touch_x = x;
+    s->touch_y = y;
+    s->finger_down = true;
+    s->report_ready = true;
+    gt911_assert_int(s);
+}
+
+void gt911_release(GT911State *s)
+{
+    s->finger_down = false;
+    s->report_ready = true;    /* the release itself is a report */
+    gt911_assert_int(s);
+}
+
+/* --- host mouse -> touch bridge -------------------------------------------
+ *
+ * Registering an ABS-capable input handler makes the GTK/SDL frontends
+ * switch to absolute pointer mode (the usb-tablet mechanism): mouse
+ * motion over the LCD window arrives as scaled coordinates, a click
+ * becomes a touch press, and release ends it — all through the real
+ * I2C + IRQ chain. */
+static void gt911_input_event(DeviceState *dev, QemuConsole *src,
+                               QemuInputEvent *evt)
+{
+    GT911State *s = GT911(dev);
+
+    /* 双轨避让（M2b 教训：指针按下与触摸按下同时到场，GNOME 的 grab 被
+     * 两路抢、窗口拖动直接取消）——virtio 键鼠在场时 host-mouse=off */
+    if (!s->mouse_bridge) {
+        return;
+    }
+
+    switch (evt->type) {
+    case INPUT_EVENT_KIND_ABS:
+        if (evt->abs.axis == INPUT_AXIS_X) {
+            /* 0..0x7fff host-normalised -> 0..1024 panel */
+            s->host_x = (uint32_t)evt->abs.value * 1024 / 0x8000;
+        } else {
+            s->host_y = (uint32_t)evt->abs.value * 600 / 0x8000;
+        }
+        /* a drag while the finger is down is a TouchUpdate report.
+         * M2 教训：每份报告 = 线程化中断 + I2C 事务 + 合成重绘，TCG 下拖动
+         * 的逐事件流会饱和 guest（黑屏假死）——按 guest 虚拟时钟 ~33ms 合并，
+         * 坐标永远取最新（真 gt911 上报率也只有 ~100Hz） */
+        if (s->finger_down) {
+            int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+            if (now - s->last_move_ns >= 33 * SCALE_MS) {
+                s->last_move_ns = now;
+                s->report_ready = true;
+                gt911_assert_int(s);
+            }
+        }
+        break;
+    case INPUT_EVENT_KIND_BTN:
+        if (evt->btn.button == INPUT_BUTTON_LEFT) {
+            if (evt->btn.down) {
+                gt911_touch(s, s->host_x, s->host_y);
+            } else {
+                gt911_release(s);
+            }
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static const QemuInputHandler gt911_input_handler = {
+    .name  = "QEMU GT911 TouchScreen",
+    .mask  = INPUT_EVENT_MASK_BTN | INPUT_EVENT_MASK_ABS,
+    .event = gt911_input_event,
+};
+
+static const Property gt911_properties[] = {
+    DEFINE_PROP_BOOL("host-mouse", GT911State, mouse_bridge, true),
+};
+
+static void gt911_reset_hold(Object *obj, ResetType type)
+{
+    GT911State *s = GT911(obj);
+
+    memcpy(s->id, "911\0\x20\0", sizeof(s->id));   /* "911", vid 0x0020 */
+    gt911_config_factory(s);
+    s->addr = 0;
+    s->addr_bytes = 0;
+    s->addr_latch = 0;
+    s->finger_down = false;
+    s->report_ready = false;
+    s->touch_x = 0;
+    s->touch_y = 0;
+    gt911_set_int(s, 1);
+}
+
+static void gt911_init(Object *obj)
+{
