 		if (!polling) {
-			rk3x_i2c_start(i2c);
-
 			time_left = wait_event_timeout(i2c->wait, !i2c->busy,
-						       msecs_to_jiffies(WAIT_TIMEOUT));
+						       msecs_to_jiffies(xfer_time));
 		} else {
-			disable_irq(i2c->irq);
-			rk3x_i2c_start(i2c);
-
