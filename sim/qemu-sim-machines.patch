+        VMSTATE_UINT32(ser, Rk3588LiteSpi),
+        VMSTATE_UINT32(baudr, Rk3588LiteSpi),
+        VMSTATE_UINT32(txftlr, Rk3588LiteSpi),
+        VMSTATE_UINT32(rxftlr, Rk3588LiteSpi),
+        VMSTATE_UINT32(imr, Rk3588LiteSpi),
+        VMSTATE_UINT32(isr, Rk3588LiteSpi),
+        VMSTATE_UINT8_ARRAY(txf, Rk3588LiteSpi, 64),
+        VMSTATE_UINT8_ARRAY(rxf, Rk3588LiteSpi, 64),
+        VMSTATE_INT32(tn, Rk3588LiteSpi),
