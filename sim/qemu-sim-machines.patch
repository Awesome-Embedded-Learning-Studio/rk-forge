+        VMSTATE_UINT32(mrxaddr, Rk3588LiteI2c),
+        VMSTATE_UINT32(mrxraddr, Rk3588LiteI2c),
+        VMSTATE_UINT32(mtxcnt, Rk3588LiteI2c),
+        VMSTATE_UINT32(mrxcnt, Rk3588LiteI2c),
+        VMSTATE_UINT32(ien, Rk3588LiteI2c),
+        VMSTATE_UINT32(ipd, Rk3588LiteI2c),
+        VMSTATE_UINT32(fcnt, Rk3588LiteI2c),
+        VMSTATE_UINT8_ARRAY(txbuf, Rk3588LiteI2c, 0x100),
+        VMSTATE_UINT8_ARRAY(rxbuf, Rk3588LiteI2c, 0x100),
