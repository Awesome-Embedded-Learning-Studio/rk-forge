# =============================================================================
# rk3568_atk_defconfig — Phase 2a full rootfs for rk-forge (ATK-DLRK3568).
#
# Toolchain: external /opt Arm GNU 15.3.Rel1 (gcc 15.3.1, glibc 2.42, kernel
# headers 6.6.44, aarch64). build-rootfs.sh overrides BR2_TOOLCHAIN_EXTERNAL_PATH
# at build time from config/toolchain.conf (single source of truth), so the path
# below is the Kconfig-required placeholder.
#
# This is the Phase 2a upgrade of the board's rootfs defconfig: the Phase-1 MVP
# (busybox + tar shell, commit ebcee5a) promoted in place to the full feature
# set the board env already documents for this name
# (config/boards/rk3568-atk.env: "Qt5/gstreamer/mesa/ffmpeg + librknnrt").
# The MVP is preserved in git history (ebcee5a) if a minimal smoke-test rootfs
# is wanted again.
#
# Every symbol below was verified against third_party/buildroot (BR2_VERSION
# 2026.08-git) Config.in — spelling, infix, case, depends-on/select chains.
# Toolchain/arch deps (C++, wchar, NPTL, locale, gcc>=8, headers>=3.x, MMU,
# !static) are all satisfied by the external glibc toolchain + aarch64.
#
# [B] = deliberate product trade-off documented inline (heavy build / big image).
# [C] = follow-up track, intentionally NOT enabled in 2a (verify on real hw first).
#
# Usage (forge only consumes rootfs.tar; pack-emmc.sh rebuilds ext4 itself):
#   FORGE_BOARD=rk3568-atk scripts/build-rootfs.sh --reconfigure
# (--reconfigure is MANDATORY: .config lingers from the MVP, build-rootfs.sh
#  only regens it when --reconfigure is passed or .config is absent.)
# =============================================================================

# --- ARCH --------------------------------------------------------------------
BR2_aarch64=y
BR2_cortex_a55=y

# --- External toolchain (load-bearing; verbatim from MVP) --------------------
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PATH="/opt/arm-gnu-toolchain-15.3.rel1-x86_64-aarch64-none-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="$(ARCH)-none-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_6=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
# glibc 2.4x dropped Sun RPC from libc (moved to libtirpc); toolchain sysroot has
# no rpc/rpc.h, so buildroot's check rejects INET_RPC. Kconfig default is y for
# glibc → disable explicitly.
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_LOCALE=y
BR2_TOOLCHAIN_EXTERNAL_WCHAR=y
BR2_TOOLCHAIN_EXTERNAL_THREADS=y
BR2_TOOLCHAIN_EXTERNAL_THREADS_POSIX=y
BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_DEBUG=y
# Arm GNU ships g++ + gfortran + OpenMP; buildroot's toolchain check REQUIRES the
# config to acknowledge every language the compiler provides or it errors.
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_INSTALL_LIBSTDCPP=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y

# --- System / locale / time --------------------------------------------------
BR2_ROOTFS_MERGED_USR=y
BR2_TARGET_GENERIC_HOSTNAME="forge-rk3568"
BR2_TARGET_GENERIC_ISSUE="Welcome to forge RK3568"
# TimeZone: LOCALTIME lives inside `if BR2_TARGET_TZ_INFO` (system/Config.in:614)
# — without TZ_INFO the LOCALTIME line is silently dropped. TZ_INFO selects
# tzdata on glibc toolchains.
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Asia/Shanghai"
BR2_GENERATE_LOCALE="en_US zh_CN"
BR2_SYSTEM_ENABLE_NLS=y
BR2_CCACHE=y
# Optional: pin the ccache dir on a drive with room (64 GB host, but ccache for
# llvm/chromium grows fast). Uncomment + edit if ~/.buildroot-ccache is risky.
# BR2_CCACHE_DIR="$(HOME)/.ccache-rk3568"

# --- Device management + init ------------------------------------------------
# Upgrade from MVP DEVTMPFS to eudev: weston/connman/pulseaudio/bluez5 all want
# a real udev. Depends wchar/dynamic/MMU — satisfied.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_INIT_BUSYBOX=y
# Run ldconfig at rootfs gen time to populate /etc/ld.so.cache for mesa3d/gstreamer/
# Qt plugin loading. GLIBC_UTILS (target-side ldconfig) is gated by
# BR2_TOOLCHAIN_BUILDROOT_GLIBC (package/glibc/Config.in:47) and is INVISIBLE to
# this external toolchain, so it is NOT used here. Instead run the HOST ldconfig
# in a post-build hook (it chroots via -r $TARGET_DIR). [B] create the script:
#   board/rk3568-atk/buildroot-external/post-build.sh  (#!/bin/sh; ldconfig -r "$TARGET_DIR")
# Leaving this commented keeps the first build green; uncomment after creating it.
BR2_ROOTFS_POST_BUILD_SCRIPT="board/rk3568-atk/buildroot-external/post-build.sh"
# WiFi: the S99wifi init script (insmods /lib/modules/8852bs.ko) ships via this
# overlay. The .ko itself is staged post-buildroot by scripts/stage-rootfs.sh.
BR2_ROOTFS_OVERLAY="board/rk3568-atk/buildroot-external/overlay"

# --- busybox -----------------------------------------------------------------
BR2_PACKAGE_BUSYBOX=y
# REQUIRED: kmod-tools depends on BUSYBOX_SHOW_OTHERS — dropping this silently
# disables KMOD_TOOLS below.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# Upstream-native busybox config fragment (NOT a Rockchip #include). Path is
# relative to the buildroot top. [B] FILE MUST EXIST or the busybox build step
# errors; create it (even empty) if you want busybox tweaks, else leave commented.
# BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="board/rk3568-atk/buildroot-external/busybox.fragment"

# --- Filesystems + partition tools -------------------------------------------
# NOTE: forge's pack-emmc.sh rebuilds the ext4 rootfs itself (mke2fs -d on the
# staged tree, default ROOTFS_MIB=256); buildroot's own ext4 image is NOT on
# forge's path. Kept enabled because it is cheap (host e2fsprogs) and the §7
# intent. The SIZE below only matters if you invoke buildroot's image target
# directly — "1G" replaces the illegal "auto" (mkfs rejects non-numeric sizes).
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_NTFS_3G_NTFSPROGS=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_USBMOUNT=y
BR2_PACKAGE_INPUT_EVENT_DAEMON=y
BR2_PACKAGE_ANDROID_TOOLS=y

# --- Device / system tools ---------------------------------------------------
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_FILE=y

# --- Network (WiFi/AP/Ethernet) ----------------------------------------------
BR2_PACKAGE_CONNMAN=y
BR2_PACKAGE_CONNMAN_WIFI=y
BR2_PACKAGE_CONNMAN_LOOPBACK=y
BR2_PACKAGE_CONNMAN_CLIENT=y
# Optional: wire connman <-> bluez5 (bluez already enabled). Runtime-only dep,
# no extra selects. Commented = BT managed outside connman for now.
# BR2_PACKAGE_CONNMAN_BLUETOOTH=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_EAP=y
