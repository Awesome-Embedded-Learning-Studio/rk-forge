From 2f8cff07fe918436a2d11b6b4ffe499f712dff97 Mon Sep 17 00:00:00 2001
From: Charliechen114514 <725610365@qq.com>
Date: Sun, 1 Nov 2026 21:15:37 +0800
Subject: [PATCH] drm/panel: topeet-dsi: send the init blob in prepare, read
 the bridge back

The vendor blob configures a Toshiba TC358775-class DSI-to-LVDS bridge:
its register list matches the mainline tc358775.c map (PPI_LANEENABLE
0x0134, DSI_STARTDSI 0x0204, VFUEN 0x0464, LVCFG 0x049c) and includes
PPI_START/DSI_START, i.e. it switches the bridge into video reception
itself. Such initialization must run while the DSI host is in command
mode.

We sent it from panel .enable(), which the DRM bridge order runs after
dw_mipi_dsi2_bridge_atomic_enable() has already switched the host to
video mode; the LP-inserted writes returning success only proves the
host FIFO path, not that the bridge latched its configuration. The
panel has never shown a single pixel while every other stage (GPU,
compositor, CPU dumb-buffer scanout) is proven good.

Move the send to .prepare() and set prepare_prev_first so the host is
pre-enabled (command mode) before panel prepare runs; undo power and
reset on failure. After init, read the bridge IDREG and LVCFG over DSI
generic read as bring-up evidence (0x00007500 / 0x00000431 expected).

Signed-off-by: Charliechen114514 <725610365@qq.com>
---
 drivers/gpu/drm/panel/panel-topeet-dsi.c | 47 ++++++++++++++++++------
 1 file changed, 36 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-topeet-dsi.c b/drivers/gpu/drm/panel/panel-topeet-dsi.c
index b10fee77e..ec624f3dd 100644
--- a/drivers/gpu/drm/panel/panel-topeet-dsi.c
+++ b/drivers/gpu/drm/panel/panel-topeet-dsi.c
@@ -25,6 +25,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
+#include <linux/unaligned.h>
 #include <linux/of.h>
 #include <linux/property.h>
 #include <linux/regulator/consumer.h>
@@ -111,6 +112,7 @@ static int topeet_panel_send_seq(struct mipi_dsi_device *dsi,
 static int topeet_panel_prepare(struct drm_panel *panel)
 {
 	struct topeet_panel *ctx = to_topeet_panel(panel);
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
 	int ret;
 
 	dev_info(ctx->dev, "DBG32 panel prepare enter\n");
@@ -131,17 +133,6 @@ static int topeet_panel_prepare(struct drm_panel *panel)
 		msleep(ctx->prepare_delay ?: 20);
 	}
 
-	dev_info(ctx->dev, "DBG32 panel prepare done\n");
-
-	return 0;
-}
-
-static int topeet_panel_enable(struct drm_panel *panel)
-{
-	struct topeet_panel *ctx = to_topeet_panel(panel);
-	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
-	int ret;
-
 	if (ctx->init_len) {
 		dev_info(ctx->dev, "DBG32 panel init-seq start (%zu bytes)\n",
 			 ctx->init_len);
@@ -149,10 +140,42 @@ static int topeet_panel_enable(struct drm_panel *panel)
 		dev_info(ctx->dev, "DBG32 panel init-seq done ret=%d\n", ret);
 		if (ret) {
 			dev_err(ctx->dev, "init sequence failed: %d\n", ret);
+			if (ctx->reset_gpio)
+				gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+			regulator_disable(ctx->power);
 			return ret;
 		}
 	}
 
+	dev_info(ctx->dev, "DBG34 panel init completed in prepare\n");
+
+	/* DBG34 readback: Toshiba-style DSI register access (LE16 address,
+	 * LE32 data). IDREG 0x0580 should read 0x00007500 on a TC358775;
+	 * LVCFG 0x049c should hold the value the init blob wrote (0x431). */
+	{
+		const u8 id_addr[2] = { 0x80, 0x05 };
+		const u8 lv_addr[2] = { 0x9c, 0x04 };
+		u8 val[4] = {};
+		ssize_t n;
+
+		n = mipi_dsi_generic_read(dsi, id_addr, 2, val, 4);
+		dev_info(ctx->dev, "DBG34 bridge IDREG read=%zd data=%08x (expect 00007500)\n",
+			 n, get_unaligned_le32(val));
+		memset(val, 0, sizeof(val));
+		n = mipi_dsi_generic_read(dsi, lv_addr, 2, val, 4);
+		dev_info(ctx->dev, "DBG34 bridge LVCFG read=%zd data=%08x (expect 00000431)\n",
+			 n, get_unaligned_le32(val));
+	}
+
+	dev_info(ctx->dev, "DBG32 panel prepare done\n");
+
+	return 0;
+}
+
+static int topeet_panel_enable(struct drm_panel *panel)
+{
+	struct topeet_panel *ctx = to_topeet_panel(panel);
+
 	if (ctx->enable_delay)
 		msleep(ctx->enable_delay);
 
@@ -275,6 +298,8 @@ static int topeet_panel_probe(struct mipi_dsi_device *dsi)
 		return PTR_ERR(ctx);
 
 	ctx->dev = dev;
+	/* The DSI host must be powered in command mode before init writes. */
+	ctx->panel.prepare_prev_first = true;
 	mipi_dsi_set_drvdata(dsi, ctx);
 
 	ctx->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
-- 
2.43.0

