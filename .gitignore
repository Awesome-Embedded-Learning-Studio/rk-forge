# --- third_party ---
# linux_mainline/uboot/rkbin are git submodules (tracked as gitlinks, see .gitmodules);
# their working-dir dirties are ignored via `ignore = dirty` there. The vendor-sdk
# reference clone is a LOCAL clone (not a submodule) used only for sdk-diff — fully ignored:
/third_party/vendor-sdk/
verdor-sdk.gz
# mainline exploration trees (linux/uboot/rkbin read during premise verification;
# NOT yet formalized as submodules — see PLAN.md). Local plain clones, fully ignored:
/third_party/explore/

# (imx-forge template moved out of this repo to ~/imx-forge; no longer present to ignore)

# --- editor / tooling ---
/.vscode/
/.idea/
*.swp
*~
.cache/
compile_commands.json

# --- bringup build outputs (reproducible via scripts/pack-*.sh + assemble-update.sh) ---
# The .its are SOURCE (tracked); everything else under fit/ + all of out/ are
# regenerated artifacts. tee.bin is a staged rkbin blob copy (pack-fit.sh re-stages it).
/third_party/bringup/out/
/third_party/bringup/fit/*.itb
/third_party/bringup/fit/*.bin
/third_party/bringup/fit/zImage
/third_party/bringup/fit/*.dtb
/third_party/bringup/fit/initramfs.cpio.gz

# keep placeholder files tracked
!**/.gitkeep

*.bin
*.img