diff --git a/hw/ssi/rk806.c b/hw/ssi/rk806.c
new file mode 100644
index 0000000..309f2dc
--- /dev/null
+++ b/hw/ssi/rk806.c
@@ -0,0 +1,125 @@
+/*
+ * Rockchip RK806 PMIC — SPI command-protocol teaching model.
+ *
+ * 规格 = drivers/mfd/rk8xx-spi.c：每帧 cmd(READ=0/WRITE=BIT7 | CRC_DIS=0 |
+ * len-1) + 2 字节大端地址 + 数据；CS 拉高即帧复位。rk8xx-spi 的 probe 按奇
+ * compatible 硬编码 RK806_ID（0x8060），不读芯片名校验，所以整片寄存器按
+ * 存储应答即可——regulator 框架的存在感来自 mfd cells 的注册，而不是读数。
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * later. See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+
+#include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define TYPE_RK806 "rk806"
+OBJECT_DECLARE_SIMPLE_TYPE(RK806State, RK806)
+
+#define RK806_CMD_WRITE  BIT(7)
+
+struct RK806State {
+    SSIPeripheral parent_obj;
+
+    uint8_t regs[0x100];    /* RK806 寄存器空间（0x5A/0x5B = CHIP_NAME/VER） */
+    int phase;              /* 0=cmd 1=addr_hi 2=addr_lo ≥3=data */
+    uint8_t cmd;
+    uint16_t addr;
+};
+
+static uint32_t rk806_transfer(SSIPeripheral *p, uint32_t val)
+{
+    RK806State *s = RK806(p);
+
+    switch (s->phase) {
+    case 0:
+        s->cmd = val;
+        s->phase = 1;
+        return 0;
+    case 1:
+        s->addr = val << 8;
+        s->phase = 2;
+        return 0;
+    case 2:
+        s->addr |= val;
+        s->phase = 3;
+        return 0;
+    default:
+        if (s->cmd & RK806_CMD_WRITE) {
+            s->regs[s->addr & 0xff] = val;
+        } else {
+            val = s->regs[s->addr & 0xff];
+        }
+        s->addr = (s->addr + 1) & 0xffff;
+        return val & 0xff;
+    }
+}
+
+static int rk806_set_cs(SSIPeripheral *p, bool select)
+{
+    if (!select) {
+        RK806(p)->phase = 0;    /* CS 拉高：协议帧复位 */
+    }
+    return 0;
+}
+
+static void rk806_reset_hold(Object *obj, ResetType type)
+{
+    RK806State *s = RK806(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0x5A] = 0x06;   /* CHIP_NAME/VER 低位应 0x8060 族，值仅示义 */
+    s->regs[0x5B] = 0x80;
+    s->phase = 0;
+    s->cmd = 0;
+    s->addr = 0;
+}
+
+static void rk806_realize(SSIPeripheral *dev, Error **errp)
+{
+}
+
+static const VMStateDescription vmstate_rk806 = {
+    .name = "rk806",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8_ARRAY(regs, RK806State, 0x100),
+        VMSTATE_INT32(phase, RK806State),
+        VMSTATE_UINT8(cmd, RK806State),
+        VMSTATE_UINT16(addr, RK806State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void rk806_class_init(ObjectClass *klass, const void *data)
+{
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    k->realize = rk806_realize;     /* ssi_peripheral_realize 无条件调，必须给 */
+    dc->vmsd = &vmstate_rk806;
+    k->transfer = rk806_transfer;
+    k->set_cs = rk806_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    rc->phases.hold = rk806_reset_hold;
+}
+
+static const TypeInfo rk806_info = {
+    .name          = TYPE_RK806,
+    .parent        = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(RK806State),
+    .class_init    = rk806_class_init,
+};
+
+static void rk806_register_types(void)
+{
+    type_register_static(&rk806_info);
+}
+
+type_init(rk806_register_types)
diff --git a/include/hw/input/gt911.h b/include/hw/input/gt911.h
new file mode 100644
index 0000000..bac99af
--- /dev/null
+++ b/include/hw/input/gt911.h
@@ -0,0 +1,77 @@
+/*
+ * Goodix GT911 capacitive touchscreen controller (I2C).
+ *
+ * Register-level teaching model aligned with the Linux goodix driver
+ * (drivers/input/touchscreen/goodix.c) as configured on the AES board:
+ * the touch IC answers as a GT911 (ID register "911", 8-byte contacts,
+ * 186-byte config page) even though the DT node is named gt9147 — the
+ * driver's chip-data table routes "911" to the gt911_chip_data.
+ *
+ * 16-bit register addressing (MSB first), matching goodix_i2c_read/write.
+ * Touch events are injected from the monitor:
+ *   (qemu) gt911_touch 512 300     # finger down at (512,300)
+ *   (qemu) gt911_release
+ * which fills the coordinate FIFO at 0x814e, raises the INT line
+ * (wired to GPIO1_IO9 by the machine), and the guest kernel's IRQ
+ * handler reads the point out through the real I2C path. Writing
+ * 0x814e (which the driver does after each read) clears the pending
+ * status and releases INT — the true GT911 handshake.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * later. See the COPYING file in the top-level directory.
+ */
+
+#ifndef HW_INPUT_GT911_H
+#define HW_INPUT_GT911_H
+
+#include "hw/i2c/i2c.h"
+#include "ui/input.h"
+#include "qom/object.h"
+
+#define TYPE_GT911 "gt911"
+OBJECT_DECLARE_SIMPLE_TYPE(GT911State, GT911)
+
+/* register map the driver touches */
+#define GT911_REG_COMMAND      0x8040
+#define GT911_REG_CONFIG_DATA  0x8047
+#define GT911_REG_ID           0x8140
+#define GT911_REG_COOR         0x814e
+#define GT911_REG_END          0x8158
+
+struct GT911State {
+    /*< private >*/
+    I2CSlave parent_obj;
+
+    /*< public >*/
+    uint16_t addr;          /* current register address (auto-increment) */
+    uint8_t addr_bytes;     /* 0/1/2: how many address bytes received */
+    uint16_t addr_latch;    /* MSB-first latch */
+
+    uint8_t id[6];          /* 0x8140: "911\0" + vid */
+    uint8_t config[186];    /* 0x8047: factory default, see gt911.c */
+
+    /* two independent states, like the real silicon: finger_down is
+     * the physical press (survives the report handshake), report_ready
+     * is "unread data in the FIFO" (cleared by the 0x814e handshake) */
+    bool finger_down;
+    bool report_ready;
+    uint16_t touch_x;
+    uint16_t touch_y;
+
+    qemu_irq int_line;      /* asserted low while a touch is pending */
+
+    /* host-mouse bridge (GTK/SDL absolute pointer) */
+    uint16_t host_x, host_y;
+    QemuInputHandlerState *input_handler;
+    int64_t last_move_ns;     /* 拖动上报节流（TCG 下逐事件全价报告会噎死 mutter） */
+    bool mouse_bridge;        /* host-mouse=off：virtio 键鼠在场时避让（grab 冲突） */
+};
+
+/* monitor-side injection (hmp gt911_touch / gt911_release) */
+void gt911_touch(GT911State *s, uint16_t x, uint16_t y);
+void gt911_release(GT911State *s);
+
+/* rk3588-lite 机器注册实例的访问器（machine 文件里定义，HMP 寻址用） */
+GT911State *rk3588_lite_gt911(void);
+
+#endif /* HW_INPUT_GT911_H */
