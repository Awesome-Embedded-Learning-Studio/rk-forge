# board/aes/openwrt/aes-nand.config — OpenWrt .config seed for the aes board.
# Copied to <openwrt>/.config then `make defconfig` expands dependencies.
#
# Regenerate after `make menuconfig`:
#   cd <openwrt> && make menuconfig && ./scripts/diffconfig.sh > board/aes/openwrt/aes-nand.config
#
# Phase 1 MVP: minimal — just the aes_nand device + a tar.gz rootfs. The rootfs
# tree is consumed from TARGET_DIR by stage-rootfs.sh; TARGZ is a belt-and-
# suspenders artifact (unused by the rk-forge pack path, which rsyncs TARGET_DIR
# → out/rootfs → pack-ubifs.sh). LuCI / extra packages can be added here once
# the basic boot is board-verified (keep the rootfs < 174 MiB NAND partition).
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_rk3506=y
CONFIG_TARGET_rockchip_rk3506_DEVICE_aes_nand=y
CONFIG_TARGET_ROOTFS_TARGZ=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_EXT4 is not set
CONFIG_KERNEL_DEVTMPFS=y
