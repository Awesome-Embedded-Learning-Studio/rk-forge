# config/boards/aes.env — board constants for the `aes` board (ATK-DLRK3506B).
#
# One of rk-forge's registered boards (config/boards/<board>.env). Selected via
# FORGE_BOARD (env var or `forge.sh --board=aes`); sourced by scripts/lib/env.sh
# AFTER config/forge.env. All board-specific constants live HERE — forge.env keeps
# only project-level paths + the default board.
#
# `aes` = "Awesome Embedded Studio" in-house alias for the ATK board (never 'atk').
# SoC fundamentals are mainline (linux pinctrl+clk since 6.19; u-boot SoC support
# in 2026.07-rc4). rk-forge authors only the board DT + defconfig delta (patches/).

# --- identity ---
BOARD="aes"                 # board id — dts/compatible/model, workspace dir name
SOC="rk3506"
ARCH="arm"                  # → arch/${ARCH}/boot, toolchain ARCH
ABI="armhf"
CPU="cortex-a7"
KERNEL_BASE="v7.1"          # src/linux tag the patches/<board>/linux series applies onto

# --- kernel board DT ---
DT_NAME="rk3506b-aes"       # <DT_NAME>.dtb under arch/${ARCH}/boot/dts/rockchip/
KERN_IMG="zImage"           # arch/${ARCH}/boot/${KERN_IMG}  (arm=zImage, arm64=Image)
KERNEL_BASE_DEFCONFIG="arch/arm/configs/multi_v7_defconfig"  # merge base (arm32=multi_v7_defconfig, arm64=defconfig)
KERNEL_FRAGMENTS="kernel.config kernel-trim.config kernel-compress.config"  # aes: trim+XZ shrink boot.img for the NAND boot partition

# --- u-boot ---
UBOOT_DEFCONFIG="evb-rk3506_defconfig"
UBOOT_DEFCONFIG_SD="evb-rk3506_sd_defconfig"   # SD variant (out-of-tree build)

# --- buildroot ---
BUILDROOT_DEFCONFIG="rk3506_aes_defconfig"     # under board/<board>/buildroot-external/configs/

# --- WiFi (board-specific out-of-tree driver; aes = RTL8733BU, rk3568-atk = none/different) ---
WIFI_DRIVER="rtl8733bu"   # fetch-<driver>-driver.sh materializes it; empty = skip (stage_setup gates on this)

# --- storage ---
STORAGE="nand"              # nand | emmc | sd  (drives pack/assemble path)

# --- workspace (project-relative) ---
BRINGUP_DIR="board/aes"             # build/assembly workspace (fit, manifests, out/)
BOARD_CFG_DIR="board/rk3506-evb"    # kernel config fragments (kernel.config etc.)

# --- SPI-NAND geometry: Winbond W25N04KV on the aes board (only when STORAGE=nand) ---
#   page(min I/O)=2048  PEB=128KiB  LEB=124KiB(PEB-2*min_io)  max LEB=1300(<1328 PEB in 166 MiB rootfs; UBI WL+bad-block pool ~28)
#   NB: also encoded in the DT partition sizes (board/aes/parameter-nand-aes.txt);
#   change BOTH here and there if the NAND chip ever changes.
NAND_MIN_IO=2048
NAND_PEB="128KiB"
NAND_LEB="124KiB"
NAND_MAX_LEB=1300

# --- rkbin blob tuple (resolved by scripts/lib/rkbin.sh rkbin_load) ---
#   aes tuple = {ddr, usbplug, spl, tee} (NO BL31 — RK3506 has no ATF stage).
RKBIN_BLOB_SUBDIR="bin/rk35"
RKBIN_DDR_PAT="rk3506b_ddr_750MHz_v1.*.bin"      # skips the _rt_ variant
RKBIN_USBPLUG_PAT="rk3506_usbplug_v1.*.bin"
RKBIN_SPL_PAT="rk3506_spl_v1.*.bin"
RKBIN_TEE_PAT="rk3506_tee_v*.bin"
RKBIN_TEE_EXCLUDE="_ta_"                         # exclude trust-anchor vars

# --- loader ini (board-specific chip-tag naming; has its own convention) ---
LOADER_INI="RKBOOT-RK3506B-aes.ini"              # under ${BRINGUP}/

# --- pack/assemble manifests (under ${BRINGUP}/) ---
PARAMETER_NAND="parameter-nand-aes-vendorlayout.txt"
PARAMETER_SD="parameter-sd-aes.txt"
PKGFILE_NAND="package-file-nand.txt"      # provision + nand variants
PKGFILE_RESCUE="package-file-aes.txt"
PKGFILE_SD="package-file-sd.txt"

# --- toolchain (board-specific; armhf for aes, aarch64 for rk3568) ---
# Arm GNU Toolchain 15.3.Rel1 (current target; 15.2.Rel1 was board-verified for RK3506
# boot+RW, kept as fallback in config/toolchain.conf). Installed under /opt.
TOOLCHAIN_PREFIX="arm-none-linux-gnueabihf-"
TOOLCHAIN_BIN_DIR="/opt/arm-gnu-toolchain-15.3.rel1-x86_64-arm-none-linux-gnueabihf/bin"
TOOLCHAIN_SYSROOT=""
