diff --git a/include/media/v4l2-m2m-corepool.h b/include/media/v4l2-m2m-corepool.h
new file mode 100644
index 000000000..0fecd23da
--- /dev/null
+++ b/include/media/v4l2-m2m-corepool.h
@@ -0,0 +1,198 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _V4L2_M2M_COREPOOL_H
+#define _V4L2_M2M_COREPOOL_H
+
+#include <linux/atomic.h>
+#include <linux/device.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+
+struct v4l2_m2m_core;
+struct v4l2_m2m_core_attr {
+	struct device_attribute attr;
+	struct v4l2_m2m_core *core;
+	unsigned int stat;
+};
+
+struct v4l2_m2m_core_pool {
+	struct mutex lock;
+	struct list_head cores;
+};
+
+#define DEFINE_V4L2_M2M_CORE_POOL(name) \
+	struct v4l2_m2m_core_pool name = { \
+		.lock = __MUTEX_INITIALIZER(name.lock), \
+		.cores = LIST_HEAD_INIT(name.cores), \
+	}
+
+struct v4l2_m2m_core {
+	struct list_head node;
+	struct device *dev;
+	struct v4l2_m2m_core_pool *pool;
+	struct v4l2_m2m_core *leader;
+	unsigned int users;
+	atomic64_t submitted;
+	atomic64_t completed;
+	atomic64_t errors;
+	struct v4l2_m2m_core_attr attrs[4];
+};
+
+/* 会话在分配 buffer 前选核,整个生命周期保持 DMA/IOMMU 归属不变。 */
+static inline struct v4l2_m2m_core *
+v4l2_m2m_core_acquire(struct v4l2_m2m_core *frontend)
+{
+	struct v4l2_m2m_core_pool *pool = frontend->pool;
+	struct v4l2_m2m_core *core, *best = NULL;
+
+	mutex_lock(&pool->lock);
+	list_for_each_entry(core, &pool->cores, node) {
+		if (core->leader != frontend->leader)
+			continue;
+		if (!best || core->users < best->users)
+			best = core;
+	}
+	if (best) {
+		best->users++;
+		get_device(best->dev);
+		/* 相同负载轮转,短会话也能覆盖所有核心。 */
+		list_move_tail(&best->node, &pool->cores);
+	}
+	mutex_unlock(&pool->lock);
+	return best;
+}
+
+static inline void v4l2_m2m_core_release(struct v4l2_m2m_core *core)
+{
+	mutex_lock(&core->pool->lock);
+	core->users--;
+	mutex_unlock(&core->pool->lock);
+	put_device(core->dev);
+}
+
+static inline ssize_t v4l2_m2m_core_stat_show(struct device *dev,
+					   struct device_attribute *attr,
+					   char *buf)
+{
+	struct v4l2_m2m_core_attr *ca =
+		container_of(attr, struct v4l2_m2m_core_attr, attr);
+	struct v4l2_m2m_core *core = ca->core;
+	u64 value;
+
+	if (!ca->stat) {
+		mutex_lock(&core->pool->lock);
+		value = core->users;
+		mutex_unlock(&core->pool->lock);
+	} else if (ca->stat == 1) {
+		value = atomic64_read(&core->submitted);
+	} else if (ca->stat == 2) {
+		value = atomic64_read(&core->completed);
+	} else {
+		value = atomic64_read(&core->errors);
+	}
+	return sysfs_emit(buf, "%llu\n", value);
+}
+
+/* 首个 available 同类节点保留用户入口,其余节点成为独立执行后端。 */
+static inline int v4l2_m2m_core_init(struct v4l2_m2m_core_pool *pool,
+				   struct v4l2_m2m_core *core,
+				   struct device *dev)
+{
+	struct device_node *node = NULL;
+	struct v4l2_m2m_core *leader;
+	const char *compatible;
+	int ret;
+
+	INIT_LIST_HEAD(&core->node);
+	core->pool = pool;
+	core->dev = dev;
+	core->leader = core;
+	atomic64_set(&core->submitted, 0);
+	atomic64_set(&core->completed, 0);
+	atomic64_set(&core->errors, 0);
+	ret = of_property_read_string(dev->of_node, "compatible", &compatible);
+	if (ret)
+		return ret;
+	while ((node = of_find_compatible_node(node, NULL, compatible))) {
+		if (of_device_is_available(node))
+			break;
+	}
+	if (!node)
+		return -ENODEV;
+	if (node == dev->of_node) {
+		of_node_put(node);
+		return 0;
+	}
+
+	mutex_lock(&pool->lock);
+	list_for_each_entry(leader, &pool->cores, node) {
+		if (leader->dev->of_node == node) {
+			core->leader = leader;
+			get_device(leader->dev);
+			break;
+		}
+	}
+	mutex_unlock(&pool->lock);
+	of_node_put(node);
+	if (core->leader == core)
+		return -EPROBE_DEFER;
+	/* 先解绑后端再移除前端,防止核心池留下失效的 leader。 */
+	if (!device_link_add(dev, core->leader->dev,
+			     DL_FLAG_AUTOREMOVE_CONSUMER))
+		ret = -ENOMEM;
+	else
+		ret = 0;
+	put_device(core->leader->dev);
+	return ret;
+}
+
+static inline bool v4l2_m2m_core_is_leader(struct v4l2_m2m_core *core)
+{
+	return core == core->leader;
+}
+
+static inline void v4l2_m2m_core_remove(struct v4l2_m2m_core *core)
+{
+	unsigned int i;
+
+	mutex_lock(&core->pool->lock);
+	list_del_init(&core->node);
+	mutex_unlock(&core->pool->lock);
+	for (i = 0; i < ARRAY_SIZE(core->attrs); i++)
+		device_remove_file(core->dev, &core->attrs[i].attr);
+}
+
+static inline int v4l2_m2m_core_register(struct v4l2_m2m_core *core)
+{
+	static const char * const names[] = {
+		"m2m_core_users", "m2m_core_submitted",
+		"m2m_core_completed", "m2m_core_errors",
+	};
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		struct v4l2_m2m_core_attr *ca = &core->attrs[i];
+
+		ca->core = core;
+		ca->stat = i;
+		sysfs_attr_init(&ca->attr.attr);
+		ca->attr.attr.name = names[i];
+		ca->attr.attr.mode = 0444;
+		ca->attr.show = v4l2_m2m_core_stat_show;
+		ret = device_create_file(core->dev, &ca->attr);
+		if (ret) {
+			while (i--)
+				device_remove_file(core->dev, &core->attrs[i].attr);
+			return ret;
+		}
+	}
+	mutex_lock(&core->pool->lock);
+	list_add_tail(&core->node, &core->pool->cores);
+	mutex_unlock(&core->pool->lock);
+	dev_info(core->dev, "m2m core online, frontend=%s\n",
+		 dev_name(core->leader->dev));
+	return 0;
+}
+
+#endif
