# SPDX-License-Identifier: MIT
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(DEFINED ENV{RKNN_CROSS_CXX})
    set(CMAKE_CXX_COMPILER "$ENV{RKNN_CROSS_CXX}" CACHE FILEPATH "AArch64 C++ compiler")
elseif(DEFINED ENV{CROSS_COMPILE})
    set(CMAKE_CXX_COMPILER "$ENV{CROSS_COMPILE}g++" CACHE FILEPATH "AArch64 C++ compiler")
else()
    find_program(RKNN_AARCH64_CXX NAMES aarch64-linux-gnu-g++ aarch64-none-linux-gnu-g++)
    if(NOT RKNN_AARCH64_CXX)
        file(GLOB RKNN_TOOLCHAIN_CANDIDATES "/opt/arm-gnu-toolchain-*-aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-g++")
        list(SORT RKNN_TOOLCHAIN_CANDIDATES ORDER DESCENDING)
        if(RKNN_TOOLCHAIN_CANDIDATES)
            list(GET RKNN_TOOLCHAIN_CANDIDATES 0 RKNN_AARCH64_CXX)
        endif()
    endif()
    if(NOT RKNN_AARCH64_CXX)
        message(FATAL_ERROR "Set RKNN_CROSS_CXX or CROSS_COMPILE to an AArch64 toolchain")
    endif()
    set(CMAKE_CXX_COMPILER "${RKNN_AARCH64_CXX}" CACHE FILEPATH "AArch64 C++ compiler")
endif()
