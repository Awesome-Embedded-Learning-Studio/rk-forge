# config/forge.env — project-level paths + the default board.
#
# Board-specific constants (SOC/ARCH/DT_NAME/STORAGE/NAND_*/rkbin patterns/toolchain/
# u-boot defconfigs/...) live in config/boards/<board>.env, sourced by scripts/lib/env.sh
# AFTER this file. Select a board via FORGE_BOARD (env var) or `forge.sh --board=<id>`
# (default: aes). This file is board-agnostic.

# --- active board (default = aes; overridden by the FORGE_BOARD env var or
#     `forge.sh --board=<id>`, both of which set FORGE_BOARD before this is sourced) ---
FORGE_BOARD="${FORGE_BOARD:-aes}"

# --- project paths (relative to repo root; resolved to absolute by lib/env.sh) ---
SRC_DIR="third_party/src"
# Source trees are PER-BOARD (each board has its own patch series applied to its own
# clone at src/<board>/<tree>) — two boards can't share one patched tree. buildroot is
# SHARED (no patches applied; per-board customization is the BR2_EXTERNAL tree under
# board/<board>/buildroot-external/, which buildroot reads without modifying its source).
LINUX_TREE="${SRC_DIR}/${FORGE_BOARD}/linux"
UBOOT_TREE="${SRC_DIR}/${FORGE_BOARD}/uboot"
OPENWRT_TREE="${SRC_DIR}/${FORGE_BOARD}/openwrt"
BUILDROOT_DIR="third_party/buildroot"
ASSETS_DIR="assets"
# OUT_DIR is board-scoped: ${BRINGUP_DIR}/out (resolved in lib/env.sh AFTER the board
# file is sourced, since BRINGUP_DIR comes from the board config).

# --- rkbin blob source (the SPL<->tee hash-pair source — ONE knob; do NOT mix
#     between pack-loader and pack-fit, else SPL/tee hash mismatch). The public
#     submodule is the sole source; board-test confirmed it boots (no fallback). ---
FORGE_RKBIN_DIR_DEFAULT="third_party/rkbin"
