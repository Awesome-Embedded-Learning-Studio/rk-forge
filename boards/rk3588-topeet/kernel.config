# kernel.config — defconfig FRAGMENT for rk3588-topeet (iTOP-RK3588, eMMC).
# Merged onto arch/arm64/configs/defconfig (pulls ARCH_ROCKCHIP + pinctrl/clk + SERIAL_8250
# + MMC_SDHCI + EXT4 + the bulk of RK3588 drivers). This fragment affirms console-boot
# essentials + the RK3588 accelerators that differ from rk3568-atk.
#
# Key differences from rk3568-atk/kernel.config:
#   - GPU: CONFIG_DRM_PANTHOR (Mali-G610) — NOT Panfrost (G31/G52/G76 only). RK3588's G610
#     past Panfrost's range; Panthor is the mainline driver for v9+ Mali.
#   - WiFi: CONFIG_BRCMFMAC (AP6xxx Broadcom/Cypress, mainline) — NOT rtl8852bs OOT drop.
#     Firmware comes from Ubuntu's linux-firmware package, not a staged .ko.
#   - NPU: mainline "Rocket" driver (RK3588-only) — enabled in Phase 6 once the exact
#     v7.1 CONFIG symbol is confirmed (likely under drivers/accel/rocket).
#   - Panel/audio codec left out for MVP (mainline rk3588-evb1-v10.dtb is the MVP DT; the
#     topeet screen/camera/audio nodes land with the Phase 5 board DT patch).
#
# Run `make savedefconfig` after a menuconfig session to regenerate cleanly.

# Console — vendor-compatible Rockchip FIQ debugger owns UART2 and exposes ttyFIQ0.
# Keep the DesignWare 8250 driver for other UARTs, but uart2 itself is disabled in
# the board DT and must never bind to ttyS2.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_FIQ_DEBUGGER=y
CONFIG_FIQ_DEBUGGER_NO_SLEEP=y
CONFIG_FIQ_DEBUGGER_CONSOLE=y
CONFIG_FIQ_DEBUGGER_CONSOLE_DEFAULT_ENABLE=y
CONFIG_FIQ_DEBUGGER_TRUST_ZONE=y
CONFIG_RK_CONSOLE_THREAD=y
CONFIG_ROCKCHIP_FIQ_DEBUGGER=y

# Vendor RK8602/RK8603 CPU/NPU buck driver.  Do not let the generic FAN53555
# driver claim these Rockchip regulators.
# CONFIG_REGULATOR_FAN53555 is not set
CONFIG_REGULATOR_RK860X=y

# RK3588 vendor-compatible CPU DVFS sequencing. This driver creates the
# cpufreq-dt platform only after installing dual cpu/mem supply callbacks,
# intermediate SCMI clock transitions and SRAM read-margin handling.
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_ROCKCHIP_CPUFREQ=y
# CONFIG_CPUFREQ_DT_PLATDEV is not set

# eMMC rootfs
CONFIG_MMC_SDHCI_OF_DW=y
CONFIG_EXT4_FS=y

# basics already in arm64 defconfig; affirmed here
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- Ethernet: GMAC (RK3588 has 2x GMAC; force =y so eth0 is up without modprobe) ----
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_DWMAC_GENERIC=y
CONFIG_REALTEK_PHY=y
CONFIG_MDIO_DEVICE=y

# ---- DRM / GPU: Mali-G610 → Panthor (NOT Panfrost) ----
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_DRM_PANTHOR=y
# GPU firmware: Panthor probes before rootfs mounts, so the .zst in /lib/firmware
# isn't available → embed the raw mali_csffw.bin into the kernel instead.
# (raw blob: boards/rk3588-topeet/firmware/arm/mali/arch10.8/mali_csffw.bin,
#  decompressed from linux-firmware's arch10.10/mali_csffw.bin.zst)
# §5.2.3: only the RELATIVE firmware filename lives here. LinuxBuilder injects
# CONFIG_EXTRA_FIRMWARE_DIR = <board_dir>/firmware (resolved absolute from the
# Board/Project, machine-independent — no /home/ hardcode).
CONFIG_EXTRA_FIRMWARE="arm/mali/arch10.8/mali_csffw.bin"
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_ROCKCHIP=y
# DSI panel pipeline: rk3588 dsi0 is the "rk3588-mipi-dsi2" controller — build the
# DSI2 host (NOT the old ROCKCHIP_DW_MIPI_DSI symbol), the core, and the OOT
# init-sequence panel driver (panel-topeet-dsi).
CONFIG_ROCKCHIP_DW_MIPI_DSI2=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_DCPHY=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL_TOPEET_DSI=y

# ---- Touch: Goodix GT911 on i2c2 ----
CONFIG_TOUCHSCREEN_GOODIX=y

# ---- WiFi/BT: AP6xxx (Broadcom/Cypress) → mainline brcmfmac (firmware from linux-firmware pkg) ----
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y

# ---- RK3588 Rockchip platform drivers (one-shot =y — avoid the =m busybox-no-modprobe trap) ----
CONFIG_PCIE_ROCKCHIP_HOST=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_VIDEO_ROCKCHIP_RGA=y
CONFIG_VIDEO_ROCKCHIP_CIF=y
CONFIG_DEVFREQ_EVENT_ROCKCHIP_DFI=y
CONFIG_PHY_ROCKCHIP_INNO_HDMI=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_PHY_ROCKCHIP_PCIE=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX=y
CONFIG_PHY_ROCKCHIP_USBDP=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y

# ---- Reset framework (for WiFi/BT power-gating via reset_control) ----
CONFIG_RESET_GPIO=y

# ---- Persistent lockup diagnostics ----
# ttyFIQ0 uses a normal IRQ in the vendor-compatible configuration, so it cannot
# enter the debugger once the CPU/GIC stops accepting IRQs.  Detect recoverable
# lockups, panic, then preserve the panic and rolling console in vendor's
# 0x110000..0x1effff ramoops window across the watchdog warm reset.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR_INTR_STORM=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_BUDDY=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_WQ_WATCHDOG=y
CONFIG_BOOTPARAM_WQ_STALL_PANIC=1
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_DW_WATCHDOG=y

# ---- NPU: mainline "Rocket" driver (RK3588-only). TODO Phase 6: confirm exact CONFIG
#      symbol in v7.1 (drivers/accel/rocket — likely CONFIG_DRM_ACCEL_ROCKET) and enable. ----
