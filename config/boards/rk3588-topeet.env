# config/boards/rk3588-topeet.env — board constants for the `rk3588-topeet` board
# (iTOP-RK3588 / 讯饶 topeet RK3588 EVB, eMMC).
#
# RK3588 = Cortex-A76 ×4 + Cortex-A55 ×4 (big.LITTLE), aarch64. Mainline-first
# (linux v7.1 + mainline U-Boot 2026.07-rc4) — SAME base as rk3568-atk. RK3588 mainline
# support is even more mature than RK3568 (Collabora flagship): big.LITTLE, GPU Mali-G610
# (Panthor — NOT Panfrost; G610 is past Panfrost's G31/G52/G76 range), VPU (Hantro +
# rkvdec2, multi-core), RGA, RKCIF/rkisp1 camera, and the NPU is mainline too (the "Rocket"
# driver is RK3588-only — unlike RK3568 which needs the vendor rknpu2 port).
#
# Structurally identical to rk3568-atk on every axis (arm64 + ATF + binman + eMMC + ext4 +
# single boot.img + single kernel fragment + aarch64 toolchain). aes/NAND path does not
# apply. Modeled directly on config/boards/rk3568-atk.env.
#
# Reference pool (NOT a build input): reference/rk3588/ (topeet vendor SDK, kernel 5.10) —
# the board DT (topeet-rk3588-linux.dts) is mined from there and ported to v7.1 as a patch.

# --- identity ---
BOARD="rk3588-topeet"
SOC="rk3588"
ARCH="arm64"
ABI="aarch64"
CPU="cortex-a76"              # big core (big.LITTLE A76+A55; defconfig targets the big core)
KERNEL_BASE="v7.1"            # src/linux tag the patches/rk3588-topeet/linux series applies onto

# --- kernel board DT ---
# Board DT: rk3588-topeet.dts ported from vendor topeet-rk3588-linux.dts (kernel 5.10) to
# mainline v7.1 (PMIC rk806 + rk8602 CPU + console + eMMC + eth + USB host; audio/RTC/panel
# are Phase 2). Currently in-tree under third_party/src/rk3588-topeet/linux/; will be
# formatted as patches/rk3588-topeet/linux/ once board-boot is confirmed.
DT_NAME="rk3588-topeet"
KERN_IMG="Image"              # arch/${ARCH}/boot/${KERN_IMG}  (arm64 = Image)
KERNEL_BASE_DEFCONFIG="arch/arm64/configs/defconfig"  # arm64 base; ARCH_ROCKCHIP + a fragment
KERNEL_FRAGMENTS="kernel.config"  # eMMC boot — one fragment (no NAND trim/XZ like aes)

# --- u-boot ---
# Mainline U-Boot has evb-rk3588_defconfig (RK3588 EVB1); binman builds idbloader.img +
# u-boot.itb (with BL31/ATF from rkbin blobs) — RK3588 packing is mainline-self-contained,
# same shape as rk3568-atk. Board DT (topeet) layered as a u-boot patch in Phase 5 if needed.
UBOOT_DEFCONFIG="evb-rk3588_defconfig"
UBOOT_DEFCONFIG_SD=""       # SD variant TBD (RK3588-topeet is eMMC-primary; SD optional later)
# uboot product shape — "binman" → build-uboot's binman emits FINAL loader+uboot (idbloader.img
# + u-boot.itb with BL31/ATF, from rkbin blobs). pack-fit must NOT re-pack it. RK3588 = ATF
# board → binman (same as rk3568-atk, unlike aes which is nodtb/vendor-SPL).
UBOOT_FIT_SOURCE="binman"

# --- buildroot (UNUSED under --rootfs=ubuntu, field retained for a future buildroot profile) ---
BUILDROOT_DEFCONFIG="rk3588_topeet_defconfig"   # would live under board/rk3588-topeet/buildroot-external/configs/

# --- storage ---
STORAGE="emmc"              # eMMC/GPT (NOT SPI-NAND like aes → no ubiprog; GPT + ext4 rootfs)
ROOTFS_MIB=3072             # ext4 image size: MUST be < 4 GiB — RKAF entry size is 32-bit (struct.pack '<I'), 8 GiB overflows rkfw-pack. 3 GiB fits the ~2.4 GiB staged GNOME rootfs + headroom; the 8 GiB partition leaves grow-room (resize2fs on first boot).

# --- workspace (project-relative) ---
BRINGUP_DIR="board/rk3588-topeet"        # build/assembly workspace (fit, manifests, out/)
BOARD_CFG_DIR="board/rk3588-topeet"      # kernel config fragments (same dir; no separate -evb split)

# --- rkbin blob tuple (public rockchip-linux/rkbin; RK3588 blobs live under bin/rk35/,
# same subdir as RK3568/RK3506 — only the filename prefixes differ) ---
#   rk3588-topeet tuple = {ddr, usbplug, spl, bl31(.elf ATF), bl32/tee(.bin)} — has BL31!
#   DDR is an LP4+LP5 combo blob; glob picks rkbin's default (RK3588MINIALL.ini's choice,
#   lp4_2112/lp5_2400). The `_v1.*` right after `2400MHz_` naturally excludes the `_eyescan_`
#   and the lp4_1848/lp5_2112 variant. If the board's DDR fails training at boot, switch to
#   the 1848/2112 glob (rk3588_ddr_lp4_1848MHz_lp5_2112MHz_v1.*.bin).
RKBIN_BLOB_SUBDIR="bin/rk35"
RKBIN_DDR_PAT="rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v1.*.bin"
RKBIN_USBPLUG_PAT="rk3588_usbplug_v1.*.bin"
RKBIN_SPL_PAT="rk3588_spl_v1.*.bin"             # matches rk3588_spl_v1.14.bin
RKBIN_TEE_PAT="rk3588_bl32_v*.bin"              # BL32 = OP-TEE (the "tee" slot)
RKBIN_TEE_EXCLUDE=""
RKBIN_BL31_PAT="rk3588_bl31_v*.elf"             # BL31 = ARM Trusted Firmware (RK3588 has ATF)
# SPL source: MAINLINE build-uboot SPL (NOT rkbin vendor rk3588_spl). The rkbin
# rk3588_spl_v1.14 is older than BL31 v1.54 (which moved bl31_base to 0x60000) → vendor SPL
# jumps BL31 to the wrong address → BL31 never enters → bootloop. Mainline SPL matches BL31
# v1.54. This is the U-Boot official RK3588 flow (rkbin DDR as TPL + mainline SPL + binman).
SPL_SOURCE="mainline"

# --- loader ini (board-specific). RK3588 loader = RKBOOT (SPL) + the RK3588-specific
# [BOOT1_PARAM] section (8 WORD_x — rk3568's RKBOOT has no such section). BL31 lives INSIDE
# u-boot.itb (binman embeds it), so the download loader is just ddr+usbplug+spl — NO BL31
# segment here (same as rk3568-atk). Modeled on rkbin's RKBOOT/RK3588MINIALL.ini. ---
LOADER_INI="RKBOOT-RK3588-topeet.ini"
# LOADER_TRUST_INI intentionally unset — pack-loader.sh does not consume it (binman already
# embeds BL31 into u-boot.itb). rk3568-atk also leaves this as an unconsumed placeholder.

# --- pack/assemble manifests (under ${BRINGUP}/) ---
PARAMETER_EMMC="parameter-emmc-topeet.txt"       # GPT, rootfs enlarged to 4 GiB for Ubuntu
PKGFILE_EMMC="package-file-emmc.txt"             # RKAF manifest for the eMMC update.img

# --- toolchain (aarch64; shared with rk3568-atk) ---
# Arm GNU Toolchain 15.3.Rel1, /opt (same as rk3568-atk; aes is the armhf one).
TOOLCHAIN_PREFIX="aarch64-none-linux-gnu-"
TOOLCHAIN_BIN_DIR="/opt/arm-gnu-toolchain-15.3.rel1-x86_64-aarch64-none-linux-gnu/bin"
TOOLCHAIN_SYSROOT=""

# --- wifi ---
# iTOP-RK3588 ships with an AP6xxx WiFi/BT module (Broadcom/Cypress, per vendor Android
# wifi_bt.mk BOARD_CONNECTIVITY_MODULE := ap6xxx). This is the MAINLINE brcmfmac driver —
# NOT an out-of-tree Realtek drop — so WIFI_DRIVER is EMPTY (skips forge's OOT fetch/build
# path entirely). The driver is enabled in kernel.config (CONFIG_BRCMFMAC); firmware comes
# from Ubuntu's linux-firmware package in the rootfs. No fetch-<driver>-driver.sh needed.
WIFI_DRIVER=""
