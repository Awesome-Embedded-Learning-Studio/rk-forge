+/* AMBA PrimeCell periphid shadow: pl330 dmacs are identified by the
+ * PeriphID/PCellID regs at 0xfe0-0xfff; blanket zeros make the amba bus
+ * reject them silently ("deferred, reason unknown"). PL330 = 0x000413330. */
+static uint64_t rk3588_lite_amba_read(void *opaque, hwaddr offset,
+                                      unsigned size)
+{
+    switch (offset) {
+    case 0xe00: return 0x001e0070;  /* CR0: 8 ch / 16 events, no periph reqs */
+    case 0xe14: return 0x0ff00003;  /* CRD: 64-bit bus, buf_dep 256 */
+    case 0x3fe0: return 0x30;       /* PID0 */
+    case 0x3fe4: return 0x13;       /* PID1 */
+    case 0x3fe8: return 0x24;       /* PID2 */
+    case 0x3fec: return 0x00;       /* PID3 */
+    case 0x3ff0: return 0x0d;       /* CID0 */
+    case 0x3ff4: return 0xf0;       /* CID1 */
+    case 0x3ff8: return 0x05;       /* CID2 */
+    case 0x3ffc: return 0xb1;       /* CID3 */
+    default: return 0;
+    }
+}
+
+static void rk3588_lite_amba_write(void *opaque, hwaddr offset,
+                                   uint64_t value, unsigned size)
+{
+}
+
+static const MemoryRegionOps rk3588_lite_amba_ops = {
+    .read = rk3588_lite_amba_read,
+    .write = rk3588_lite_amba_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
