diff --git a/drivers/rknpu/rknpu_legacy.c b/drivers/rknpu/rknpu_legacy.c
new file mode 100644
index 000000000..6524aad57
--- /dev/null
+++ b/drivers/rknpu/rknpu_legacy.c
@@ -0,0 +1,243 @@
+// rknpu_legacy.c — legacy /dev/rknpu 表面挂在 DRM GEM 后端上(mainline 移植补记)
+//
+// vendor 内核里 legacy misc 设备只随 DMA_HEAP 内存管理器注册(mainline 无 vendor
+// heap 体系,那半边编不出来);但 librknnrt 1.5.0 的 legacy 路径(open("/dev/rknpu")
+// 成功即锁定,RE 见 .claude/rknn/dyn/run7.log + dsh-006)说的是 'r' magic ioctl,
+// 契约与 DRM 私有 ioctl 同号不同码。此文件把该契约接到 GEM 后端:
+//   ACTION/SUBMIT → 与 DRM 路径共用同一核心(rknpu_action/rknpu_submit)
+//   MEM_CREATE    → rknpu_gem_object_create + prime 导出 dma-buf fd(handle 字段
+//                   装 fd,与 RE 实测一致);obj_addr/dma_addr 语义同 GEM create
+//   MEM_SYNC      → 直接复用 rknpu_gem_sync_ioctl(它本就按 obj_addr 寻址)
+//   MEM_DESTROY   → 会话表按 obj_addr 校验后还引用
+// 所有结构体共用 rknpu_ioctl.h,用户侧无感。
+#include <linux/dma-buf.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/miscdevice.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "rknpu_drv.h"
+#include "rknpu_gem.h"
+#include "rknpu_ioctl.h"
+#include "rknpu_job.h"
+#include "rknpu_legacy.h"
+
+struct rknpu_legacy_obj {
+	struct list_head head;
+	struct rknpu_gem_object *obj;
+};
+
+static int rknpu_legacy_open(struct inode *inode, struct file *file)
+{
+	struct rknpu_device *rknpu_dev =
+		container_of(file->private_data, struct rknpu_device, miscdev);
+	struct rknpu_session *session;
+
+	session = kzalloc(sizeof(*session), GFP_KERNEL);
+	if (!session)
+		return -ENOMEM;
+	session->rknpu_dev = rknpu_dev;
+	INIT_LIST_HEAD(&session->list);
+	file->private_data = session;
+
+	return nonseekable_open(inode, file);
+}
+
+static int rknpu_legacy_release(struct inode *inode, struct file *file)
+{
+	struct rknpu_session *session = file->private_data;
+	struct rknpu_legacy_obj *entry, *tmp;
+
+	list_for_each_entry_safe(entry, tmp, &session->list, head) {
+		list_del(&entry->head);
+		drm_gem_object_put(&entry->obj->base);
+		kfree(entry);
+	}
+	kfree(session);
+	file->private_data = NULL;
+
+	return 0;
+}
+
+static int rknpu_legacy_mem_create(struct rknpu_device *rknpu_dev,
+				   struct rknpu_session *session,
+				   unsigned int cmd, unsigned long data)
+{
+	struct rknpu_mem_create args;
+	struct rknpu_gem_object *obj = NULL;
+	struct rknpu_legacy_obj *entry;
+	struct dma_buf *dmabuf;
+	unsigned int in_size = _IOC_SIZE(cmd);
+	int fd;
+
+	if (copy_from_user(&args, (void __user *)data, in_size))
+		return -EFAULT;
+	if (in_size < sizeof(args))
+		memset((char *)&args + in_size, 0, sizeof(args) - in_size);
+
+	obj = rknpu_gem_object_create(rknpu_dev->drm_dev, args.flags,
+				      args.size, args.sram_size,
+				      args.iommu_domain_id, args.core_mask);
+	if (IS_ERR(obj))
+		return PTR_ERR(obj);
+
+	dmabuf = obj->base.funcs->export(&obj->base, O_RDWR | O_CLOEXEC);
+	if (IS_ERR(dmabuf)) {
+		rknpu_gem_object_destroy(obj);
+		return PTR_ERR(dmabuf);
+	}
+	fd = dma_buf_fd(dmabuf, O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		dma_buf_put(dmabuf);
+		rknpu_gem_object_destroy(obj);
+		return fd;
+	}
+
+	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry) {
+		dma_buf_put(dmabuf);
+		rknpu_gem_object_destroy(obj);
+		return -ENOMEM;
+	}
+	entry->obj = obj;
+	list_add(&entry->head, &session->list);
+
+	args.handle = fd;   /* legacy 契约: handle 字段装 dma-buf fd */
+	args.size = obj->size;
+	args.sram_size = obj->sram_size;
+	args.obj_addr = (__u64)(uintptr_t)obj;
+	args.dma_addr = obj->dma_addr;
+
+	if (copy_to_user((void __user *)data, &args,
+			 min(in_size, sizeof(args)))) {
+		list_del(&entry->head);
+		kfree(entry);
+		/* 已装的 fd 自持引用,进程退出自然回收;这里只还我们的引用 */
+		dma_buf_put(dmabuf);
+		rknpu_gem_object_destroy(obj);
+		return -EFAULT;
+	}
+
+	return 0;
+}
+
+static int rknpu_legacy_mem_destroy(struct rknpu_device *rknpu_dev,
+				    struct rknpu_session *session,
+				    unsigned long data)
+{
+	struct rknpu_mem_destroy args;
+	struct rknpu_legacy_obj *entry;
+
+	if (copy_from_user(&args, (void __user *)data, sizeof(args)))
+		return -EFAULT;
+	if (!args.obj_addr)
+		return -EINVAL;
+
+	list_for_each_entry(entry, &session->list, head) {
+		if ((__u64)(uintptr_t)entry->obj == args.obj_addr) {
+			list_del(&entry->head);
+			drm_gem_object_put(&entry->obj->base);
+			kfree(entry);
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+static long rknpu_legacy_ioctl(struct file *file, unsigned int cmd,
+			       unsigned long data)
+{
+	struct rknpu_session *session = file->private_data;
+	struct rknpu_device *rknpu_dev = session->rknpu_dev;
+	union {
+		struct rknpu_action action;
+		struct rknpu_submit submit;
+		struct rknpu_mem_sync sync;
+	} args;
+	long ret = -EINVAL;
+	unsigned int in_size = _IOC_SIZE(cmd);
+
+	if (!rknpu_dev)
+		return -EINVAL;
+
+	rknpu_power_get(rknpu_dev);
+
+	switch (_IOC_NR(cmd)) {
+	case RKNPU_ACTION:
+		if (copy_from_user(&args.action, (void __user *)data, in_size))
+			{ ret = -EFAULT; break; }
+		if (in_size < sizeof(args.action))
+			memset((char *)&args.action + in_size, 0,
+			       sizeof(args.action) - in_size);
+		ret = rknpu_action(rknpu_dev, &args.action);
+		if (!ret && copy_to_user((void __user *)data, &args.action,
+					 min(in_size, sizeof(args.action))))
+			ret = -EFAULT;
+		break;
+	case RKNPU_SUBMIT:
+		if (copy_from_user(&args.submit, (void __user *)data,
+				   sizeof(args.submit))) {
+			ret = -EFAULT;
+			break;
+		}
+		ret = rknpu_submit(rknpu_dev, &args.submit);
+		if (copy_to_user((void __user *)data, &args.submit,
+				 sizeof(args.submit)))
+			ret = -EFAULT;
+		break;
+	case RKNPU_MEM_CREATE:
+		ret = rknpu_legacy_mem_create(rknpu_dev, session, cmd, data);
+		break;
+	case RKNPU_MEM_MAP:
+		ret = -ENOTTY;   /* legacy blob 路径不使用(见 RE 线取证) */
+		break;
+	case RKNPU_MEM_DESTROY:
+		ret = rknpu_legacy_mem_destroy(rknpu_dev, session, data);
+		break;
+	case RKNPU_MEM_SYNC:
+		if (copy_from_user(&args.sync, (void __user *)data,
+				   sizeof(args.sync))) {
+			ret = -EFAULT;
+			break;
+		}
+		/* GEM 版 sync 本就按 obj_addr 寻址,直接复用 */
+		ret = rknpu_gem_sync_ioctl(rknpu_dev->drm_dev, &args.sync,
+					   NULL);
+		if (!ret &&
+		    copy_to_user((void __user *)data, &args.sync,
+				 sizeof(args.sync)))
+			ret = -EFAULT;
+		break;
+	default:
+		break;
+	}
+
+	rknpu_power_put(rknpu_dev);
+
+	return ret;
+}
+
+static const struct file_operations rknpu_legacy_fops = {
+	.owner = THIS_MODULE,
+	.open = rknpu_legacy_open,
+	.release = rknpu_legacy_release,
+	.unlocked_ioctl = rknpu_legacy_ioctl,
+	.compat_ioctl = rknpu_legacy_ioctl,
+	.llseek = noop_llseek,
+};
+
+int rknpu_legacy_register(struct rknpu_device *rknpu_dev)
+{
+	rknpu_dev->miscdev.minor = MISC_DYNAMIC_MINOR;
+	rknpu_dev->miscdev.name = "rknpu";
+	rknpu_dev->miscdev.fops = &rknpu_legacy_fops;
+
+	return misc_register(&rknpu_dev->miscdev);
+}
+
+void rknpu_legacy_unregister(struct rknpu_device *rknpu_dev)
+{
+	misc_deregister(&rknpu_dev->miscdev);
+}
-- 
