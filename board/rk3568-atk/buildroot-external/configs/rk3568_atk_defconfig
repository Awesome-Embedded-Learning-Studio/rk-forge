BR2_PACKAGE_IPUTILS=y

# --- Bluetooth ---------------------------------------------------------------
# bluez5_utils lives in package/bluez5_utils/ (NOT bluez5). BLUEZ5_UTILS_TOOLS is
# the live symbol; the dead one is BLUEZ_UTILS_TOOLS (no '5') — not used here.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
# bluez-alsa: dir has a hyphen, symbol is BLUEZ_ALSA.
BR2_PACKAGE_BLUEZ_ALSA=y
BR2_PACKAGE_BLUEZ_ALSA_HCITOP=y
BR2_PACKAGE_BLUEZ_ALSA_RFCOMM=y

# --- CAN + eMMC tools --------------------------------------------------------
# can-utils / mmc-utils: dirs are hyphenated, symbols are CAN_UTILS / MMC_UTILS.
BR2_PACKAGE_LIBSOCKETCAN=y
BR2_PACKAGE_CAN_UTILS=y
BR2_PACKAGE_MMC_UTILS=y

# --- GPU / display (Panfrost mainline) ---------------------------------------
# Panfrost (G52) REQUIRES MESA3D_LLVM (package/mesa3d/Config.in:209) — omitting
# it silently disables the panfrost driver. [B] In 2026.08-git PANFROST selects
# NEEDS_PRECOMP_COMPILER which force-pulls OpenCL + clang + spirv-llvm-translator
# + spirv-tools: the build is markedly heavier (full LLVM + clang toolchain)
# and cannot be opted out without patching. The "OpenCL off by default" comment
# from the §7 draft is no longer accurate.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
# libdrm: no LIBDRM_ROCKCHIP exists upstream (dead/vendor-fork symbol, dropped).
# RK3568 is driven through the GENERIC libdrm KMS API. INSTALL_TESTS gives
# modetest/kmstest/proptest — the upstream way to get KMS test tools.
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
# Wayland/Weston. WESTON_DEFAULT_DRM makes drm the launch compositor (the choice
# symbol at weston/Config.in:39 selects WESTON_DRM); without it weston may start
# headless and not light up the panel.
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_UTILS=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DRM=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_WESTON_DEMO_CLIENTS=y

# --- Qt6 (mainline modern stack — NOT Qt5) -----------------------------------
# Switched Qt5→Qt6 on user request. Key consequence: buildroot has NO qt6webengine
# (upstream gap), and Qt5/Qt6 are mutually exclusive (qt6/Config.in:21), so the
# old qt5webengine is GONE with the Qt5 block. This rootfs = Qt6 GUI/Quick/3D/
# multimedia, NO web engine — web is a separate track (see [C] below).
# Qt6 has no BR2_PACKAGE_QT6 umbrella — enable modules directly. QT6_GL_SUPPORTS
# (qt6/Config.in:15-18) = HAS_LIBGL||HAS_LIBGLES, satisfied by mesa3d GLES here.
# OpenGL pinned ES2 (Panfrost-G52 GLES first-class; DESKTOP not selectable
# anyway — mesa3d is EGL+GLES only). qt6declarative auto-selects qt6shadertools.
# Cost: Qt6 builds host-qt6base + host-qt6tools (qmltyperegistrar etc) on top of
# target qt6 — heavier than Qt5, but 64 GB host handles it.
# Upside: dropping qt5webengine removes the chromium build entirely → the
# heaviest single package in this defconfig is now just mesa3d (+LLVM via Panfrost).
BR2_PACKAGE_QT6BASE=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_OPENGL_ES2=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_JPEG=y
BR2_PACKAGE_QT6BASE_PNG=y
BR2_PACKAGE_QT6BASE_GIF=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y
BR2_PACKAGE_QT6BASE_SQL=y
BR2_PACKAGE_QT6BASE_SQLITE=y
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_CONCURRENT=y
BR2_PACKAGE_QT6BASE_DBUS=y
BR2_PACKAGE_QT6DECLARATIVE=y        # Qt Quick/QML (selects qt6shadertools + host-qt6base)
BR2_PACKAGE_QT6SHADERTOOLS=y        # explicit (declarative hard-dep; shader pipeline)
BR2_PACKAGE_QT6WAYLAND=y            # Wayland platform plugin
BR2_PACKAGE_QT6SVG=y
BR2_PACKAGE_QT6QUICK3D=y            # Qt6 has this (Qt5 in-tree lacked qt5quick3d)
BR2_PACKAGE_QT6MULTIMEDIA=y
BR2_PACKAGE_QT6VIRTUALKEYBOARD=y
# [C] Web: no qt6webengine in buildroot (upstream gap). Options if web is needed:
#   - port qt6webengine: see notes/39 (first hurdle = host-python3 3.14 vs chromium)
#   - wpewebkit 2.50.5 + cog 0.18.5 (in-tree, zero recipe, kiosk-class)

