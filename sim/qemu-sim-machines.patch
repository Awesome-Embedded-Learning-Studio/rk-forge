new file mode 100644
index 0000000..5686ada
--- /dev/null
+++ b/hw/arm/rk3588-lite.c
@@ -0,0 +1,1641 @@
+/*
+ * Rockchip RK3588-lite: heterogeneous minimal machine (4x Cortex-A55 +
+ * 4x Cortex-A76), DRAM at 0 (CFG_SYS_SDRAM_BASE=0), mainline Linux bring-up.
+ * The guest DTB must describe no more than what is modeled here.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include <stddef.h>
+#include "qemu/timer.h"
+#include <elf.h>
+#include "hw/arm/boot.h"
+#include "hw/arm/bsa.h"
+#include "hw/arm/machines-qom.h"
+#include "hw/core/boards.h"
+#include "hw/core/irq.h"
+#include "hw/core/loader.h"
+#include "hw/char/serial-mm.h"
+#include "hw/i2c/i2c.h"
+#include "hw/ssi/ssi.h"
+#include "hw/input/gt911.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/intc/arm_gicv3.h"
+#include "hw/core/sysbus.h"
+#include "hw/misc/unimp.h"
+#include "system/address-spaces.h"
+#include "system/physmem.h"
+#include "ui/console.h"
+#include "ui/surface.h"
+#include "system/kvm.h"
+#include "system/qtest.h"
+#include "system/system.h"
+#include "target/arm/cpu.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qemu/datadir.h"
