# config/forge.env — single source of truth for rk-forge build/pack paths and
# board constants. Sourced by scripts/lib/env.sh, which every build/pack script
# sources (replacing the per-script _PROJECT_ROOT + hardcoded-path duplication
# that was mindlessly carried over from imx-forge).
#
# Values are project-RELATIVE; lib/env.sh resolves them to absolute exports with
# the names scripts already use (BRINGUP, OUT_DIR, LINUX_DIR, ...).
# Per-invocation overrides still win: scripts keep --out / --tree / --linux flags,
# and FORGE_RKBIN_DIR may be overridden via the environment.

# --- board ---
BOARD="aes"                 # board id (dts/compatible/model) — never 'atk'
SOC="rk3506"
KERNEL_BASE="v7.1"          # explore/linux tag the patch series applies onto

# --- project paths (relative to repo root) ---
BRINGUP_DIR="third_party/bringup"        # build/assembly workspace (fit sources, manifests, out/)
SRC_DIR="third_party/explore"            # local source clones (linux/uboot/rkbin). P3: → third_party/src
LINUX_TREE="${SRC_DIR}/linux"
UBOOT_TREE="${SRC_DIR}/uboot"
BUILDROOT_DIR="third_party/buildroot"
BOARD_CFG_DIR="boards/rk3506-evb"
ASSETS_DIR="assets"
OUT_DIR="${BRINGUP_DIR}/out"             # packaging artifacts (gitignored)

# --- SPI-NAND geometry: Winbond W25N04KV on the aes board ---
#   page(min I/O)=2048  PEB=128KiB  LEB=124KiB(PEB-2*min_io)  max LEB=1400(<1425 PEB)
#   NB: also encoded in the DT partition sizes (bringup/parameter-nand-aes.txt);
#   change BOTH here and there if the NAND chip ever changes.
NAND_MIN_IO=2048
NAND_PEB="128KiB"
NAND_LEB="124KiB"
NAND_MAX_LEB=1400

# --- rkbin blob source (the SPL<->tee hash-pair source — ONE knob; do NOT mix
#     between pack-loader and pack-fit, else SPL/tee hash mismatch). Default: the
#     public submodule (SPL v1.12 + tee v2.40, internally consistent). Override
#     via env FORGE_RKBIN_DIR=third_party/rkbin-atk for the ATK fallback. P2.3
#     turns this into a shared resolver lib. ---
FORGE_RKBIN_DIR_DEFAULT="third_party/rkbin"
