diff --git a/arch/arm64/boot/dts/rockchip/rk3588-topeet.dts b/arch/arm64/boot/dts/rockchip/rk3588-topeet.dts
index ff8adcc7c..ed4d96db5 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-topeet.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-topeet.dts
@@ -1009,3 +1009,53 @@ reboot_mode: reboot-mode {
 		};
 	};
 };
+
+/*
+ * rknpu: vendor RKNPU driver node (0.9.x port, patches/linux/0036) for the
+ * /dev/rknpu legacy ioctl ABI that librknnrt (and our byte-exact replay
+ * engine, .claude/rknn) speaks. Ported from the vendor topeet-rk3588-linux
+ * dtsi &rknpu block; clocks/resets/power-domains resolved to mainline
+ * rk3588-base.dtsi symbols (SCMI_CLK_NPU, ACLK/HCLK_NPU0-2, SRST_[AH]_RKNN0-2,
+ * PD_NPUTOP/1/2, rknn_mmu_0). The mainline rocket nodes (rknn_core_0-2,
+ * compatible rockchip,rk3588-rknn-core) stay disabled — different driver,
+ * different uAPI; node name differs so dtc does not merge them.
+ * No npu_opp_table: the port stubs out the vendor rockchip_opp DVFS line,
+ * the core runs at the assigned 200 MHz (byte-exact work is freq-independent).
+ */
+/ {
+	rknpu: rknpu@fdab0000 {
+		compatible = "rockchip,rk3588-rknpu";
+		reg = <0x0 0xfdab0000 0x0 0x10000>,
+		      <0x0 0xfdac0000 0x0 0x10000>,
+		      <0x0 0xfdad0000 0x0 0x10000>;
+		interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH 0>,
+			     <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH 0>;
+		interrupt-names = "npu0_irq", "npu1_irq", "npu2_irq";
+		clocks = <&scmi_clk SCMI_CLK_NPU>, <&cru ACLK_NPU0>,
+			 <&cru ACLK_NPU1>, <&cru ACLK_NPU2>,
+			 <&cru HCLK_NPU0>, <&cru HCLK_NPU1>, <&cru HCLK_NPU2>,
+			 <&cru PCLK_NPU_ROOT>;
+		clock-names = "clk_npu", "aclk0", "aclk1", "aclk2",
+			      "hclk0", "hclk1", "hclk2", "pclk";
+		assigned-clocks = <&scmi_clk SCMI_CLK_NPU>;
+		assigned-clock-rates = <200000000>;
+		resets = <&cru SRST_A_RKNN0>, <&cru SRST_A_RKNN1>,
+			 <&cru SRST_A_RKNN2>, <&cru SRST_H_RKNN0>,
+			 <&cru SRST_H_RKNN1>, <&cru SRST_H_RKNN2>;
+		reset-names = "srst_a0", "srst_a1", "srst_a2",
+			      "srst_h0", "srst_h1", "srst_h2";
+		power-domains = <&power RK3588_PD_NPUTOP>,
+				<&power RK3588_PD_NPU1>,
+				<&power RK3588_PD_NPU2>;
+		power-domain-names = "npu0", "npu1", "npu2";
+		rknpu-supply = <&vdd_npu_s0>;
+		mem-supply = <&vdd_npu_mem_s0>;
+		iommus = <&rknn_mmu_0>;
+		status = "okay";
+	};
+};
+
+&rknn_mmu_0 {
+	status = "okay";
+};
